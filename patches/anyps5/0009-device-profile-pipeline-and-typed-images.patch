+// Only query support may enable native null descriptors. Other robustness2
+// features are deliberately left disabled, preserving their separate contracts.
+inline VkPhysicalDeviceRobustness2FeaturesEXT NativeNullDescriptorFeatures(bool extensionPresent, VkBool32 available) {
+    VkPhysicalDeviceRobustness2FeaturesEXT enabled{VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_ROBUSTNESS_2_FEATURES_EXT};
+    enabled.nullDescriptor = extensionPresent && available == VK_TRUE ? VK_TRUE : VK_FALSE;
+    return enabled;
+}
+
+inline bool StorageBufferUpdateAfterBindSupported(VkBool32 available, VkBool32 robustBufferAccess, const VkPhysicalDeviceDescriptorIndexingPropertiesEXT& properties) {
+    return available == VK_TRUE && (robustBufferAccess == VK_FALSE || properties.robustBufferAccessUpdateAfterBind == VK_TRUE);
+}
