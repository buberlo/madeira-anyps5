+#include "SpirvBackend/SpirvAnalysis.hpp"
+#include "SpirvBackend/SpirvFlowEmitter.hpp"
+#include "SpirvBackend/SpirvMemory/SpirvConstants.hpp"
+#include <array>
+#include <cstdio>
+#include <stdexcept>
+
+using namespace ShaderRecompiler;
+
+namespace {
+void Require(bool value, const char* message) {
+    if (!value) throw std::runtime_error(message);
+}
+
+IrValue& Constant(IrProgram& program, std::uint32_t value) {
+    auto& result = program.CreateValue(IrOpcode::Void, IrType::U32);
+    result.SetImmediateU32(value);
+    return result;
+}
+
+IrValue& Compare(IrProgram& program, IrValue& source) {
+    auto& predicate = program.CreateValue(IrOpcode::INotEqual32, IrType::Bool);
+    predicate.AddArgument(&source);
+    predicate.AddArgument(&Constant(program, 0));
+    return predicate;
+}
+
+// Check the actual control-flow emitter as well as the device capability request.
+// Both use the predicate with its zero/nonzero sense already applied by the IR.
+void CheckBranch(IrProgram& program, IrValue& predicate, bool uniform,
+                 BranchCondition kind, bool value) {
+    auto& entry = program.CreateBlock();
+    auto& yes = program.CreateBlock();
+    auto& no = program.CreateBlock();
+    program.SetEntryBlock(entry);
+    program.BlockOrder() = {&entry, &yes, &no};
+    program.Resources().stage = IrShaderStage::Vertex;
+    program.Metadata().blockInfo.resize(3);
+    for (unsigned i = 0; i < 3; ++i) program.Metadata().blockInfo[i].id = i;
+    auto& info = program.Metadata().blockInfo[0];
+    info.terminator.kind = TerminatorKind::ConditionalBranch;
+    info.terminator.condition = kind;
+    info.terminator.trueBlock = 1;
+    info.terminator.falseBlock = 2;
+    info.condition = &predicate;
+
+    SpirvEmitterState state(program, {});
+    Require(state.requirements.subgroupBallot == !uniform,
+            "branch capability request disagrees with predicate uniformity");
+    SpirvValueEmitContext context(state);
+    const auto predicateId = ConstantBool(state, value);
+    context.definitions[&predicate] = predicateId;
+    for (auto* block : program.BlockOrder()) state.labels[block] = state.module.AllocateId();
+    StructuredFunctionState function;
+    EmitControlFlow(context, function, program);
+    const auto code = state.module.Finalize();
+    unsigned ballots = 0, branches = 0;
+    for (std::size_t offset = 5; offset < code.size();) {
+        const auto count = code[offset] >> 16;
+        Require(count != 0 && count <= code.size() - offset, "invalid SPIR-V instruction");
+        const auto op = static_cast<spv::Op>(code[offset] & 0xffff);
+        if (op == spv::OpGroupNonUniformBallot) ++ballots;
+        if (op == spv::OpBranchConditional) {
+            ++branches;
+            if (uniform) Require(code[offset + 1] == predicateId,
+                                 "uniform branch changed the predicate sense");
+        }
+        offset += count;
+    }
+    Require(branches == 1, "expected one conditional branch");
+    Require(ballots == (uniform ? 0u : 1u), "varying branch vote lost or uniform vote retained");
+}
+
+void CheckRejections() {
+    IrProgram p;
+    auto& lane = p.CreateValue(IrOpcode::LaneId, IrType::U32);
+    Require(!IsUniformWaveBranchPredicate(&Compare(p, lane)), "lane-dependent branch accepted");
+    auto& attribute = p.CreateValue(IrOpcode::GetAttribute, IrType::U32);
+    Require(!IsUniformWaveBranchPredicate(&Compare(p, attribute)), "vertex-dependent branch accepted");
+    auto& address = p.CreateValue(IrOpcode::ReadConstBuffer, IrType::U32);
+    address.AddArgument(&Constant(p, 0));
+    address.AddArgument(&lane);
+    Require(!IsUniformWaveBranchPredicate(&Compare(p, address)), "varying constant-buffer address accepted");
+    auto& a = p.CreateBlock();
+    auto& b = p.CreateBlock();
+    auto& phi = p.CreateValue(IrOpcode::Phi, IrType::U32);
+    phi.AddPhiOperand(&a, &Constant(p, 0));
+    phi.AddPhiOperand(&b, &Constant(p, 1));
+    Require(!IsUniformWaveBranchPredicate(&Compare(p, phi)), "divergent phi accepted");
+    auto& cycle = p.CreateValue(IrOpcode::LogicalNot, IrType::Bool);
+    cycle.AddArgument(&cycle);
+    Require(!IsUniformWaveBranchPredicate(&cycle), "cyclic expression accepted");
+    auto& empty = p.CreateValue(IrOpcode::ReadConstBuffer, IrType::U32);
+    Require(!IsUniformWaveBranchPredicate(&empty), "missing resource operands accepted");
+    IrValue* deep = &Constant(p, 0);
+    for (unsigned i = 0; i < 70; ++i) {
+        auto& node = p.CreateValue(IrOpcode::BitwiseOr32, IrType::U32);
+        node.AddArgument(deep);
+        node.AddArgument(&Constant(p, 0));
+        deep = &node;
+    }
+    Require(!IsUniformWaveBranchPredicate(deep), "unbounded expression accepted");
+}
+
+IrValue& DrawPredicate(IrProgram& p) {
+    // Same scalar-resource expression shape as the captured vertex branch.
+    auto& descriptor = p.CreateValue(IrOpcode::GetBufferResource, IrType::U32);
+    for (unsigned i = 0; i < 4; ++i) {
+        auto& user = p.CreateValue(IrOpcode::GetUserData, IrType::U32);
+        user.AddArgument(&Constant(p, i));
+        descriptor.AddArgument(&user);
+    }
+    auto& read = p.CreateValue(IrOpcode::ReadConstBuffer, IrType::U32);
+    read.AddArgument(&descriptor);
+    read.AddArgument(&Constant(p, 0));
+    auto& bits = p.CreateValue(IrOpcode::BitCastF32U32, IrType::F32);
+    bits.AddArgument(&read);
+    auto& zero = p.CreateValue(IrOpcode::Void, IrType::F32);
+    zero.SetImmediateF32(0.0f);
+    auto& predicate = p.CreateValue(IrOpcode::FPUnordNotEqual32, IrType::Bool);
+    predicate.AddArgument(&zero);
+    predicate.AddArgument(&bits);
+    return predicate;
+}
+}
+
+int main() {
+    try {
+        CheckRejections();
+        unsigned checks = 0;
+        for (const auto kind : {BranchCondition::ExecZero, BranchCondition::ExecNonZero,
+                                BranchCondition::VccZero, BranchCondition::VccNonZero}) {
+            for (const bool value : {false, true}) {
+                IrProgram uniform;
+                auto& draw = DrawPredicate(uniform);
+                Require(IsUniformWaveBranchPredicate(&draw), "draw-wide scalar branch rejected");
+                CheckBranch(uniform, draw, true, kind, value);
+                IrProgram varying;
+                auto& vertex = varying.CreateValue(IrOpcode::GetAttribute, IrType::U32);
+                CheckBranch(varying, Compare(varying, vertex), false, kind, value);
+                checks += 2;
+            }
+        }
+        std::printf("[uniform-wave-branch] %u emitter/capability cases passed; varying, phi, cycle and depth guards passed\n", checks);
+        return 0;
+    } catch (const std::exception& e) {
+        std::fprintf(stderr, "[uniform-wave-branch] %s\n", e.what());
+        return 1;
+    }
+}
