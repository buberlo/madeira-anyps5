+// Optional coarse host scheduling; no claim of an exact PS5 priority contract.
+#ifndef CORE_LIBS_PRX_LIBKERNEL_HOST_THREAD_PRIORITY_HPP
+#define CORE_LIBS_PRX_LIBKERNEL_HOST_THREAD_PRIORITY_HPP
+
+#include "prx/libkernel/KernelErrors.hpp"
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#ifndef APS5_PRIORITY_MOCK_WINAPI
+#include <windows.h>
+#endif
+
+namespace HostThreadPriority {
+static bool Enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv("APS5_HOST_THREAD_PRIORITY");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+static int Relative(int guestPriority) {
+    // Existing default700 maps to NORMAL. One regular host step spans128 guest
+    // units; smaller guest numbers mean higher importance. Saturate regular
+    // levels only; accept every existing int without inventing a legal range.
+    const std::int64_t delta = 700 - static_cast<std::int64_t>(guestPriority);
+    return static_cast<int>(std::clamp(delta / 128, std::int64_t{-2}, std::int64_t{2}));
+}
+
+static DWORD Apply(HANDLE thread, int guestPriority) {
+    if (!Enabled() || SetThreadPriority(thread, Relative(guestPriority))) return ERROR_SUCCESS;
+    const DWORD error = GetLastError();
+    return error ? error : ERROR_GEN_FAILURE; // A failed API never becomes success.
+}
+
+static int GuestError(DWORD error) {
+    switch (error) {
+    case ERROR_SUCCESS: return 0;
+    case ERROR_ACCESS_DENIED:
+    case ERROR_PRIVILEGE_NOT_HELD: return SCE_KERNEL_ERROR_EPERM;
+    case ERROR_INVALID_HANDLE:
+    case ERROR_THREAD_NOT_IN_PROCESS: return SCE_KERNEL_ERROR_ESRCH;
+    case ERROR_INVALID_PARAMETER: return SCE_KERNEL_ERROR_EINVAL;
+    case ERROR_NOT_SUPPORTED:
+    case ERROR_CALL_NOT_IMPLEMENTED: return SCE_KERNEL_ERROR_EOPNOTSUPP;
+    default: return SCE_KERNEL_ERROR_EIO;
+    }
+}
+} // namespace HostThreadPriority
+#endif
