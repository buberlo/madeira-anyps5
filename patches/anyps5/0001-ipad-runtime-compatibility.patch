+void noteFrameCounter(std::chrono::steady_clock::time_point started, std::chrono::steady_clock::duration vblankWait, std::chrono::steady_clock::duration presentWait) {
+    struct Window {
+        std::uint64_t frames = 0;
+        std::int64_t cpuNs = 0;
+        std::int64_t vblankWaitNs = 0;
+        std::int64_t presentNs = 0;
+        std::int64_t intervalNs = 0;
