diff --git a/core/shader/recompiler/GroupedMsaa.hpp b/core/shader/recompiler/GroupedMsaa.hpp
new file mode 100644
index 0000000..79f9d3b
--- /dev/null
+++ b/core/shader/recompiler/GroupedMsaa.hpp
@@ -0,0 +1,48 @@
+#ifndef CORE_SHADER_RECOMPILER_GROUPEDMSAA_HPP
+#define CORE_SHADER_RECOMPILER_GROUPEDMSAA_HPP
+
+#include <algorithm>
+#include <cstdint>
+#include <stdexcept>
+
+namespace ShaderRecompiler {
+
+// GC10 T# LAST_LEVEL and MAX_MIP both encode log2(stored fragments) for
+// types 14/15. Coverage samples cannot be inferred from a texture T#.
+// AMD PAL gfx9Device.cpp (c5e8000), CreateImageViewSrds, lines 4205-4212.
+inline std::uint32_t TextureFragmentCount(std::uint32_t word3, std::uint32_t word5) {
+    const auto base = (word3 >> 12u) & 15u;
+    const auto last = (word3 >> 16u) & 15u;
+    const auto maximum = (word5 >> 4u) & 15u;
+    if (base != 0u || last > 3u || last != maximum)
+        throw std::runtime_error("multisampled texture has inconsistent fragment-count fields");
+    return 1u << last;
+}
+
+// 0 preserves the native image representation. 4 selects a separately
+// allocated MSAA array image; eight stored samples become two four-sample layers.
+inline std::uint32_t GroupedNativeSamples(std::uint32_t fragments, std::uint32_t maximum) {
+    if (maximum != 0u && maximum != 4u)
+        throw std::runtime_error("unsupported grouped MSAA native sample limit");
+    if (fragments != 1u && fragments != 2u && fragments != 4u && fragments != 8u)
+        throw std::runtime_error("unsupported multisampled texture fragment count");
+    if (maximum == 0u) return 0u;
+    if (fragments == 1u)
+        throw std::runtime_error("one-fragment MSAA image sampling has no proved host representation");
+    return std::min(fragments, maximum);
+}
+
+struct GroupedSampleAddress { std::uint32_t layer; std::uint32_t sample; };
+
+inline GroupedSampleAddress GroupedSample(std::uint32_t layer, std::uint32_t sample,
+                                         std::uint32_t fragments, std::uint32_t nativeSamples) {
+    if (nativeSamples == 0u || nativeSamples != GroupedNativeSamples(fragments, 4u) || sample >= fragments)
+        throw std::runtime_error("invalid grouped MSAA sample address");
+    const auto groups = fragments / nativeSamples;
+    if (layer > (UINT32_MAX - groups + 1u) / groups)
+        throw std::runtime_error("grouped MSAA layer address overflows");
+    return {layer * groups + sample / nativeSamples, sample % nativeSamples};
+}
+
+}
+#endif
diff --git a/core/shader/recompiler/ImageDescriptorPolicy.hpp b/core/shader/recompiler/ImageDescriptorPolicy.hpp
new file mode 100644
index 0000000..a4af8d6
--- /dev/null
+++ b/core/shader/recompiler/ImageDescriptorPolicy.hpp
@@ -0,0 +1,21 @@
+#ifndef CORE_SHADER_RECOMPILER_IMAGEDESCRIPTORPOLICY_HPP
+#define CORE_SHADER_RECOMPILER_IMAGEDESCRIPTORPOLICY_HPP
+#include <cstdint>
+namespace ShaderRecompiler {
+// Host descriptor legality policy. This does not advertise a SPIR-V capability
+// or emulate null image accesses; shader instructions remain unchanged.
+// TypedPlaceholders is a separate, explicitly enabled host fallback. Its 1x1
+// zero-initialized real images are not Vulkan native-null descriptors.
+enum class ImageDescriptorPolicy : std::uint32_t {
+    RequiresValidImages = 0u,
+    NativeNull = 1u,
+    TypedPlaceholders = 2u,
+};
+inline bool ValidImageDescriptorPolicy(ImageDescriptorPolicy policy) {
+    return policy == ImageDescriptorPolicy::RequiresValidImages || policy == ImageDescriptorPolicy::NativeNull || policy == ImageDescriptorPolicy::TypedPlaceholders;
+}
+inline ImageDescriptorPolicy ImageDescriptorPolicyFor(bool enabledNativeNull, bool enabledTypedPlaceholders = false) {
+    return enabledNativeNull ? ImageDescriptorPolicy::NativeNull : enabledTypedPlaceholders ? ImageDescriptorPolicy::TypedPlaceholders : ImageDescriptorPolicy::RequiresValidImages;
+}
+}
+#endif
