+// Public synthetic encodings and arbitrary constants. No game request bytes.
+namespace PublicInstrumentationProofCases {
+using namespace ShaderRecompiler;
+using Code=std::vector<std::uint32_t>;
+using Change=std::function<void(RdnaProgram&,ControlFlowGraph&)>;
+struct Case {std::string name;Code code;bool expected;Change change{};};
+inline Code constantExport(bool m0=true,bool trace=true){
+ Code c;if(m0)c.insert(c.end(),{0xbefc03ffu,0x12345678u});if(trace)c.push_back(0xbf960000u);
+ c.insert(c.end(),{0x7e000280u,0xf800180fu,0u,0xbf810000u});return c;
+}
+inline std::vector<Case> cases(){
+ std::vector<Case> all;
+ const auto add=[&](std::string name,Code code,bool expected,Change change={}){
+  all.push_back({"instrumentation_"+name,std::move(code),expected,std::move(change)});
+ };
+ add("literal_m0_trace_constant_export",constantExport(),true);
+ add("literal_m0_only",constantExport(true,false),true);
+ add("trace_only",constantExport(false,true),true);
+ add("uninstrumented_constant",constantExport(false,false),true);
+ const auto base=constantExport();
+ const auto mutate=[&](std::string name,unsigned index,std::function<void(RdnaInstruction&)> fn){
+  add(name,base,false,[=](auto& d,auto&){fn(d.instructions.at(index));});
+ };
+ mutate("m0_wrong_family",0,[](auto& i){i.family=RdnaInstructionFamily::VOP1;});
+ mutate("m0_wrong_opcode_id",0,[](auto& i){i.opcodeId=4;});
+ mutate("m0_wrong_raw_opcode",0,[](auto& i){i.rawWords[0]^=0x100u;});
+ mutate("m0_wrong_word_count",0,[](auto& i){i.wordCount=1;});
+ mutate("m0_source_count",0,[](auto& i){i.sourceCount=2;});
+ mutate("m0_partial_width",0,[](auto& i){i.dataDwordCount=2;});
+ mutate("m0_raw_literal_mismatch",0,[](auto& i){i.rawWords[1]^=1;});
+ mutate("m0_vector_source",0,[](auto& i){i.source0.kind=RdnaOperandKind::VectorRegister;i.source0.reg=0;});
+ mutate("m0_scalar_source",0,[](auto& i){i.source0.kind=RdnaOperandKind::ScalarRegister;i.source0.reg=0;});
+ mutate("m0_modified_source",0,[](auto& i){i.source0.negate=true;});
+ mutate("m0_partial_destination",0,[](auto& i){i.destination.explicitSdwaDst=true;});
+ mutate("m0_extra_vector_source",0,[](auto& i){i.source1.kind=RdnaOperandKind::VectorRegister;i.source1.reg=0;});
+ mutate("m0_extra_scalar_source",0,[](auto& i){i.source2.kind=RdnaOperandKind::ScalarRegister;});
+ mutate("m0_second_destination",0,[](auto& i){i.destination2.kind=RdnaOperandKind::VectorRegister;});
+ mutate("m0_clamp_result",0,[](auto& i){i.clampResult=true;});
+ mutate("m0_64_bit",0,[](auto& i){i.is64Bit=true;});
+ mutate("trace_wrong_family",1,[](auto& i){i.family=RdnaInstructionFamily::SOP1;});
+ mutate("trace_wrong_opcode_id",1,[](auto& i){i.opcodeId=0x28;});
+ mutate("trace_wrong_raw_opcode",1,[](auto& i){i.rawWords[0]^=0x10000;});
+ mutate("trace_payload_raw",1,[](auto& i){i.rawWords[0]|=1;});
+ mutate("trace_payload_decoded",1,[](auto& i){i.source0.value=1;});
+ mutate("trace_signed_payload",1,[](auto& i){i.source0.signedVal=1;});
+ mutate("trace_vector_source",1,[](auto& i){i.source0.kind=RdnaOperandKind::VectorRegister;i.source0.reg=0;});
+ mutate("trace_extra_source",1,[](auto& i){i.source1.kind=RdnaOperandKind::VectorRegister;});
+ mutate("trace_destination",1,[](auto& i){i.destination.kind=RdnaOperandKind::ExecLo;});
+ mutate("trace_second_destination",1,[](auto& i){i.destination2.kind=RdnaOperandKind::VectorRegister;});
+ mutate("trace_modified_source",1,[](auto& i){i.source0.dpp=true;});
+ mutate("trace_clamp",1,[](auto& i){i.clampResult=true;});
+ mutate("trace_64_bit",1,[](auto& i){i.is64Bit=true;});
+ mutate("trace_wrong_word_count",1,[](auto& i){i.wordCount=2;});
+ mutate("trace_wrong_source_count",1,[](auto& i){i.sourceCount=0;});
+ auto readBefore=base;readBefore.insert(readBefore.begin()+3,0x7e040300u);add("raw_I_read_before_definition",readBefore,false);
+ auto rawJ=base;rawJ[5]=0x01010101u;add("raw_J_export_without_definition",rawJ,false);
