+            a.instructionBegin != 0u || !a.instructionEnd || a.instructionEnd != b.instructionBegin ||
+            b.instructionBegin >= b.instructionEnd || b.instructionEnd != c.instructionBegin ||
+            c.instructionEnd != decoded.instructions.size() || c.instructionEnd - c.instructionBegin != 3u ||
+            !a.predecessors.empty() || b.predecessors != std::vector<std::uint32_t>{a.id} ||
+            c.predecessors != std::vector<std::uint32_t>{a.id} || a.successors.size() != 2u ||
+            std::set<std::uint32_t>(a.successors.begin(), a.successors.end()) != std::set<std::uint32_t>{b.id,c.id} ||
+            !b.successors.empty() || !c.successors.empty() ||
+            a.terminator.kind != TerminatorKind::ConditionalBranch ||
+            std::set<std::uint32_t>{a.terminator.trueBlock,a.terminator.falseBlock} != std::set<std::uint32_t>{b.id,c.id} ||
+            b.terminator.kind != TerminatorKind::Return || c.terminator.kind != TerminatorKind::Return ||
+            decoded.instructions[b.instructionEnd-1u].op != RdnaOpcode::SEndpgm) return false;
+        const auto branch = decoded.instructions[a.instructionEnd-1u].op;
+        if (branch != RdnaOpcode::SCbranchScc0 && branch != RdnaOpcode::SCbranchScc1 &&
+            branch != RdnaOpcode::SCbranchVccz && branch != RdnaOpcode::SCbranchVccnz &&
+            branch != RdnaOpcode::SCbranchExecz && branch != RdnaOpcode::SCbranchExecnz) return false;
