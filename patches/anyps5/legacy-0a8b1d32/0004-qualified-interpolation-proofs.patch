+ auto altTrace=base;altTrace[2]=0xbfa80000u;add("decoded_alternate_trace_opcode_rejected",altTrace,false);
+ auto exec=base;exec.insert(exec.begin()+4,0xbefe037cu);add("arbitrary_exec_mutation_still_rejected",exec,false);
