+    // the surviving path. Admit exactly one forward diamond: the entry, one
+    // continuation, and an exit consisting of EXEC=0 / empty final export / END.
+    // P1/P2 pairs may not cross the branch, and all I/J checks still apply.
+    std::size_t discardBegin = decoded.instructions.size();
+    const bool discardContinuation = [&] {
+        if (cfg.blocks.size() != 3u || cfg.unsupported || cfg.irreducible ||
+            !cfg.backEdges.empty() || !cfg.naturalLoops.empty()) return false;
+        std::vector<const BasicBlock*> blocks;
+        for (const auto& block : cfg.blocks) blocks.push_back(&block);
+        std::sort(blocks.begin(), blocks.end(), [](const auto* a, const auto* b) { return a->instructionBegin < b->instructionBegin; });
+        const auto& a = *blocks[0]; const auto& b = *blocks[1]; const auto& c = *blocks[2];
