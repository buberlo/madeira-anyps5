+        }
+        const auto writesExec = [](const RdnaOperand& o) {
+            return o.kind == RdnaOperandKind::ExecLo || o.kind == RdnaOperandKind::ExecHi;
+        };
+        if ((!pending.empty() || (vectorWritten && !live.empty() && (!discardContinuation || rawWritten))) &&
+            (writesExec(i.destination) || writesExec(i.destination2))) fail();
+        // Read-only scalar descriptor loads and wait counters do not touch any
+        // vector partial or I/J value. Exclude scalar writes reaching M0/EXEC,
+        // vector operands, barriers, stores, atomics and unknown opcodes.
+        const bool scalarLoad = i.family == RdnaInstructionFamily::SMEM &&
+            (i.op == RdnaOpcode::SLoadDword || i.op == RdnaOpcode::SLoadDwordx2 ||
+             i.op == RdnaOpcode::SLoadDwordx4 || i.op == RdnaOpcode::SLoadDwordx8 || i.op == RdnaOpcode::SLoadDwordx16 ||
+             i.op == RdnaOpcode::SBufferLoadDword || i.op == RdnaOpcode::SBufferLoadDwordx2 ||
+             i.op == RdnaOpcode::SBufferLoadDwordx4 || i.op == RdnaOpcode::SBufferLoadDwordx8 || i.op == RdnaOpcode::SBufferLoadDwordx16);
+        const bool scalarWait = i.family == RdnaInstructionFamily::SOPP &&
+            (i.op == RdnaOpcode::SWaitcnt || i.op == RdnaOpcode::SNop);
+        const auto scalarResult = [](const RdnaOperand& o, std::uint32_t count) {
+            if (o.kind == RdnaOperandKind::None || o.kind == RdnaOperandKind::Null) return true;
+            if (o.kind == RdnaOperandKind::VccLo) return count <= 2u;
+            if (o.kind == RdnaOperandKind::VccHi) return count == 1u;
+            return o.kind == RdnaOperandKind::ScalarRegister && o.reg < 106u && count <= 106u-o.reg;
+        };
+        if (!pending.empty() && (scalarLoad || scalarWait)) {
+            if (i.dataDwordCount == 0u || i.dataDwordCount > 16u ||
+                !(scalarResult(i.destination, i.dataDwordCount) || (scalarWait && i.destination.kind == RdnaOperandKind::Unknown)) ||
+                (i.destination2.kind != RdnaOperandKind::Unknown && i.destination2.kind != RdnaOperandKind::None)) fail();
+            for (const auto& source : {i.source0,i.source1,i.source2,i.source3})
+                if (source.kind == RdnaOperandKind::VectorRegister || source.dpp || source.dpp8) fail();
+            continue;
+        }
+        // Independent vector ALU and a plain read-only 2D IMAGE_SAMPLE can
+        // be scheduled between P1 and P2. Prove their complete register footprint
+        // is disjoint from all partial P1 results; the raw I/J check below still
+        // applies. Stores, atomics, status returns, NSA/packed addressing,
+        // compares, control flow and unknown effects remain rejected.
+        if (!pending.empty()) {
+            const bool independentAlu = i.family == RdnaInstructionFamily::VOP1 || i.family == RdnaInstructionFamily::VOP2 ||
+                                        i.family == RdnaInstructionFamily::VOP3 || i.family == RdnaInstructionFamily::VOP3P;
+            const bool independentSample = i.family == RdnaInstructionFamily::MIMG &&
+                i.op == RdnaOpcode::ImageSample && i.opcodeId == 0x20u && i.imageOpcodeId == 0x20u &&
+                i.imageDimension == RdnaImageDimension::Dim2D && i.imageSampleFlags == 0u &&
+                !i.imageA16 && !i.imageD16 && i.imageNsaDwordCount == 0u &&
+                i.imageAddressComponents == 2u && i.wordCount == 2u && i.sourceCount == 3u &&
+                (i.rawWords[0] & 0x00010000u) == 0u && // TFE writes an extra status register.
+                i.dataDwordCount >= 1u && i.dataDwordCount <= 4u &&
+                i.source0.kind == RdnaOperandKind::VectorRegister &&
+                i.source1.kind == RdnaOperandKind::ScalarRegister &&
+                i.source2.kind == RdnaOperandKind::ScalarRegister &&
+                plain(i.source0) && plain(i.destination);
+            if ((!independentAlu && !independentSample) || i.destination.kind != RdnaOperandKind::VectorRegister) fail();
+            const auto overlapsPartial = [&](const RdnaOperand& operand, std::uint32_t count) {
+                if (operand.kind != RdnaOperandKind::VectorRegister) return false;
+                return std::any_of(pending.begin(), pending.end(), [&](const auto& pair) {
+                    return pair.first >= operand.reg && pair.first - operand.reg < count;
+                });
+            };
+            const auto readCount = independentSample ? 2u : i.is64Bit ? 2u : 1u;
+            const auto writeCount = independentSample ? i.dataDwordCount : readCount;
+            for (const auto& source : {i.source0, i.source1, i.source2, i.source3})
+                if (overlapsPartial(source, readCount)) fail();
+            if (overlapsPartial(i.destination, writeCount) || overlapsPartial(i.destination2, writeCount)) fail();
+        }
+        const bool alu = i.family == RdnaInstructionFamily::VOP1 || i.family == RdnaInstructionFamily::VOP2 ||
+                         i.family == RdnaInstructionFamily::VOP3 || i.family == RdnaInstructionFamily::VOP3P || i.family == RdnaInstructionFamily::VOPC;
+        const bool output = i.op == RdnaOpcode::Exp && i.family == RdnaInstructionFamily::EXP;
+        const auto width = output ? 1u : alu ? (i.is64Bit ? 2u : 1u) : std::max({4u, i.dataDwordCount, i.dataComponents, i.imageAddressComponents});
+        std::uint32_t sourceIndex = 0;
+        for (const auto& source : {i.source0, i.source1, i.source2, i.source3}) {
+            // EXP channels name independent scalar VGPRs. Disabled channels
+            // do not read their encoded operands; packed outputs use two VGPRs.
+            const auto channelMask = i.exportIsCompressed ? (sourceIndex < 2u ? 3u << (sourceIndex * 2u) : 0u) : 1u << sourceIndex;
+            ++sourceIndex;
+            if (output && (i.exportEnableMask & channelMask) == 0u) continue;
+            if (source.dpp || source.dpp8) fail();
+            if (source.kind != RdnaOperandKind::VectorRegister) continue;
+            for (const auto reg : live) if (reg >= source.reg && reg - source.reg < width) fail();
+        }
+        if (i.imageNsaDwordCount != 0u) {
+            // The backend reads the base VGPR and exactly addressDwords-1
+            // encoded NSA words. Unused encoded bytes and array padding are
+            // not reads; neither may hide an active raw I/J register.
+            if (i.family!=RdnaInstructionFamily::MIMG || i.imageNsaDwordCount>3u ||
+                i.imageAddressComponents>13u) fail();
+            const auto count=GetRdnaImageAddressDwordCount(i.imageSampleFlags,i.imageAddressComponents);
+            if (!count || count>13u || count>1u+i.imageNsaDwordCount*4u) fail();
+            for (std::uint32_t n=0;n+1u<count;++n)
+                if (live.contains(i.imageNsaVectorRegisters[n])) fail();
+        }
+        // Memory decoders record the written vector width. ALU destinations
+        // forget just their first register; ambiguous wider writes reject later.
+        if (i.destination.kind == RdnaOperandKind::VectorRegister) {
+            const bool memory = i.family == RdnaInstructionFamily::MIMG || i.family == RdnaInstructionFamily::MUBUF ||
+                                i.family == RdnaInstructionFamily::MTBUF || i.family == RdnaInstructionFamily::FLAT || i.family == RdnaInstructionFamily::DS;
+            const auto count = memory ? std::max(i.dataDwordCount, 1u) : 1u;
+            for (std::uint32_t j = 0; j < count; ++j) {
+                if (originalRaw.contains(i.destination.reg+j)) rawWritten = true;
+                live.erase(i.destination.reg + j);
+            }
+            vectorWritten = true;
+        }
+        if (i.destination2.kind == RdnaOperandKind::VectorRegister) {
+            if (originalRaw.contains(i.destination2.reg)) rawWritten = true;
+            live.erase(i.destination2.reg);
+        }
+    }
+    if (!pending.empty()) fail();
+}
+}
diff --git a/core/shader/recompiler/Translation/include/Translation/OptionalInterpolationGroupsProof.hpp b/core/shader/recompiler/Translation/include/Translation/OptionalInterpolationGroupsProof.hpp
new file mode 100644
index 0000000..eef5820
--- /dev/null
+++ b/core/shader/recompiler/Translation/include/Translation/OptionalInterpolationGroupsProof.hpp
@@ -0,0 +1,89 @@
+#pragma once
+#include <optional>
+namespace ShaderRecompiler {
+// This supplements the fresh-decoded forward-DAG checks in the caller. A
+// conditional group cannot export a partial P1 or lose the skipped-path value.
+inline bool ProveOptionalInterpolationGroups(const RdnaProgram& decoded,
+                                             const ControlFlowGraph& cfg) {
+    std::vector<const BasicBlock*> blocks;
+    for (const auto& b:cfg.blocks) blocks.push_back(&b);
+    std::sort(blocks.begin(),blocks.end(),[](auto* a,auto* b){return a->instructionBegin<b->instructionBegin;});
+    if(blocks.size()<4u || blocks.size()>64u || cfg.unsupported || cfg.irreducible || !cfg.backEdges.empty() || !cfg.naturalLoops.empty()) return false;
+    // Fresh decoding/graph identity is checked by the caller. Reject malformed
+    // ranges before this supplemental proof indexes an untrusted graph.
+    if(blocks.front()->id!=cfg.entryBlock || blocks.front()->instructionBegin!=0u || blocks.back()->instructionEnd!=decoded.instructions.size()) return false;
+    std::set<std::uint32_t> blockIds;
+    for(std::size_t b=0;b<blocks.size();++b){const auto& block=*blocks[b];
+        if(!blockIds.insert(block.id).second || block.instructionBegin>=block.instructionEnd || block.instructionEnd>decoded.instructions.size() || (b&&blocks[b-1u]->instructionEnd!=block.instructionBegin)) return false;
+    }
+    std::set<std::uint32_t> results;
+    std::size_t first=decoded.instructions.size(),last=0;
+    std::optional<std::uint32_t> stableM0;
+    const auto plain=[](const RdnaOperand& o){return !o.negate&&!o.negateHi&&!o.absolute&&!o.clamp&&!o.omod&&!o.opSel&&!o.opSelHi&&!o.dpp&&!o.dpp8&&!o.explicitSdwaDst&&!o.sdwaSext&&o.sdwaSel==6u;};
+    for(std::size_t n=0;n<decoded.instructions.size();++n){const auto& i=decoded.instructions[n];
+        if(i.op==RdnaOpcode::VInterpP1F32 || i.op==RdnaOpcode::VInterpP2F32){
+            if(i.destination.kind!=RdnaOperandKind::VectorRegister) return false;
+            results.insert(i.destination.reg);first=std::min(first,n);last=n;
+        }
+    }
+    if(first==decoded.instructions.size()) return false;
+    // The first group's exact M0 assignment chooses one original SGPR. Any
+    // later group may reassert it, but no path may redefine that SGPR before
+    // the final group. Initial metadata M0 is not an interpolation assignment.
+    for(std::size_t n=0;n<first;++n){const auto& i=decoded.instructions[n];if(i.destination.kind==RdnaOperandKind::M0){
+        stableM0.reset();if(i.op==RdnaOpcode::SMovB32 && i.family==RdnaInstructionFamily::SOP1 && i.source0.kind==RdnaOperandKind::ScalarRegister && i.source0.reg<106u && plain(i.source0)&&plain(i.destination)) stableM0=i.source0.reg;
+    }}
+    if(!stableM0) return false;
+    for(std::size_t n=0;n<=last;++n){const auto& i=decoded.instructions[n];
+        for(const auto* o:{&i.destination,&i.destination2})if(o->kind==RdnaOperandKind::ScalarRegister){
+            const auto width=std::max(i.dataDwordCount,i.is64Bit?2u:1u);
+            if(*stableM0>=o->reg && *stableM0-o->reg<width) return false;
+        }
+        if(i.destination2.kind==RdnaOperandKind::M0) return false;
+        if(n>=first && i.destination.kind==RdnaOperandKind::M0 &&
+           (i.op!=RdnaOpcode::SMovB32 || i.family!=RdnaInstructionFamily::SOP1 || i.source0.kind!=RdnaOperandKind::ScalarRegister || i.source0.reg!=*stableM0 || !plain(i.source0)||!plain(i.destination))) return false;
+    }
+    // EXEC remains fixed throughout the active groups: the scalar CFG branch
+    // selects one path for that wave's active lanes. At a merge, definitions
+    // intersect while potential interpolated values union. Thus a skipped
+    // group's destination needs initialization only when subsequently read.
+    struct State{std::set<std::uint32_t> defined,mayInterpolation;bool m0=false;};std::map<std::uint32_t,State> ends;
+    for(std::size_t b=0;b<blocks.size();++b){const auto& block=*blocks[b];State state;
+        if(b){if(block.predecessors.empty())return false;bool initial=true;
+            for(auto id:block.predecessors){auto f=ends.find(id);if(f==ends.end())return false;
+                if(initial){state=f->second;initial=false;}else{std::set<std::uint32_t> meet;std::set_intersection(state.defined.begin(),state.defined.end(),f->second.defined.begin(),f->second.defined.end(),std::inserter(meet,meet.end()));state.defined=std::move(meet);state.m0=state.m0&&f->second.m0;state.mayInterpolation.insert(f->second.mayInterpolation.begin(),f->second.mayInterpolation.end());}
+            }
+        }
+        std::map<std::uint32_t,std::tuple<std::uint32_t,std::uint32_t,std::uint32_t>> pending;
+        for(std::size_t k=block.instructionBegin;k<block.instructionEnd;++k){const auto& i=decoded.instructions[k];
+            if(i.destination.kind==RdnaOperandKind::M0){if(!pending.empty())return false;state.m0=i.op==RdnaOpcode::SMovB32 && i.source0.kind==RdnaOperandKind::ScalarRegister && i.source0.reg==*stableM0 && plain(i.source0)&&plain(i.destination);}
+            if(i.op==RdnaOpcode::VInterpP1F32){if(!state.m0 || pending.contains(i.destination.reg))return false;pending.emplace(i.destination.reg,std::tuple{i.source0.reg,i.source1.value,i.source2.value});continue;}
+            if(i.op==RdnaOpcode::VInterpP2F32){auto f=pending.find(i.destination.reg);if(!state.m0 || f==pending.end() || std::get<0>(f->second)+1u!=i.source0.reg || std::get<1>(f->second)!=i.source1.value || std::get<2>(f->second)!=i.source2.value)return false;pending.erase(f);state.defined.insert(i.destination.reg);state.mayInterpolation.insert(i.destination.reg);continue;}
+            const auto read=[&](std::uint32_t reg,std::uint32_t count){if(reg>=256u||!count||count>256u-reg)return false;for(auto r:results)if(r>=reg&&r-reg<count&&(pending.contains(r)||(state.mayInterpolation.contains(r)&&!state.defined.contains(r))))return false;return true;};
+            const bool alu=i.family==RdnaInstructionFamily::VOP1 || i.family==RdnaInstructionFamily::VOP2 || i.family==RdnaInstructionFamily::VOP3 || i.family==RdnaInstructionFamily::VOP3P || i.family==RdnaInstructionFamily::VOPC;
+            const bool output=i.family==RdnaInstructionFamily::EXP && i.op==RdnaOpcode::Exp;
+            const bool image=i.family==RdnaInstructionFamily::MIMG && i.op==RdnaOpcode::ImageSample;
+            if(alu && !UnusedBarycentricProof::EffectsFor(i)){
+                switch(i.op){case RdnaOpcode::VMovB32:case RdnaOpcode::VAddF32:case RdnaOpcode::VSubF32:case RdnaOpcode::VMulF32:case RdnaOpcode::VRcpF32:case RdnaOpcode::VSubrevF32:case RdnaOpcode::VMacF32:case RdnaOpcode::VMinF32:case RdnaOpcode::VMaxF32:case RdnaOpcode::VMin3F32:case RdnaOpcode::VMadakF32:case RdnaOpcode::VMadF32:case RdnaOpcode::VFmaF32:case RdnaOpcode::VCndmaskB32:case RdnaOpcode::VCmpLtF32:case RdnaOpcode::VCmpGtF32:case RdnaOpcode::VCmpNeqF32:case RdnaOpcode::VRsqF32:case RdnaOpcode::VLogF32:case RdnaOpcode::VExpF32:case RdnaOpcode::VCubemaF32:case RdnaOpcode::VCubescF32:case RdnaOpcode::VCubetcF32:case RdnaOpcode::VCubeidF32:break;default:return false;}
+            }
+            if(image){const auto count=GetRdnaImageAddressDwordCount(i.imageSampleFlags,i.imageAddressComponents);if(!count||count>13u||i.imageNsaDwordCount>3u||i.imageA16||i.imageD16)return false;
+                if(i.source0.kind!=RdnaOperandKind::VectorRegister || !read(i.source0.reg,i.imageNsaDwordCount?1u:count))return false;
+                if(i.imageNsaDwordCount){if(count>1u+i.imageNsaDwordCount*4u)return false;for(std::uint32_t n=0;n+1u<count;++n)if(!read(i.imageNsaVectorRegisters[n],1u))return false;}
+            }else{
+                unsigned n=0;for(const auto* o:{&i.source0,&i.source1,&i.source2,&i.source3}){const auto channel=i.exportIsCompressed?(n<2u?3u<<(n*2u):0u):1u<<n;++n;if(output&&!(i.exportEnableMask&channel))continue;
+                    if(o->kind==RdnaOperandKind::VectorRegister && (!alu&&!output || !read(o->reg,output?1u:i.is64Bit?2u:1u)))return false;
+                    if(o->dpp||o->dpp8)return false;
+                }
+            }
+            if(i.op==RdnaOpcode::VMacF32 && i.destination.kind==RdnaOperandKind::VectorRegister && !read(i.destination.reg,1u))return false;
+            if((i.destination.kind==RdnaOperandKind::ExecLo||i.destination.kind==RdnaOperandKind::ExecHi||i.destination2.kind==RdnaOperandKind::ExecLo||i.destination2.kind==RdnaOperandKind::ExecHi) &&
+               !(b==0u&&k<first&&i.op==RdnaOpcode::SWqmB64) && !(b+1u==blocks.size()&&k>last&&i.op==RdnaOpcode::SMovB64&&i.source0.kind==RdnaOperandKind::ScalarRegister))return false;
+            const auto write=[&](const RdnaOperand& o,std::uint32_t count){if(o.kind!=RdnaOperandKind::VectorRegister)return true;if(o.negateHi||o.opSel||o.opSelHi||o.dpp||o.dpp8||o.sdwaSext||o.sdwaSel!=6u||o.reg>=256u||!count||count>256u-o.reg)return false;for(auto r:results)if(r>=o.reg&&r-o.reg<count){if(pending.contains(r))return false;state.defined.insert(r);state.mayInterpolation.erase(r);}return true;};
+            const auto count=image?i.dataDwordCount:i.is64Bit?2u:1u;
+            if(!write(i.destination,count)||!write(i.destination2,1u))return false;
+        }
+        if(!pending.empty() || !ends.emplace(block.id,std::move(state)).second)return false;
+    }
+    return true;
+}
+}
diff --git a/core/shader/recompiler/Translation/include/Translation/UnusedBarycentricProof.hpp b/core/shader/recompiler/Translation/include/Translation/UnusedBarycentricProof.hpp
new file mode 100644
index 0000000..92e0da4
--- /dev/null
+++ b/core/shader/recompiler/Translation/include/Translation/UnusedBarycentricProof.hpp
@@ -0,0 +1,440 @@
+#pragma once
+#include "ControlFlow/ControlFlowGraph.hpp"
+#include "RdnaDecoder/RdnaProgram.hpp"
+#include <array>
+#include <bitset>
+#include <algorithm>
+#include <optional>
+#include <set>
+#include <vector>
+
+namespace ShaderRecompiler::UnusedBarycentricProof {
+// This proof is deliberately a small admitted instruction language. It does
+// not infer destination widths or implicit effects from a broad family.
+struct Range { unsigned base=0, count=0; };
+enum class MaskEffect { None, Copy64, AndSave64, WholeQuad64 };
+struct Effects {
+ std::vector<Range> reads, writes, scalarWrites;
+ MaskEffect mask=MaskEffect::None;
+};
+inline bool Plain(const RdnaOperand& o) {
+ return !o.negate && !o.negateHi && !o.absolute && !o.clamp && !o.omod && !o.opSel && !o.opSelHi &&
+        !o.dpp && !o.dpp8 && !o.explicitSdwaDst && !o.sdwaSext && o.sdwaSel==6u;
+}
+// The distinct VCC halves share the scalar identity bank, but never overlap
+// arbitrary scalar encodings. SGPR106+ aliases must have been decoded by kind.
+inline std::optional<unsigned> Scalar(const RdnaOperand& o) {
+ if(o.kind==RdnaOperandKind::ScalarRegister && o.reg<106)return o.reg;
+ if(o.kind==RdnaOperandKind::VccLo)return 106;
+ if(o.kind==RdnaOperandKind::VccHi)return 107;
+ if(o.kind==RdnaOperandKind::ExecLo)return 108;
+ if(o.kind==RdnaOperandKind::ExecHi)return 109;
+ return {};
+}
+inline bool ScalarRange(const RdnaOperand& o,unsigned count,Range& range) {
+ const auto base=Scalar(o);if(!base||!count)return false;
+ const unsigned limit=*base<106?106:*base<108?108:110;
+ if(count>limit-*base)return false;
+ range={*base,count};return true;
+}
+inline bool Read(Effects& out,const RdnaOperand& o,unsigned width,bool vectorAllowed=true) {
+ if(!Plain(o)||!width)return false;
+ switch(o.kind){
+ case RdnaOperandKind::VectorRegister:
+  if(!vectorAllowed||o.reg>=256||width>256-o.reg)return false;
+  out.reads.push_back({o.reg,width});return true;
+ case RdnaOperandKind::ScalarRegister:case RdnaOperandKind::VccLo:case RdnaOperandKind::VccHi:
+ case RdnaOperandKind::ExecLo:case RdnaOperandKind::ExecHi:{Range r;return ScalarRange(o,width,r);}
+ case RdnaOperandKind::LiteralConstant:case RdnaOperandKind::IntegerInlineConstant:
+ case RdnaOperandKind::FloatInlineConstant:case RdnaOperandKind::Null:return true;
+ default:return false;
+ }
+}
+inline bool VectorWrite(Effects& out,const RdnaOperand& o,unsigned width) {
+ if(!Plain(o)||o.kind!=RdnaOperandKind::VectorRegister||o.reg>=256||!width||width>256-o.reg)return false;
+ out.writes.push_back({o.reg,width});return true;
+}
+inline bool ScalarWrite(Effects& out,const RdnaOperand& o,unsigned width) {
+ if(!Plain(o))return false;
+ if(o.kind==RdnaOperandKind::Null)return true;
+ Range r;if(!ScalarRange(o,width,r))return false;out.scalarWrites.push_back(r);return true;
+}
+inline bool EmptySecond(const RdnaOperand& o){return o.kind==RdnaOperandKind::Unknown||o.kind==RdnaOperandKind::None;}
+inline std::optional<Effects> Footprint(const RdnaInstruction& i) {
+ Effects out;
+ if(!EmptySecond(i.destination2)||i.is64Bit||i.clampResult)return {};
+ const auto one=[&]{return i.sourceCount==1&&Read(out,i.source0,1)&&VectorWrite(out,i.destination,1);};
+ const auto two=[&]{return i.sourceCount==2&&Read(out,i.source0,1)&&Read(out,i.source1,1)&&VectorWrite(out,i.destination,1);};
+ switch(i.op){
+ case RdnaOpcode::VMovB32:case RdnaOpcode::VCvtU32F32:case RdnaOpcode::VCvtF32U32:
+ case RdnaOpcode::VCvtI32F32:case RdnaOpcode::VCvtF32I32:case RdnaOpcode::VRcpF32:
+  if(i.family!=RdnaInstructionFamily::VOP1||!one())return {};break;
+ case RdnaOpcode::VAddF32:case RdnaOpcode::VMulF32:case RdnaOpcode::VAndB32:
+ case RdnaOpcode::VAshrrevI32:case RdnaOpcode::VAddNcU32:
+  if(i.family!=RdnaInstructionFamily::VOP2||!two())return {};break;
+ case RdnaOpcode::VCvtPkrtzF16F32:
+  // Both forms read two complete F32 words before writing one packed U32.
+  // The native VOP3 form is admitted only with its exact two-source opcode;
+  // Plain/VectorWrite retain modifier, cross-lane and partial-write guards.
+  if((i.family!=RdnaInstructionFamily::VOP2&&
+      !(i.family==RdnaInstructionFamily::VOP3&&i.opcodeId==0x12fu&&i.wordCount==2&&
+        (i.rawWords[0]&0xfc000000u)==0xd4000000u&&((i.rawWords[0]>>16u)&0x3ffu)==0x12fu&&
+        !(i.rawWords[0]&0xff00u)&&!(i.rawWords[1]&0xfffc0000u)&&EmptySecond(i.source2)&&EmptySecond(i.source3)))||!two())return {};break;
+ case RdnaOpcode::VMadF32:
+  // This exact native VOP3 MAD reads all three complete F32 sources before
+  // defining one whole word. It retains the backend's separately rounded
+  // product; this liveness proof does not replace MAD with fused arithmetic.
+  if(i.family!=RdnaInstructionFamily::VOP3||i.opcodeId!=0x141u||i.wordCount!=2||i.sourceCount!=3||
