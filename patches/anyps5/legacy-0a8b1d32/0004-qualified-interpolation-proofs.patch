+inline std::vector<Case> pairCases(){
+ std::vector<Case> all;
+ const auto add=[&](std::string name,Code code,bool expected){all.push_back({"instrumentation_"+name,std::move(code),expected,{}});};
+ const Code complete{0xc8100000u,0xc8110001u,0xf800180fu,0x04040404u,0xbf810000u};
+ add("complete_P1_P2_guard",complete,true);
+ auto incomplete=complete;incomplete.erase(incomplete.begin()+1);add("incomplete_P1_P2_guard",incomplete,false);
+ auto j=complete;j[1]=0xc8110000u;add("corrupted_original_J_guard",j,false);
+ auto i=complete;i[0]=0xc8100001u;add("corrupted_original_I_guard",i,false);
+ auto attribute=complete;attribute[1]|=1u<<10u;add("mismatched_attribute_guard",attribute,false);
+ auto partial=complete;partial.insert(partial.begin()+1,{0xf8000001u,4u});add("partial_P1_export_guard",partial,false);
+ auto trace=complete;trace.insert(trace.begin()+1,0xbf960000u);add("trace_pending_P1_P2_remains_rejected",trace,false);
+ return all;
+}
+} // namespace PublicInstrumentationProofCases
