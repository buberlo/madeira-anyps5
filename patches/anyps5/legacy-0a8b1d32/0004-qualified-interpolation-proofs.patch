+  }else if(fx.mask==MaskEffect::AndSave64){
+   const auto dest=Scalar(i.destination);if(!dest)return false;
+   state.tags[*dest]=oldExec[0];state.tags[*dest+1]=oldExec[1];
+   scoped.reset(); // The opcode changes EXEC implicitly after saving it.
+   const auto intersection=[](Tag a,Tag b,Tag entry){
+    if(a==Tag::Top&&b==Tag::Top)return Tag::Top;
+    if((a==entry||a==Tag::Top)&&(b==entry||b==Tag::Top))return entry;
+    return Tag::Unknown;
+   };
+   state.tags[108]=intersection(oldExec[0],source[0],Tag::EntryLow);
+   state.tags[109]=intersection(oldExec[1],source[1],Tag::EntryHigh);
+   const bool sourceEntry=(source[0]==Tag::EntryLow||source[0]==Tag::Top)&&(source[1]==Tag::EntryHigh||source[1]==Tag::Top);
+   state.coversEntry=state.coversEntry&&sourceEntry;
+   state.wholeQuad=false;
+   // AND cannot add a lane to the previous proved subset.
+  }else if(fx.mask==MaskEffect::WholeQuad64){
+   scoped.reset();
+   state.tags[108]=Tag::Unknown;state.tags[109]=Tag::Unknown;
+   // Quad expansion preserves every current lane; only an already proved
+   // entry-covering mask guarantees that a new full write covers entry too.
+   state.subset=false;state.wholeQuad=true;
+  }
+  for(const auto& r:fx.writes)for(unsigned v=r.base;v<r.base+r.count;++v){
+   if(raw[v]){scoped.set(v);if(state.coversEntry)state.clean.set(v);}
+  }
+  if(checkReads&&!state.subset&&!state.wholeQuad)return false;
+ }
+ return true;
+}
+inline bool Prove(const RdnaProgram& decoded,const ControlFlowGraph& cfg,const std::set<unsigned>& rawSet){
+ if(decoded.instructions.empty()||decoded.instructions.size()>4096||cfg.blocks.empty()||cfg.blocks.size()>256||cfg.unsupported||cfg.irreducible||rawSet.empty()||rawSet.size()>14)return false;
+ std::bitset<256> raw;for(const auto v:rawSet){if(v>=256)return false;raw.set(v);}
+ std::vector<Effects> effects;effects.reserve(decoded.instructions.size());
+ for(const auto& i:decoded.instructions){const auto fx=EffectsFor(i);if(!fx)return false;effects.push_back(*fx);}
+ // A guest mask expansion is not a proof that native helper peers execute
+ // a divergent CFG branch. Restrict the newly admitted WQM language to one
+ // straight-line guest block; the older non-WQM CFG proof stays unchanged.
+ if(cfg.blocks.size()!=1u&&std::any_of(effects.begin(),effects.end(),[](const auto& f){return f.mask==MaskEffect::WholeQuad64;}))return false;
+ std::vector<unsigned> ids;for(const auto& b:cfg.blocks){if(std::find(ids.begin(),ids.end(),b.id)!=ids.end()||b.instructionBegin>=b.instructionEnd||b.instructionEnd>decoded.instructions.size())return false;ids.push_back(b.id);}
+ const auto index=[&](unsigned id){const auto found=std::find(ids.begin(),ids.end(),id);return found==ids.end()?ids.size():static_cast<std::size_t>(found-ids.begin());};
+ // Match every admitted terminator to its exact last instruction and target.
+ for(const auto& b:cfg.blocks){
+  const auto& i=decoded.instructions[b.instructionEnd-1];
+  for(auto n=b.instructionBegin;n+1<b.instructionEnd;++n){const auto op=decoded.instructions[n].op;
+   if(op==RdnaOpcode::SEndpgm||op==RdnaOpcode::SBranch||op==RdnaOpcode::SCbranchScc0||op==RdnaOpcode::SCbranchScc1||op==RdnaOpcode::SCbranchExecz||op==RdnaOpcode::SCbranchExecnz)return false;
+  }
+  if(decoded.instructions[b.instructionBegin].programCounter!=b.startProgramCounter||i.programCounter+4u*i.wordCount!=b.endProgramCounter)return false;
+  const auto target=index(b.terminator.trueBlock),fall=index(b.terminator.falseBlock);
+  const auto condition=[&]()->std::optional<BranchCondition>{switch(i.op){
+   case RdnaOpcode::SCbranchScc0:return BranchCondition::SccZero;
+   case RdnaOpcode::SCbranchScc1:return BranchCondition::SccNonZero;
+   case RdnaOpcode::SCbranchExecz:return BranchCondition::ExecZero;
+   case RdnaOpcode::SCbranchExecnz:return BranchCondition::ExecNonZero;
+   default:return {};}}();
+  if(condition){
+   if(b.terminator.kind!=TerminatorKind::ConditionalBranch||b.terminator.condition!=*condition||target==ids.size()||fall==ids.size()||
+      cfg.blocks[target].startProgramCounter!=i.branchTarget||cfg.blocks[fall].startProgramCounter!=b.endProgramCounter||
+      std::set<unsigned>(b.successors.begin(),b.successors.end())!=std::set<unsigned>{b.terminator.trueBlock,b.terminator.falseBlock})return false;
+  }else if(i.op==RdnaOpcode::SEndpgm){if(b.terminator.kind!=TerminatorKind::Return||!b.successors.empty())return false;}
+  else {
+   if(b.terminator.kind!=TerminatorKind::Branch||b.terminator.condition!=BranchCondition::Always||target==ids.size()||
+      b.successors!=std::vector<unsigned>{b.terminator.trueBlock}||cfg.blocks[target].startProgramCounter!=(i.op==RdnaOpcode::SBranch?i.branchTarget:b.endProgramCounter))return false;
+  }
+ }
+ const auto entry=index(cfg.entryBlock);if(entry==ids.size()||!cfg.blocks[entry].predecessors.empty()||cfg.blocks[entry].instructionBegin)return false;
+ std::vector<unsigned> coverage(decoded.instructions.size());for(const auto& b:cfg.blocks)for(auto n=b.instructionBegin;n<b.instructionEnd;++n)++coverage[n];
+ if(std::any_of(coverage.begin(),coverage.end(),[](auto n){return n!=1;}))return false;
+ std::vector<bool> reachable(ids.size());reachable[entry]=true;std::vector<std::size_t> queue{entry};
+ for(std::size_t n=0;n<queue.size();++n){const auto& b=cfg.blocks[queue[n]];
+  for(auto id:b.successors){const auto target=index(id);if(target==ids.size()||std::find(cfg.blocks[target].predecessors.begin(),cfg.blocks[target].predecessors.end(),b.id)==cfg.blocks[target].predecessors.end())return false;
+   if(!reachable[target]){reachable[target]=true;queue.push_back(target);}}
+ }
+ for(const auto& b:cfg.blocks)for(auto id:b.predecessors){const auto pred=index(id);if(pred==ids.size()||std::find(cfg.blocks[pred].successors.begin(),cfg.blocks[pred].successors.end(),b.id)==cfg.blocks[pred].successors.end())return false;}
+ std::vector<State> incoming(ids.size(),Top()),outgoing(ids.size(),Top());incoming[entry]=Entry();
+ bool converged=false;
+ for(std::size_t pass=0;pass<512u;++pass){bool changed=false;
+  for(const auto n:queue){State in=n==entry?Entry():Top();
+   if(n!=entry)for(auto id:cfg.blocks[n].predecessors){const auto pred=index(id);if(reachable[pred])in=Meet(in,outgoing[pred]);}
+   State out=in;if(!Transfer(out,decoded,cfg.blocks[n],effects,raw,false))return false;
+   if(in!=incoming[n]||out!=outgoing[n]){incoming[n]=in;outgoing[n]=out;changed=true;}
+  }
+  if(!changed){converged=true;break;}
+ }
+ if(!converged)return false;
+ for(const auto n:queue){auto state=incoming[n];if(std::find(state.tags.begin(),state.tags.end(),Tag::Top)!=state.tags.end()||!Transfer(state,decoded,cfg.blocks[n],effects,raw,true))return false;}
+ return true;
+}
+}
