+#ifndef CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_SPLITDRAWSHADERVALIDATION_HPP
+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_SPLITDRAWSHADERVALIDATION_HPP
+
+#include "prx/libSceAgcDriver/Graphics/include/Shaders.hpp"
+#include <string>
+
+namespace AgcDriver::Graphics {
+
+// Conservative shader-only prerequisite for repeating one vertex/fragment draw
+// into disjoint native sample groups. Empty means this static prerequisite passed.
+// Run ordinary pipeline/SPIR-V validation first. A pass DOES NOT prove that
+// resource reads cannot alias the attachments or writes of another pass; the draw
+// path must separately prove dynamic alias/feedback freedom, preserve sample
+// locations, depth/stencil, queries, and target lifetime before enabling a split.
+// This is not called for ordinary single-sample rendering.
+std::string SplitDrawShaderRejection(std::span<const CompiledShader> shaders);
+
+// The same prerequisite for the internally generated rectangle pipeline. The
+// original guest vertex/fragment programs must pass the ordinary static guard.
+// Both intermediate stages, including all their resource metadata, must match
+// a fresh BuildRectListShaders result for these programs and the actual target.
+// Only that canonical factory's private fault diagnostic may be repeated; this
+// does not admit arbitrary guest tessellation or relax dynamic resource checks.
+std::string SplitRectListShaderRejection(std::span<const CompiledShader> shaders,
+                                       const ShaderRecompiler::SpirvTarget& target);
+
+}
+#endif
