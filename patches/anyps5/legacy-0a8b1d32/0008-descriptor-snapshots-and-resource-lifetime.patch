+    }
+    check(function == 0 && entries == 1 && functions.contains(entry), "incomplete shader function or unresolved entry point");
+    for (const auto call : calls) check(functions.contains(call), "unresolved external shader function");
+    if (helper && derivatives) return "helper coverage combined with derivatives or implicit LOD is not proved invariant across sample groups";
+    const auto storage = [&](std::uint32_t id) {
+        const auto value = valueType.find(id);
+        check(value != valueType.end(), "unresolved pointer origin");
+        return pointerStorage.at(value->second);
+    };
+    for (const auto instruction : instructions) {
+        const auto op = static_cast<spv::Op>(instruction[0] & 0xffffu);
+        if (op == spv::OpLoad) static_cast<void>(storage(instruction[3]));
+        if (op == spv::OpAccessChain || op == spv::OpInBoundsAccessChain || op == spv::OpPtrAccessChain || op == spv::OpInBoundsPtrAccessChain) {
+            const auto origin = storage(instruction[3]);
+            check(storage(instruction[2]) == origin, "access chain changes pointer storage class");
+        }
+        if (valueType.contains(instruction.size() >= 3 ? instruction[2] : 0u)) {
+            if (op == spv::OpCopyObject || op == spv::OpBitcast) check(storage(instruction[2]) == storage(instruction[3]), "pointer copy or cast changes storage class");
+            if (op == spv::OpSelect) check(storage(instruction[2]) == storage(instruction[4]) && storage(instruction[2]) == storage(instruction[5]), "pointer select has unresolved or inconsistent origins");
+            if (op == spv::OpPhi)
