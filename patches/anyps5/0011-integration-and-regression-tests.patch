+                    face.depthFailOp == VK_STENCIL_OP_REPLACE, "equivalent stencil clear lost replacement state");
+        }
+    };
+    verify(); // EARLY_Z_THEN_LATE_Z = 1
+    queue.context[0x203] = 0; // LATE_Z = 0
+    verify();
+    queue.context[0x00a] = 0x7a;
+    queue.context[0x10c] |= 0x7a;
+    queue.context[0x10d] |= 0x7a;
