+        sample.SetSamples(samples);
+        const auto snapshot = sample.Snapshot();
+        const auto selected = ResourceMaterializer::RuntimeImageMode(image, snapshot.images.front(), modes);
+        const auto expectedNative = grouped ? (samples == 8u ? 4u : samples) : 0u;
+        require(modes.at(selected).nativeSamples == expectedNative && (!grouped || modes.at(selected).logicalSamples == samples), "MSAA descriptor selected the wrong native sample representation");
+        const DescriptorBindingBuilder builder;
+        const auto plan = builder.Prepare(variant.bindings.layout, info, variant.info.stage, snapshot);
+        const auto selector = std::ranges::find_if(plan.specialization, [](const auto& value) { return value.id == PipelineSpecialization::ImageBase; });
+        require(selector != plan.specialization.end() && selector->value == selected, "MSAA binding plan disagrees with its prepared runtime mode");
+        BindingAllocationResult allocation;
+        builder.Populate(allocation, variant.bindings, plan, variant.info.userDataBase, snapshot, {});
+        const auto binding = std::ranges::find_if(allocation.bindings, [](const auto& value) { return value.role == DescriptorRole::GuestImages; });
+        require(binding != allocation.bindings.end() && binding->count == 1u && binding->kind == DescriptorKind::SampledImage, "MSAA materialization lost its sampled typed heap");
+        require(std::ranges::count_if(allocation.bindings, [](const auto& value) { return value.role == DescriptorRole::GuestImages; }) == 1u, "inactive typed image heaps survived compact binding selection");
+        require(binding->imageShape == expectedShape && binding->imageLogicalSamples == std::vector<std::uint32_t>{samples} && binding->imageNativeSamples == std::vector<std::uint32_t>{expectedNative}, "MSAA cache produced incorrect image shape or sample metadata");
