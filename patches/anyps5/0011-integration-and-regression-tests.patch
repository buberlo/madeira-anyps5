+void verifyMsaaAcrossProcesses(const char* self) {
+    const auto before = ShaderDiskCache::Totals();
+    for (const bool arrayed : {false, true}) {
+        MsaaRequest native(0u, arrayed);
+        MsaaRequest grouped(4u, arrayed);
+        require(native.Key() != grouped.Key() && RecompileCacheKey::ContextHash(native.request) != RecompileCacheKey::ContextHash(grouped.request), "MSAA grouping policy reused a native source or disk cache key");
+        for (auto* sample : {&native, &grouped}) {
+            const auto handle = PrepareShader(sample->request);
+            require(handle != nullptr && handle->artifact != nullptr, "MSAA cold preparation produced no artifact");
+            require(!MatchesPreparedShader(sample == &native ? grouped.request : native.request, *handle), "MSAA prepared artifact matched the other grouping policy");
+            const auto key = sample->Key();
+            const auto encoded = ShaderDiskCache::EncodeEntry(key, *handle->artifact);
+            CompiledVariant decoded;
+            require(ShaderDiskCache::DecodeEntry(encoded, key, decoded) == ShaderDiskCache::LoadStatus::Loaded, "MSAA prepared artifact did not decode");
+            requireSameVariant(*handle->artifact, decoded, "MSAA prepared cache round trip");
+            verifyMsaaMaterialization(*sample, decoded);
+        }
+    }
+    ShaderDiskCache::Flush();
+    const auto after = ShaderDiskCache::Totals();
+    require(after.misses == before.misses + 4u && after.writes == before.writes + 4u, "MSAA cold preparation did not persist each grouping/dimension artifact once");
+    const std::string command = "\"" + std::string(self) + "\" --load-grouped-msaa";
+    require(std::system(command.c_str()) == 0, "MSAA loading process failed");
