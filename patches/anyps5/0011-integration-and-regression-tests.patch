+inline void ResolveRelativePtr(void* field) {
+    // Pointer fields in guest headers can be only dword-aligned. Copy the
+    // representation rather than binding an aligned host pointer reference.
+    std::uintptr_t relative = 0;
+    std::memcpy(&relative, field, sizeof(relative));
+    if (relative == 0) return;
+    const auto resolved = relative + reinterpret_cast<std::uintptr_t>(field);
+    std::memcpy(field, &resolved, sizeof(resolved));
 }
 
