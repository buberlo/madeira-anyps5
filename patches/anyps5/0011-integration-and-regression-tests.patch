+int runMsaaLoadingProcess() {
+    for (const auto grouped : {0u, 4u}) {
+        for (const bool arrayed : {false, true}) {
+            MsaaRequest sample(grouped, arrayed);
+            const auto handle = PrepareShader(sample.request);
+            require(handle != nullptr && handle->artifact != nullptr, "MSAA cache did not prepare a loaded artifact");
+            verifyMsaaMaterialization(sample, *handle->artifact);
