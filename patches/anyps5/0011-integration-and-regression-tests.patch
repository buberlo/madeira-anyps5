+        std::memcpy(static_cast<std::byte*>(memory) + offset, source.data(), size);
+    });
+    Require(stored != 0 && (!bulk || leased), "a bulk store has no stable destination mapping lease");
+    for (std::size_t i = 0; i < length; ++i) {
+        const auto expected = i >= offset && i < offset + size ? source[i - offset] : std::byte{0x5a};
+        Require(static_cast<std::byte*>(memory)[i] == expected && static_cast<std::byte*>(alias)[i] == expected, "shared bulk store bytes or guards changed");
+    }
+    Require(!UnchangedSince(base + offset, size, generation), "the full driver store is not stamped");
+    Require(UnchangedSinceCollected(base + offset, size, generation), "the driver's bulk copy counts as a CPU store");
+    Require(StoredOver(base + offset, size, generation), "the driver's exact byte range is not stored over");
+    Require(!StoredOver(base + offset - 1, 1, generation) && !StoredOver(base + offset + size, 1, generation), "untouched bytes in the same tracker block count as stored over");
+    Require(collectAlias() == 16, "all four shared pages are not dirty in the second alias");
+    Require(collectAlias() == 0, "the alias collect did not reset dirty pages");
+
+    // A guest CPU write preceding an own store must keep its CPU stamp.
+    const auto beforeCpu = CollectWritesUncached(base, length);
+    static_cast<volatile std::uint8_t*>(memory)[offset + 1] ^= 1;
+    StoreOwnBytes(base + offset, size, [&] { std::memcpy(static_cast<std::byte*>(memory) + offset, source.data(), size); });
+    Require(!UnchangedSinceCollected(base + offset, size, beforeCpu), "a CPU store before the bulk store was hidden");
+    collectAlias();
+    const auto beforeNoop = CollectWritesUncached(base, length);
+    std::vector<std::byte> original(static_cast<std::byte*>(memory), static_cast<std::byte*>(memory) + length);
+    WriteChanged(base, original, original);
+    Require(UnchangedSince(base, length, beforeNoop) && collectAlias() == 0, "a no-op WriteChanged dirtied shared pages");
+
+    bool threw = false;
+    try {
+        StoreOwnBytes(base + offset, size, [&] {
+            std::memcpy(static_cast<std::byte*>(memory) + offset, source.data(), 8);
+            throw std::runtime_error("expected partial own-store failure");
+        });
+    } catch (const std::runtime_error&) { threw = true; }
+    Require(threw, "the own-store callback failure was swallowed");
+    const auto afterFailure = CollectWritesUncached(base, length);
+    static_cast<volatile std::uint8_t*>(memory)[offset + 9] ^= 1;
+    Require(!UnchangedSinceCollected(base + offset, size, afterFailure), "write tracking was not rearmed after callback unwinding");
+    {
+        const auto leases = GuestAllocations::GuestAllocationsAcquire_nid_postfix();
+        for (const auto& range : leases) if (range->address == base) Require(range.use_count() == 2, "the failed bulk write leaked its mapping lease");
+    }
+    std::cout << "shared full own-store bytes, guards, alias/CPU/driver classifications and callback cleanup passed; bulk=" << bulk << '\n';
+#endif
+}
+
+// Simulate the GPU's pre-draw seed and changed-byte result on real tracked,
+// shared Windows guest pages. This validates the commit policy, not GPU pixels.
+void CheckGpuSampleChangedWriteback() {
+#ifdef _WIN32
+    constexpr std::size_t length = 2 * Block;
+    void* memory = GuestArena::GuestArenaAllocate_nid_postfix(2 * length, Block);
+    void* alias = static_cast<std::byte*>(memory) + length;
+    HANDLE section = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_EXECUTE_READWRITE, 0, length, nullptr);
+    Require(section != nullptr, "cannot create the GPU writeback section");
+    GuestArena::GuestArenaMap_nid_postfix(memory, length, section, 0, PAGE_READWRITE);
+    GuestArena::GuestArenaMap_nid_postfix(alias, length, section, 0, PAGE_READWRITE);
+    CloseHandle(section);
+    {
+        GuestAllocations::Mutation mutation;
+        mutation.Add(memory, length, true, true, true);
+        mutation.Add(alias, length, true, true, true);
+    }
+    struct Release {
+        void* memory; void* alias;
+        ~Release() {
+            { GuestAllocations::Mutation mutation; mutation.Remove(memory); mutation.Remove(alias); }
+            GuestArena::GuestArenaReset_nid_postfix(memory, 2 * length);
+            GuestArena::GuestArenaRelease_nid_postfix(memory, 2 * length);
+        }
+    } release{memory, alias};
+    const auto base = reinterpret_cast<std::uint64_t>(memory);
+    const auto peer = reinterpret_cast<std::uint64_t>(alias);
+    const auto collectPeer = [&] {
+        std::array<void*, 128> pages{}; std::size_t count = pages.size();
+        Require(GuestArena::GuestArenaCollectWrites_nid_postfix(peer, length, pages.data(), &count, true),
+            "cannot collect GPU writeback alias");
+        return count;
+    };
+    std::memset(memory, 0x5a, length);
+    CollectWritesUncached(base, length); collectPeer();
+    const auto beforeCpu = CollectWritesUncached(base, length);
+    std::vector<std::byte> original(static_cast<std::byte*>(memory), static_cast<std::byte*>(memory) + length);
+    auto gpuResult = original;
+    for (std::size_t at = 3; at < 7; ++at) gpuResult[at] = std::byte{0xa7};
+    // Writes during the GPU wait: one padding byte and one unchanged logical
+    // byte in the very same 256-byte comparison block as the GPU result.
+    static_cast<volatile std::uint8_t*>(alias)[Block + 123] = 0x77;
+    static_cast<volatile std::uint8_t*>(alias)[100] = 0x66;
+    const auto beforeCommit = CollectWritesUncached(base, length);
+    collectPeer();
+    WriteChanged(base, gpuResult, original);
+    for (std::size_t at = 0; at < length; ++at) {
+        const auto expected = at >= 3 && at < 7 ? std::byte{0xa7} :
+            at == 100 ? std::byte{0x66} : at == Block + 123 ? std::byte{0x77} : std::byte{0x5a};
+        Require(static_cast<std::byte*>(memory)[at] == expected && static_cast<std::byte*>(alias)[at] == expected,
+            "GPU changed writeback overwrote padding, an unchanged alias byte, or guards");
+    }
+    Require(!UnchangedSince(base + 3, 4, beforeCommit) && StoredOver(base + 3, 4, beforeCommit),
+        "GPU changed bytes did not invalidate tracked readers");
+    Require(!StoredOver(base + 7, 1, beforeCommit) && !StoredOver(base + Block, Block, beforeCommit),
+        "GPU writeback classified untouched bytes as a driver store");
+    Require(UnchangedSinceCollected(base + 3, 4, beforeCommit), "GPU changed writeback became a CPU store");
+    Require(!UnchangedSinceCollected(base + Block, Block, beforeCpu), "GPU writeback hid the foreign alias CPU store");
+    Require(collectPeer() != 0 && collectPeer() == 0, "GPU changed writeback alias invalidation did not reset");
+    const auto beforeNoop = CollectWritesUncached(base, length);
+    WriteChanged(base, gpuResult, gpuResult);
+    Require(UnchangedSince(base, length, beforeNoop) && collectPeer() == 0, "unchanged GPU result dirtied tracked pages");
+    std::cout << "GPU seeded changed-byte commit preserves shared padding/CPU alias bytes and driver generations passed\n";
+#endif
+}
