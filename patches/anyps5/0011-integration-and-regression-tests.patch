+        const auto state = AgcDriver::Graphics::DecodeState(queue, false, grouped);
+        Require(state.stencilTest && !state.depthTest && !state.depthWrite && !state.depthBoundsTest,
+                "equivalent stencil clear changed depth/stencil enables");
+        for (const auto& face : {state.stencilFront, state.stencilBack}) {
+            Require(face.compareOp == VK_COMPARE_OP_ALWAYS && face.writeMask == 0xff &&
+                    face.reference == state.depth->clearStencil &&
