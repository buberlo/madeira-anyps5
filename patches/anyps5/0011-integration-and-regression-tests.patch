+    }
+    const auto totals = ShaderDiskCache::Totals();
+    require(totals.hits == 4u && totals.misses == 0u && totals.loadFailures == 0u, "MSAA fresh process rebuilt an artifact or rejected a persisted mode table");
+    std::cout << "MSAA fresh process loaded all four grouping/dimension artifacts\n";
+    return 0;
