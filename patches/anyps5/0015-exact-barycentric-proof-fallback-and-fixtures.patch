+#pragma once
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+
+namespace ShaderRecompiler {
+
+// Failure of the original-instruction proof rejects fixed-function lowering,
+// not the exact translation used for barycentric emulation.
+class FixedFunctionInterpolationRejected final : public std::runtime_error {
+public:
+    explicit FixedFunctionInterpolationRejected(std::uint32_t pc)
+        : std::runtime_error("fixed-function interpolation requires unmodified center I/J pairs and complete P1/P2 sequences on a proven entry/discard path (pc=" + std::to_string(pc) + ")") {}
+};
+
+}
