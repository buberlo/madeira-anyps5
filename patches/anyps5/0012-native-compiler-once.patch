+    if (depth) { ThrowThroughOnce(depth - 1); return; }
+    std::once_flag flag;
+    std::call_once(flag, [] { throw std::runtime_error("through runtime frames"); });
+}
+
+static void testUnwindThroughRuntimeModules() {
+    for (int depth : {0, 1, 7, 64}) {
