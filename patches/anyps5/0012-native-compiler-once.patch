diff --git a/core/libs/prx/libc/CMakeLists.txt b/core/libs/prx/libc/CMakeLists.txt
index 3f303ca..e6f9266 100644
--- a/core/libs/prx/libc/CMakeLists.txt
+++ b/core/libs/prx/libc/CMakeLists.txt
@@ -1,3 +1,21 @@
+# Own the native compiler-once boundary only for the pinned Windows GNU ABI.
+set(APS5_NATIVE_COMPILER_ONCE_ENABLED FALSE)
+if(MINGW AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU" AND CMAKE_SIZEOF_VOID_P EQUAL 8)
+    set(APS5_NATIVE_COMPILER_ONCE_ENABLED TRUE)
+    set(compilerOnceDir "${CMAKE_CURRENT_SOURCE_DIR}/src/specifics/windows")
+    target_sources(libc PRIVATE "${compilerOnceDir}/provider.cpp"
+        "${compilerOnceDir}/caller_bridge.cpp" "${compilerOnceDir}/compiler_once_exports.def")
+    target_compile_definitions(libc PRIVATE APS5_ONCE_PROVIDER_LOCAL=1)
+    target_link_libraries(libc PRIVATE synchronization)
+    target_link_options(libc PRIVATE "LINKER:--exclude-all-symbols")
+    # Final libc-linked images receive one bridge; dependent static archives do
+    # not receive a second definition of the direct function or its IAT slot.
+    target_sources(libc INTERFACE
+        "$<$<OR:$<STREQUAL:$<TARGET_PROPERTY:TYPE>,EXECUTABLE>,$<STREQUAL:$<TARGET_PROPERTY:TYPE>,SHARED_LIBRARY>,$<STREQUAL:$<TARGET_PROPERTY:TYPE>,MODULE_LIBRARY>>:$<BUILD_INTERFACE:${compilerOnceDir}/caller_bridge.cpp>>")
+    target_link_options(libc INTERFACE
+        "LINKER:--exclude-symbols,pthread_once:__imp_pthread_once:APS5CompilerOnceBridge:APS5CompilerOnceResolvedTarget")
+endif()
+
 target_sources(libc PRIVATE
         ${CMAKE_CURRENT_SOURCE_DIR}/Export.cpp
         ${CMAKE_CURRENT_SOURCE_DIR}/src/General.cpp
@@ -610,3 +628,22 @@ if(MINGW)
             PASS_REGULAR_EXPRESSION "aborting[^~]*SIGABRT. on thread[^~]*stack return address candidates:[^~]*rsp[+]0x")
     endif()
 endif()
+
+if(APS5_NATIVE_COMPILER_ONCE_ENABLED AND BUILD_TESTING)
+    add_library(compiler_once_cross SHARED ${LIBS_INCLUDE_DIR}/tests/CompilerOnceCross.cpp)
+    set_target_properties(compiler_once_cross PROPERTIES PREFIX ""
+        RUNTIME_OUTPUT_DIRECTORY "$<1:${ANYPS5_TEST_OUTPUT_DIRECTORY}>")
+    target_link_libraries(compiler_once_cross PRIVATE libc)
+    configure_windows_unwind(compiler_once_cross)
+    add_test_executable(compiler_once_tests ${LIBS_INCLUDE_DIR}/tests/CompilerOnce.cpp)
+    target_include_directories(compiler_once_tests PRIVATE "${compilerOnceDir}")
+    target_link_libraries(compiler_once_tests PRIVATE libc)
+    configure_windows_unwind(compiler_once_tests)
+    add_dependencies(compiler_once_tests compiler_once_cross)
+    add_test(NAME windows_compiler_once COMMAND compiler_once_tests
+        $<TARGET_FILE:libc> $<TARGET_FILE:compiler_once_cross>)
+    set_tests_properties(windows_compiler_once PROPERTIES TIMEOUT 60
+        ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:$<TARGET_FILE_DIR:libc>")
+    # Preserve the original complete exception fixture and its source.
+    set_tests_properties(windows_exceptions PROPERTIES TIMEOUT 60)
+endif()
diff --git a/rebase/0012-native-compiler-once/after/core/libs/prx/libc/src/specifics/windows/caller_bridge.cpp b/core/libs/prx/libc/src/specifics/windows/caller_bridge.cpp
new file mode 100644
index 0000000..b198657
--- /dev/null
+++ b/core/libs/prx/libc/src/specifics/windows/caller_bridge.cpp
@@ -0,0 +1,27 @@
+// Link this object only into newly qualified owned MinGW callers. It supplies
+// both the direct C ABI and exact dllimport variable requested by owned callers. No macro
+// or guest pthread_once export is changed, and native DLL IATs are untouched.
+using OnceFunction = int (*)(long*, void (*)());
+#ifdef APS5_ONCE_PROVIDER_LOCAL
+extern "C" int APS5NativeCompilerOnce_nid_no_patch(long*, void (*)());
+#else
+extern "C" __declspec(dllimport)
+int APS5NativeCompilerOnce_nid_no_patch(long*, void (*)());
+extern "C" OnceFunction __imp_APS5NativeCompilerOnce_nid_no_patch;
+#endif
+extern "C" int APS5CompilerOnceBridge(long* flag, void (*initialize)()) {
+    return APS5NativeCompilerOnce_nid_no_patch(flag, initialize);
+}
+extern "C" int pthread_once(long* flag, void (*initialize)()) {
+    return APS5CompilerOnceBridge(flag, initialize);
+}
+extern "C" {
+OnceFunction __imp_pthread_once = &pthread_once;
+}
+extern "C" OnceFunction APS5CompilerOnceResolvedTarget() noexcept {
+#ifdef APS5_ONCE_PROVIDER_LOCAL
+    return &APS5NativeCompilerOnce_nid_no_patch;
+#else
+    return __imp_APS5NativeCompilerOnce_nid_no_patch;
+#endif
+}
diff --git a/rebase/0012-native-compiler-once/after/core/libs/prx/libc/src/specifics/windows/compiler_once.hpp b/core/libs/prx/libc/src/specifics/windows/compiler_once.hpp
new file mode 100644
index 0000000..ff32dd3
--- /dev/null
+++ b/core/libs/prx/libc/src/specifics/windows/compiler_once.hpp
@@ -0,0 +1,41 @@
+#pragma once
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <type_traits>
+
+namespace aps5::compiler_once {
+// Native MinGW pthread_once_t is Windows long (four bytes), not GuestOnce.
+// 0 is PTHREAD_ONCE_INIT, 1 is the native completed value; 2 is ours alone.
+template<class Word, class Waiter, class Callback>
+int invoke(Word* storage, Callback&& callback, Waiter& waiter) {
+    static_assert(sizeof(Word) == 4 && std::is_integral_v<Word>);
+    static_assert(std::atomic_ref<Word>::is_always_lock_free);
+    static_assert(noexcept(waiter.wake(storage)));
+    if (!storage || reinterpret_cast<std::uintptr_t>(storage) %
+                        std::atomic_ref<Word>::required_alignment) return EINVAL;
+    std::atomic_ref<Word> state(*storage);
+    for (;;) {
+        Word observed = state.load(std::memory_order_acquire);
+        if (observed == 1) return 0;
+        if (observed == 0) {
+            if (!state.compare_exchange_weak(observed, Word{2},
+                    std::memory_order_acquire, std::memory_order_acquire)) continue;
+            // The callback runs without a registry, global mutex or TLS node.
+            try { callback(); }
+            catch (...) {
+                state.store(0, std::memory_order_release);
+                waiter.wake(storage);
+                throw;
+            }
+            state.store(1, std::memory_order_release);
+            waiter.wake(storage);
+            return 0;
+        }
+        if (observed != 2) return EINVAL;
+        // WaitOnAddress compares again before sleeping; an early wake needs
+        // another acquire load. Failure never clears a different owner's flag.
+        if (!waiter.wait(storage, Word{2})) return EAGAIN;
+    }
+}
+}
