+int ModuleLifecycle_nid_no_patch(void* handle, bool stop, std::size_t args, const void* argp, int* result) {
+    if (!result) return SCE_KERNEL_ERROR_EFAULT;
+    std::shared_ptr<Module> module;
+    {
+        std::lock_guard lock(modulesMutex);
+        const auto found = modules.find(reinterpret_cast<std::uintptr_t>(handle));
