diff --git a/core/relinker/elfpatcher/tests/GuestLifecycleHost.cpp b/core/relinker/elfpatcher/tests/GuestLifecycleHost.cpp
new file mode 100644
index 0000000..4dfeb31
--- /dev/null
+++ b/core/relinker/elfpatcher/tests/GuestLifecycleHost.cpp
@@ -0,0 +1,47 @@
+#include "prx/libc/include/general/VabiMacros.hpp"
+#include <cstdio>
+#include <cstdlib>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+
+namespace {
+
+[[noreturn]] void Fail(const char* message) noexcept {
+    std::fprintf(stderr, "Guest init/fini host fixture: %s\n", message);
+    std::fflush(stderr);
+    std::_Exit(EXIT_FAILURE);
+}
+
+}
+
+extern "C" void APS5_VABI Record(int event) {
+    const auto path = std::getenv("ANYPS5_LIFECYCLE_EVENTS");
+    if (!path) Fail("Missing ANYPS5_LIFECYCLE_EVENTS");
+    auto* file = std::fopen(path, "ab");
+    if (!file) Fail("Cannot open lifecycle event file");
+    const auto result = std::fputc(event, file);
+    const auto closed = std::fclose(file);
+    if (result == EOF || closed != 0) Fail("Cannot write lifecycle event");
+}
+
+extern "C" void APS5_VABI CheckAllocation(void* allocation, std::size_t bytes) {
+    if (bytes != 48) Fail("Dependent constructor requested an unexpected allocation size");
+    if (allocation == nullptr) Fail("Guest allocator was called before retained libc initialization");
+    std::memset(allocation, 0x5a, bytes);
+    Record('C');
+}
+
+extern "C" void APS5_VABI CheckInitializedData(const std::uint32_t* state) {
+    if (state == nullptr || *state != 42) Fail("Exported guest data was used before its initializer");
+    Record('D');
+}
+
+namespace {
+
+struct Runtime {
+    Runtime() { Record('H'); }
+    ~Runtime() { Record('h'); }
+} runtime;
+
+}
diff --git a/core/relinker/elfpatcher/tests/WindowsGuestLifecycleTests.cpp b/core/relinker/elfpatcher/tests/WindowsGuestLifecycleTests.cpp
new file mode 100644
index 0000000..57c159d
--- /dev/null
+++ b/core/relinker/elfpatcher/tests/WindowsGuestLifecycleTests.cpp
@@ -0,0 +1,84 @@
+#include <windows.h>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+using Lifecycle = std::uint64_t (__attribute__((sysv_abi)) *)(std::size_t, const void*);
+using Callback = int (__attribute__((sysv_abi)) *)();
+static HANDLE entered, released;
+static bool blocking;
+static void Require(bool value, const char* message) {
+    if (!value) { std::fprintf(stderr, "Guest lifecycle wrapper: %s\n", message); std::exit(1); }
+}
+static int __attribute__((sysv_abi)) CallbackBody() {
+    if (blocking) {
+        SetEvent(entered);
+        Require(WaitForSingleObject(released, 5000) == WAIT_OBJECT_0, "callback release timed out");
+    }
+    return 0;
+}
+struct Payload { std::uint32_t size = 16, version = 0x200; Callback callback = CallbackBody; };
+static_assert(sizeof(Payload) == 16);
+struct Counters { std::uint32_t init, initArray, finiArray, fini; std::uint64_t args, pointer; };
+constexpr std::size_t Args = (std::size_t{1} << 32) + 52;
+constexpr std::uint64_t Busy = std::uint64_t{0x80020010u} << 32;
+constexpr std::uint64_t Invalid = std::uint64_t{0x80020016u} << 32;
+struct Task { Lifecycle function; Payload* payload; std::uint64_t result = 1; };
+static DWORD WINAPI Invoke(LPVOID value) {
+    auto& task = *static_cast<Task*>(value);
+    task.result = task.function(Args, task.payload);
+    return 0;
+}
+int main(int argc, char** argv) {
+    Require(argc == 3, "expected DLL path and scenario");
+    const auto module = LoadLibraryA(argv[1]);
+    Require(module != nullptr, "failed to map synthetic converted DLL");
+    const auto start = reinterpret_cast<Lifecycle>(GetProcAddress(module, "__anyps5_guest_start_v1"));
+    const auto stop = reinterpret_cast<Lifecycle>(GetProcAddress(module, "__anyps5_guest_stop_v1"));
+    Require(start && stop, "reserved versioned exports missing");
+    auto& c = *reinterpret_cast<Counters*>(reinterpret_cast<std::uint8_t*>(module) + 0x12860);
+    Require(c.init == 0 && c.initArray == 0 && c.finiArray == 0 && c.fini == 0, "mapping eagerly ran deferred lifecycle");
+    Require(stop(0, nullptr) == 0 && c.fini == 0, "unstarted stop ran callbacks");
+    Payload payload;
+    if (std::strcmp(argv[2], "failed-start") == 0 || std::strcmp(argv[2], "guest-error-busy") == 0) {
+        const std::uint64_t error = std::strcmp(argv[2], "guest-error-busy") == 0 ? 0x80020010u : 0x81234567u;
+        Require(start(Args, &payload) == error && start(0, nullptr) == error, "failed start result was lost or retried");
+        Require(c.init == 1 && c.initArray == 0, "failed start repeated or ran init arrays");
+        Require(stop(0, nullptr) == 0 && c.fini == 0 && c.finiArray == 0, "failed start was finalized as successful");
+    } else {
+        const bool concurrent = std::strcmp(argv[2], "concurrent") == 0;
+        if (concurrent) {
+            entered = CreateEventA(nullptr, TRUE, FALSE, nullptr);
+            released = CreateEventA(nullptr, TRUE, FALSE, nullptr);
+            Require(entered && released, "event creation failed");
+            blocking = true;
+            Task task{start, &payload};
+            const auto thread = CreateThread(nullptr, 0, Invoke, &task, 0, nullptr);
+            Require(thread && WaitForSingleObject(entered, 5000) == WAIT_OBJECT_0, "start callback did not begin");
+            Require(start(0, nullptr) == Busy && stop(0, nullptr) == Busy, "active start did not refuse reentry");
+            SetEvent(released);
+            Require(WaitForSingleObject(thread, 5000) == WAIT_OBJECT_0 && task.result == 0, "start worker failed");
+            CloseHandle(thread);
+        } else Require(start(Args, &payload) == 0, "valid start failed");
+        Require(c.init == 1 && c.initArray == 1 && c.args == Args && c.pointer == reinterpret_cast<std::uintptr_t>(&payload), "64-bit arguments/payload or initializer order lost");
+        Require(start(0, nullptr) == 0 && c.init == 1, "successful start was repeated");
+        if (concurrent) {
+            ResetEvent(entered); ResetEvent(released);
+            Task task{stop, &payload};
+            const auto thread = CreateThread(nullptr, 0, Invoke, &task, 0, nullptr);
+            Require(thread && WaitForSingleObject(entered, 5000) == WAIT_OBJECT_0, "stop callback did not begin");
+            Require(start(0, nullptr) == Busy && stop(0, nullptr) == Busy, "active stop did not refuse reentry");
+            SetEvent(released);
+            Require(WaitForSingleObject(thread, 5000) == WAIT_OBJECT_0 && task.result == 0, "stop worker failed");
+            CloseHandle(thread); CloseHandle(entered); CloseHandle(released);
+        } else {
+            const std::uint64_t expected = std::strcmp(argv[2], "failed-stop") == 0 ? 0x82345678u : 0;
+            Require(stop(Args, &payload) == expected && stop(0, nullptr) == expected, "stop result lost or callbacks retried");
+        }
+        Require(c.fini == 1 && c.finiArray == 1, "finalizers did not run exactly once");
+        Require(start(Args, &payload) == Invalid, "terminal stop allowed restart");
+    }
+    Require(FreeLibrary(module), "synthetic DLL did not unload");
+    std::puts("Guest lifecycle wrapper contract passed");
+}
