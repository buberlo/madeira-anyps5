+    observation.reentryPath = nullptr;
+    observation.startResult = 17;
+    module = sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result);
+    Require(module > 0 && result == 17 && observation.starts == 2);
+    observation.stopResult = 23;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == 23);
+    Require(result == 23 && dlsym_nid_postfix(Handle(module), "__anyps5_guest_start_v1") != nullptr);
+    observation.stopResult = -91;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == -91);
+    Require(result == -91 && dlsym_nid_postfix(Handle(module), "__anyps5_guest_start_v1") != nullptr);
+    // The synthetic fixture has no once guard; the relinker suite tests the real generated guards.
+    Require(dlclose_nid_postfix(Handle(module)) == 0);
+    observation.startResult = -31;
+    observation.stopResult = 0;
+    module = sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result);
+    Require(module > 0 && result == -31);
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, nullptr) == 0);
+
+    // A module's negative SCE value is never heuristically classified as a guard status.
+    observation.startResult = SCE_KERNEL_ERROR_EBUSY;
+    module = sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result);
+    Require(module > 0 && result == SCE_KERNEL_ERROR_EBUSY);
+    observation.stopResult = SCE_KERNEL_ERROR_EBUSY;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == SCE_KERNEL_ERROR_EBUSY);
+    Require(result == SCE_KERNEL_ERROR_EBUSY && dlsym_nid_postfix(Handle(module), "__anyps5_guest_start_v1") != nullptr);
+    observation.stopResult = 0;
+    observation.stopStatus = SCE_KERNEL_ERROR_EBUSY;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == SCE_KERNEL_ERROR_EBUSY);
+    Require(result == 0 && dlsym_nid_postfix(Handle(module), "__anyps5_guest_start_v1") != nullptr);
+    observation.stopStatus = 0;
+    Require(sceKernelStopUnloadModule(module, sizeof(payload), &payload, 0, nullptr, &result) == 0);
+    observation.startResult = 0;
+    static std::atomic<int> busyImageUnloads{0};
+    payload.imageUnloads = &busyImageUnloads;
+    observation.startStatus = SCE_KERNEL_ERROR_EBUSY;
+    Require(sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result) == SCE_KERNEL_ERROR_EBUSY && result == 0);
+#ifdef _WIN32
+    Require(busyImageUnloads == 1); // Failed LoadStart releases its newly loaded reference.
+#endif
+    observation.startStatus = SCE_KERNEL_ERROR_EINVAL;
+    Require(sceKernelLoadStartModule(argv[1], sizeof(payload), &payload, 0, nullptr, &result) == SCE_KERNEL_ERROR_EINVAL && result == 0);
+#ifdef _WIN32
+    Require(busyImageUnloads == 2);
+#endif
+    observation.startStatus = 0;
+    payload.imageUnloads = nullptr;
+
+    // Invalid requests are rejected before any guest callback or image load.
+    const int starts = observation.starts;
+    const int stops = observation.stops;
+    KernelLoadModuleOpt loadOpt{sizeof(loadOpt)};
+    KernelUnloadModuleOpt stopOpt{sizeof(stopOpt)};
