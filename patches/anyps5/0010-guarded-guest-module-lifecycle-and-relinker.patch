+++ b/core/relinker/relinker/tests/test_guest_deferred_lifecycle.py
@@ -0,0 +1,135 @@
+"""Validate explicit deferral and run emitted wrappers on synthetic PE fixtures."""
+import argparse
+from pathlib import Path
+import shlex
+import struct
+import subprocess
+import tempfile
+
+from test_guest_init_fini import consumer, guest, no_import_executable, set_dynamic_value, windows_lifecycle_exports, windows_lifecycle_targets
+from test_guest_intel_trampolines import pe_sections
+
+
+def increment(address, target):
+    return b'\xff\x05' + struct.pack('<i', target - (address + 6))
+
+
+def require_one(address, target):
+    return b'\x83\x3d' + struct.pack('<i', target - (address + 7)) + b'\x01\x74\x02\x0f\x0b'
+
+
+def fixture(mode='normal'):
+    image = guest()
+    # No external imports: only validated internal array relocations remain.
+    set_dynamic_value(image, 8, 48)
+    struct.pack_into('<QQq', image, 0x2700, 0x2800, 8, 0x1030)
+    struct.pack_into('<QQq', image, 0x2718, 0x2808, 8, 0x1050)
+    set_dynamic_value(image, 12, 0x1100)
+    set_dynamic_value(image, 13, 0x1180)
+    for address, target in ((0x1030, 0x2864), (0x1050, 0x2868)):
+        code = require_one(address, 0x2860 if target == 0x2864 else 0x2864)
+        code += increment(address + len(code), target) + b'\xc3'
+        image[address:address + len(code)] = code
+    for address, target, failed in ((0x1100, 0x2860, mode in ('failed-start', 'guest-error-busy')), (0x1180, 0x286c, mode == 'failed-stop')):
+        code = bytearray(require_one(address, 0x2868) if target == 0x286c else b'')
+        code += increment(address + len(code), target)
+        if failed:
+            result = 0x80020010 if mode == 'guest-error-busy' else (0x81234567 if target == 0x2860 else 0x82345678)
+            code += b'\xb8' + struct.pack('<I', result) + b'\xc3'
+        else:
+            if target == 0x2860:
+                code += b'\x48\x89\x3d' + struct.pack('<i', 0x2870 - (address + len(code) + 7))
+                code += b'\x48\x89\x35' + struct.pack('<i', 0x2878 - (address + len(code) + 7))
+            # Same unconditional payload read as the failing Unity module.
+            # A zero-argument eager start faults; a real payload calls its callback.
+            code += b'\x48\x83\xec\x08\xff\x56\x08\x48\x83\xc4\x08\x31\xc0\xc3'
+        image[address:address + len(code)] = code
+    return image
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('relinker', type=Path)
+    parser.add_argument('--windows-runner')
+    parser.add_argument('--fixture-runner', type=Path)
+    parser.add_argument('--work-directory', type=Path)
+    args = parser.parse_args()
+    counts = {'converted': 0, 'rejected': 0, 'executed': 0}
+    context = tempfile.TemporaryDirectory(prefix='anyps5-deferred-lifecycle-')
+    work = args.work_directory or Path(context.name)
+    work.mkdir(parents=True, exist_ok=True)
+
+    def convert(label, options, module=None, extra=None, error=None):
+        case = work / label
+        directory = case / 'sce_module'
+        directory.mkdir(parents=True, exist_ok=True)
+        (directory / 'plugin.prx').write_bytes(module or fixture())
+        if extra:
+            for name, data in extra.items():
+                path = case / name; path.parent.mkdir(parents=True, exist_ok=True); path.write_bytes(data)
+        source = case / 'input.elf'; source.write_bytes(no_import_executable('plugin.prx'))
+        output = case / 'output.exe'
+        run = subprocess.run([str(args.relinker.resolve()), '--skip-syscall-check', *options, str(source), str(output)], capture_output=True, text=True, timeout=30)
+        if error:
+            assert run.returncode != 0 and error in run.stderr, (label, run.stdout, run.stderr)
+            assert not output.exists(), label
+            counts['rejected'] += 1
+            return None
+        assert run.returncode == 0, (label, run.stdout, run.stderr)
+        counts['converted'] += 1
+        artifact = case / 'app0/sce_module/plugin.prx.guest.prx'
+        image = artifact.read_bytes()
+        exports = windows_lifecycle_exports(image)
+        sections = pe_sections(image)
+        state = next(section for section in sections if section[0] == b'.gstate')
+        life = next(section for section in sections if section[0] == b'.glife')
+        pe = struct.unpack_from('<I', image, 0x3c)[0]
+        table = pe + 24 + struct.unpack_from('<H', image, pe + 20)[0]
+        virtual_sizes = {section[0]: struct.unpack_from('<I', image, table + index * 40 + 8)[0]
+                         for index, section in enumerate(sections)}
+        # The upstream writer omits zero raw tails. Host page protection depends
+        # on VirtualSize/RVA, not how many initialized bytes are stored on disk.
+        assert state[1] % 0x4000 == life[1] % 0x4000 == 0 and virtual_sizes[b'.gstate'] == 0x4000
+        assert state[2] == 0 and state[3] == 0, (label, state)
+        assert life[1] >= state[1] + virtual_sizes[b'.gstate']
+        assert virtual_sizes[b'.glife'] % 0x4000 == 0 and 0 < life[2] <= virtual_sizes[b'.glife']
+        assert state[4] & 0xe0000000 == 0xc0000000 and life[4] & 0xe0000000 == 0x60000000
+        assert all(section[1] >= life[1] + virtual_sizes[b'.glife'] for section in sections if section[1] > life[1]), label
+        for section in sections:
+            if section[0] in (b'.gstate', b'.glife'):
+                continue
+            end = section[1] + virtual_sizes[section[0]]
+            assert end <= state[1] or section[1] >= life[1] + virtual_sizes[b'.glife'], (label, section)
+        targets = windows_lifecycle_targets(output.read_bytes())
+        assert '__anyps5_guest_start_v1' in exports and '__anyps5_guest_stop_v1' in exports
+        assert targets.count(exports['__anyps5_guest_start_v1']) == (0 if '--defer-guest-lifecycle' in options else 1), (label, targets)
+        assert targets.count(exports['__anyps5_guest_stop_v1']) == 2, (label, targets)
+        return artifact
+
+    options = ['--windows', '--defer-guest-lifecycle', 'plugin.prx']
+    for mode in ('normal', 'failed-start', 'failed-stop', 'concurrent', 'guest-error-busy'):
+        artifact = convert(mode, options, fixture(mode))
+        if args.windows_runner:
+            assert args.fixture_runner, 'Windows execution requires compiled fixture runner'
+            run = subprocess.run([*shlex.split(args.windows_runner), str(args.fixture_runner.resolve()), 'Z:' + str(artifact.resolve()).replace('/', '\\'), mode], capture_output=True, text=True, timeout=45)
+            assert run.returncode == 0 and 'contract passed' in run.stdout, (mode, run.returncode, run.stdout, run.stderr)
+            counts['executed'] += 1
+    convert('default-eager', ['--windows'])
+    for label, option, error in (
+        ('unknown', ['--windows', '--defer-guest-lifecycle', 'absent.prx'], 'one discovered module'),
+        ('path', ['--windows', '--defer-guest-lifecycle', '../plugin.prx'], 'exact file name'),
+        ('main', ['--windows', '--defer-guest-lifecycle', 'input.elf'], 'Invalid deferred guest'),
+        ('duplicate', options + ['--defer-guest-lifecycle', 'plugin.prx'], 'Duplicate deferred'),
+        ('non-windows', ['--defer-guest-lifecycle', 'plugin.prx'], 'requires --windows'),
+        ('skipped', options + ['--skip-sce-module'], 'guest module processing'),
+        ('excluded', options + ['--exclude-sce-module', 'plugin.prx'], 'excluded and deferred')):
+        convert(label, option, error=error)
+    convert('ambiguous', options, extra={'Media/Plugins/plugin.prx': fixture()}, error='one discovered module')
+    # An eager constructor provider cannot be left depending on an unstarted
+    # deferred module, even when it was found only through discovery.
+    convert('eager-dependent', options, extra={'sce_module/consumer.prx': consumer('plugin.prx')}, error='Eager guest lifecycle depends on deferred')
+    print(counts)
+
+
+if __name__ == '__main__':
+    main()
