+#include "GuestKernelModuleLifecycleFixture.hpp"
+#ifdef _WIN32
+#define MODULE_EXPORT __declspec(dllexport)
+#else
+#define MODULE_EXPORT __attribute__((visibility("default")))
+#endif
+#ifdef KERNEL_MODULE_FIXTURE_NATIVE
+extern "C" int GuestLifecycleDependencyMarker();
+// Force a dependency that owns wrappers: dlsym must not mistake them for ours.
+extern "C" MODULE_EXPORT int GuestLifecycleNativeMarker() { return GuestLifecycleDependencyMarker(); }
+#else
+extern "C" MODULE_EXPORT int GuestLifecycleDependencyMarker() { return 42; }
+struct UnloadNotice {
+    std::atomic<int>* count = nullptr;
+    ~UnloadNotice() { if (count) ++*count; }
+};
+static UnloadNotice unloadNotice;
+#ifdef KERNEL_MODULE_FIXTURE_DEFERRED
+// Presence of this upstream compatibility table makes dlopen perform the
+// early guarded start; the explicit LoadStart call must not invoke it twice.
+extern "C" MODULE_EXPORT const std::uint32_t __aps5_guest_initialize[] = {0, 0};
+static bool started = false;
+static std::uint64_t startResult = 0;
+#endif
+static std::uint64_t Invoke(bool stop, std::size_t args, const void* argp) {
+    if (!args && !argp) return 0;
+    if (args < sizeof(KernelModuleLifecyclePayload) || !argp) return static_cast<std::uint32_t>(-77);
+    const auto& payload = *static_cast<const KernelModuleLifecyclePayload*>(argp);
+    if (!stop) unloadNotice.count = payload.imageUnloads;
+    return payload.callback ? payload.callback(payload.context, stop, args, argp) : static_cast<std::uint32_t>(-78);
+}
+extern "C" MODULE_EXPORT std::uint64_t APS5_VABI __anyps5_guest_start_v1(std::size_t args, const void* argp) {
+#ifdef KERNEL_MODULE_FIXTURE_DEFERRED
+    if (started) return startResult;
+    startResult = Invoke(false, args, argp);
+    started = true;
+    return startResult;
+#else
+    return Invoke(false, args, argp);
+#endif
+}
+#ifndef KERNEL_MODULE_FIXTURE_INCOMPLETE
+extern "C" MODULE_EXPORT std::uint64_t APS5_VABI __anyps5_guest_stop_v1(std::size_t args, const void* argp) {
+    return Invoke(true, args, argp);
+}
+#endif
+#endif
