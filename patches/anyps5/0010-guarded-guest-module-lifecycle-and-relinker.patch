+                execute(case, windows, output, converted.parent / 'consumer.prx.guest.prx',
+                        'HIAaih')
+
+            for label, symbol_name, info, visibility, section, value in (
+                    ('no-export', 0, 0, 0, 0, 0),
+                    ('local', 1, 0x02, 0, 1, 0x1000),
+                    ('internal', 1, 0x12, 1, 1, 0x1000),
+                    ('hidden', 1, 0x12, 2, 1, 0x1000),
+                    ('undefined', 1, 0x12, 0, 0, 0),
+                    ('absolute', 1, 0x12, 0, 0xfff1, 0x1000),
+                    ('global-function', 1, 0x12, 0, 1, 0x1000),
+                    ('weak-function', 1, 0x22, 0, 1, 0x1000),
+                    ('protected-function', 1, 0x12, 3, 1, 0x1000),
+                    ('data-only', 1, 0x11, 0, 1, 0x2840),
+                    ('notype-code', 1, 0x10, 0, 1, 0x1000),
+                    ('notype-data', 1, 0x10, 0, 1, 0x2840),
+                    ('ifunc', 1, 0x1a, 0, 1, 0x1000)):
+                original = guest()
+                struct.pack_into('<IBBHQQ', original, 0x2418, symbol_name, info, visibility, section, value, 6)
+                case = work / f'{windows}-exports-{label}'
