@@ -0,0 +1,396 @@
+"""All guest modules retain init/fini, independently of host library names or exports."""
+from pathlib import Path
+import argparse
+import contextlib
+import os
+import re
+import shlex
+import shutil
+import struct
+import subprocess
+import sys
+import tempfile
+
+from test_guest_intel_trampolines import elf_loads, pe_sections
+from test_guest_module_directories import needed_libraries
+from test_guest_symbol_names import module_symbols
+from test_windows_import_modules import executable
+
+
+def guest(identity=None, module_name=None, missing_import=False, module_info_tag=0x6100000d,
+          import_name='Record'):
+    image = bytearray(0x3000)
+    image[:16] = b'\x7fELF\x02\x01\x01' + bytes(9)
+    struct.pack_into('<HHIQQQIHHHHHH', image, 16,
+                     3, 62, 1, 0, 64, 0, 0, 64, 56, 3, 0, 0, 0)
+    struct.pack_into('<IIQQQQQQ', image, 64, 1, 7, 0, 0, 0, len(image), len(image), 0x1000)
+    struct.pack_into('<IIQQQQQQ', image, 176, 0x6474e551, 6, 0, 0, 0, 0, 0, 16)
+    strings = b'\0shared#A#B\0' + (b'absent' if missing_import else import_name.encode()) + b'\0'
+    dependency = len(strings)
+    strings += b'lifecycle_host.prx\0'
+    tags = [(5, 0x2600), (10, 0), (6, 0x2400), (11, 24), (4, 0x2500),
+            (7, 0x2700), (8, 72), (9, 24), (1, dependency),
+            (12, 0x1010), (25, 0x2800), (27, 8),
+            (26, 0x2808), (28, 8), (13, 0x1070)]
+    module_names = module_name if isinstance(module_name, tuple) else (module_name,)
+    for index, (name, tag) in enumerate([(identity, 14)] + [(name, module_info_tag) for name in module_names]):
+        if name:
+            tags.append((tag, len(strings) | (((0x101 << 32) | (index << 48)) if tag in (0x6100000d, 0x61000043) else 0)))
+            strings += name.encode() + b'\0'
+    tags[1] = (10, len(strings))
+    tags.append((0, 0))
+    struct.pack_into('<IIQQQQQQ', image, 120, 2, 6, 0x2000, 0x2000, 0x2000,
+                     len(tags) * 16, len(tags) * 16, 8)
+    for index, tag in enumerate(tags):
+        struct.pack_into('<qQ', image, 0x2000 + index * 16, *tag)
+    image[0x2600:0x2600 + len(strings)] = strings
+    struct.pack_into('<IBBHQQ', image, 0x2418, 1, 0x12, 0, 1, 0x1000, 6)
+    struct.pack_into('<IBBHQQ', image, 0x2430, 12, 0x12, 0, 0, 0, 0)
+    struct.pack_into('<II', image, 0x2500, 1, 3)
+    struct.pack_into('<QQq', image, 0x2700, 0x2820, (2 << 32) | 6, 0)
+    struct.pack_into('<QQq', image, 0x2718, 0x2800, 8, 0x1030)
+    struct.pack_into('<QQq', image, 0x2730, 0x2808, 8, 0x1050)
+    image[0x1000:0x1006] = b'\xb8\x2a\0\0\0\xc3'
+    for address, event in ((0x1010, 'I'), (0x1030, 'A'), (0x1050, 'a'), (0x1070, 'i')):
+        code = b'\xbf' + struct.pack('<I', ord(event)) + b'\x48\x83\xec\x08\xff\x15'
+        code += struct.pack('<i', 0x2820 - (address + 15)) + b'\x48\x83\xc4\x08\xc3'
+        image[address:address + len(code)] = code
+    return image
+
+
+def lifecycle_tags(image):
+    phoff, = struct.unpack_from('<Q', image, 32)
+    phsize, count = struct.unpack_from('<HH', image, 54)
+    headers = [struct.unpack_from('<IIQQQQQQ', image, phoff + index * phsize) for index in range(count)]
+    dynamic = next(header for header in headers if header[0] == 2)
+    return {tag for position in range(dynamic[2], dynamic[2] + dynamic[5], 16)
+            for tag, value in [struct.unpack_from('<qQ', image, position)] if tag in (12, 13, 25, 26, 27, 28)}
+
+
+def consumer(owner):
+    image = guest()
+    struct.pack_into('<IBBHQQ', image, 0x2418, 1, 0x12, 0, 0, 0, 0)
+    struct.pack_into('<QQq', image, 0x2700, 0x2820, (1 << 32) | 6, 0)
+    code = b'\x48\x83\xec\x08\xff\x15' + struct.pack('<i', 0x2820 - 0x101a)
+    code += b'\x48\x83\xc4\x08\x83\xf8\x2a\x74\x02\x0f\x0b\xc3'
+    image[0x1010:0x1010 + len(code)] = code
+    tags = []
+    for position in range(0x2000, 0x2200, 16):
+        tag, value = struct.unpack_from('<qQ', image, position)
+        if tag == 0:
+            break
+        if tag in (25, 26, 27, 28, 13):
+            continue
+        if tag == 10 and owner != 'lifecycle_host.prx':
+            value += len(owner) + 1
+        tags.append((tag, value))
+    size, = struct.unpack_from('<Q', image, 0x2018)
+    if owner != 'lifecycle_host.prx':
+        image[0x2600 + size:0x2600 + size + len(owner) + 1] = owner.encode() + b'\0'
+        tags.append((1, size))
+    tags.append((0, 0))
+    for index, tag in enumerate(tags):
+        struct.pack_into('<qQ', image, 0x2000 + index * 16, *tag)
+    struct.pack_into('<QQ', image, 120 + 32, len(tags) * 16, len(tags) * 16)
+    return image
+
+
+def set_dynamic_value(image, tag, value, start=0x2000):
+    for position in range(start, start + 0x200, 16):
+        current, = struct.unpack_from('<q', image, position)
+        if current == tag:
+            struct.pack_into('<Q', image, position + 8, value)
+            return
+        if current == 0:
+            break
+    raise AssertionError(f'Missing dynamic tag {tag}')
+
+
+def no_import_executable(owner):
+    image = executable(owner)
+    set_dynamic_value(image, 8, 0, 0x4600)
+    image[0x4898:0x48b0] = bytes(24)
+    image[0x4000:0x4007] = b'\xb8\x2a\0\0\0\xc3\x90'
+    return image
+
+
+def event_call(address, event, slot=0x2820):
+    return b'\xbf' + struct.pack('<I', ord(event)) + b'\xff\x15' + struct.pack('<i', slot - (address + 11))
+
+
+def initialized_export(allocation):
+    image = guest()
+    set_dynamic_value(image, 12, 0x1100)
+    code = bytearray(b'\x48\x83\xec\x08')
+    if allocation:
+        # The Sony-like allocator returns NULL until its own initializer enables it.
+        allocator = b'\x83\x3d' + struct.pack('<i', 0x2860 - 0x1007) + b'\x00\x74\x08'
+        allocator += b'\x48\x8d\x05' + struct.pack('<i', 0x2880 - 0x1010) + b'\xc3\x31\xc0\xc3'
+        image[0x1000:0x1000 + len(allocator)] = allocator
+        struct.pack_into('<Q', image, 0x2418 + 16, len(allocator))
+        code += b'\xbf\x30\0\0\0\xe8' + struct.pack('<i', 0x1000 - (0x1100 + len(code) + 10))
+        code += b'\x48\x85\xc0\x74\x02\x0f\x0b'
+        code += event_call(0x1100 + len(code), 'B')
+        state, value = 0x2860, 1
+    else:
+        struct.pack_into('<IBBHQQ', image, 0x2418, 1, 0x11, 0, 1, 0x2840, 4)
+        state, value = 0x2840, 42
+    code += b'\xc7\x05' + struct.pack('<i', state - (0x1100 + len(code) + 10)) + struct.pack('<I', value)
+    code += event_call(0x1100 + len(code), 'I')
+    code += b'\x48\x83\xc4\x08\xc3'
+    image[0x1100:0x1100 + len(code)] = code
+    return image
+
+
+def initialized_export_consumer(allocation):
+    image = guest(import_name='CheckAllocation' if allocation else 'CheckInitializedData')
+    struct.pack_into('<IBBHQQ', image, 0x2418, 1, 0x12 if allocation else 0x11, 0, 0, 0, 0)
+    struct.pack_into('<QQq', image, 0x2700, 0x2820, (1 << 32) | 6, 0)
+    struct.pack_into('<QQq', image, 0x2718, 0x2828, (2 << 32) | 6, 0)
+    set_dynamic_value(image, 8, 48)
+    set_dynamic_value(image, 12, 0x1100)
+    # This dependent initializer consumes the retained export before main entry.
+    code = bytearray(b'\x48\x83\xec\x08')
+    if allocation:
+        code += b'\xbf\x30\0\0\0\xff\x15' + struct.pack('<i', 0x2820 - (0x1100 + len(code) + 11))
+        code += b'\x48\x89\xc7\xbe\x30\0\0\0'
+    else:
+        code += b'\x48\x8b\x3d' + struct.pack('<i', 0x2820 - (0x1100 + len(code) + 7))
+    code += b'\xff\x15' + struct.pack('<i', 0x2828 - (0x1100 + len(code) + 6))
+    code += b'\x48\x83\xc4\x08\xc3'
+    image[0x1100:0x1100 + len(code)] = code
+    # Only the provider owns the array/finalizer events.
+    for tag in (25, 26, 27, 28, 13):
+        set_dynamic_value(image, tag, 0)
+    return image
+
+
+def windows_lifecycle_targets(image):
+    entry = next(section for section in pe_sections(image) if section[0] == b'.entry')
+    code = image[entry[3]:entry[3] + entry[2]]
+    return [struct.unpack('<I', match[1])[0] for match in re.finditer(
+        rb'\x48\x8b\x05.{4}\xb9(.{4})\x48\x01\xc8', code, re.S)]
+
+
+def windows_lifecycle_exports(image):
+    sections = pe_sections(image)
+    def at(rva):
+        return next(section[3] + rva - section[1] for section in sections
+                    if section[1] <= rva < section[1] + section[2])
+    pe, = struct.unpack_from('<I', image, 0x3c)
+    directory, = struct.unpack_from('<I', image, pe + 24 + 112)
+    base = at(directory)
+    count, functions, names, ordinals = struct.unpack_from('<IIII', image, base + 24)
+    exports = {}
+    for index in range(count):
+        name_rva, = struct.unpack_from('<I', image, at(names) + index * 4)
+        name_at = at(name_rva)
+        name = image[name_at:image.index(0, name_at)].decode()
+        ordinal, = struct.unpack_from('<H', image, at(ordinals) + index * 2)
+        value, = struct.unpack_from('<I', image, at(functions) + ordinal * 4)
+        exports[name] = value
+    return exports
+
+
+def main():
+    if len(sys.argv) > 1 and sys.argv[1] in ('--load', '--load-placeholder', '--load-initialized-export'):
+        import ctypes
+        import _ctypes
+        library = ctypes.CDLL(sys.argv[2])
+        second = ctypes.CDLL(sys.argv[2])
+        if sys.argv[1] == '--load':
+            assert getattr(library, 'shared#guest')() == 42
+            assert getattr(second, 'shared#guest')() == 42
+        before = Path(os.environ['ANYPS5_LIFECYCLE_EVENTS']).read_text()
+        _ctypes.dlclose(library._handle)
+        assert Path(os.environ['ANYPS5_LIFECYCLE_EVENTS']).read_text() == before
+        _ctypes.dlclose(second._handle)
+        return
+    parser = argparse.ArgumentParser()
+    parser.add_argument('relinker', type=Path)
+    parser.add_argument('fixture', nargs='?', type=Path)
+    parser.add_argument('--windows-runner', help='Command prefix for executing PE fixtures, such as wine')
+    parser.add_argument('--work-directory', type=Path, help='Preserve generated regression cases here')
+    parser.add_argument('--allocation-only', action='store_true', help='Run only the constructor allocation regression')
+    args = parser.parse_args()
+    relinker = args.relinker.resolve()
+    fixture = args.fixture.resolve() if args.fixture else None
+    runner = shlex.split(args.windows_runner) if args.windows_runner else []
+    counts = {'converted': 0, 'rejected': 0, 'executed': 0, 'expected_import_failures': 0}
+    context = contextlib.nullcontext(args.work_directory) if args.work_directory else tempfile.TemporaryDirectory(prefix='anyps5-guest-lifecycle-')
+    with context as directory:
+        work = Path(directory)
+        work.mkdir(parents=True, exist_ok=True)
+
+        def convert(case, windows, original, source, dependent=None, expected_error=None):
+            modules = case / 'sce_module'
+            modules.mkdir(parents=True, exist_ok=True)
+            (modules / 'libc.prx').write_bytes(original)
+            if dependent is not None:
+                (modules / 'consumer.prx').write_bytes(dependent)
+            input_path = case / 'input.elf'
+            input_path.write_bytes(source)
+            output = case / ('output.exe' if windows else 'output.elf')
+            result = subprocess.run([str(relinker), *(['--windows'] if windows else []),
+                                     '--skip-syscall-check', str(input_path), str(output)],
+                                    capture_output=True, text=True, timeout=30)
+            if expected_error is not None:
+                assert result.returncode == 2 and expected_error in result.stderr, (case.name, result.stdout, result.stderr)
+                counts['rejected'] += 1
+                return None, None
+            assert result.returncode == 0, (case.name, result.stdout, result.stderr)
+            counts['converted'] += 1
+            return output, case / 'app0' / 'sce_module' / 'libc.prx.guest.prx'
+
+        def execute(case, windows, output, library, expected, load_mode='--load'):
+            native = (os.name == 'nt' or bool(runner)) if windows else (sys.platform == 'linux' and os.uname().machine == 'x86_64')
+            if not native:
+                return None
+            if not fixture:
+                raise AssertionError('Native lifecycle test requires the compiled host fixture')
+            libraries = case / 'libs'
+            libraries.mkdir(exist_ok=True)
+            shutil.copyfile(fixture, libraries / 'lifecycle_host.prx')
+            events = case / 'events.txt'
+            events.unlink(missing_ok=True)
+            event_path = str(events.resolve())
+            if windows and runner and os.name != 'nt':
+                event_path = 'Z:' + event_path.replace('/', '\\')
+            output.chmod(0o755)
+            command = [*runner, str(output)] if windows else [sys.executable, __file__, load_mode, str(library)]
+            run = subprocess.run(command, env={**os.environ, 'ANYPS5_LIFECYCLE_EVENTS': event_path},
+                                 capture_output=True, text=True, timeout=30)
+            if expected is None:
+                assert run.returncode != 0 and 'absent' in run.stderr, (case.name, run.returncode, run.stdout, run.stderr)
+                counts['expected_import_failures'] += 1
+                return run
+            assert run.returncode == (42 if windows else 0), (case.name, run.returncode, run.stdout, run.stderr)
+            actual = events.read_text()
+            assert actual == expected, (case.name, actual, expected)
+            counts['executed'] += 1
+            return run
+
+        for windows in (False, True):
+            for allocation in ((True,) if args.allocation_only else (True, False)):
+                case = work / f'{windows}-initialized-{"allocator" if allocation else "data"}'
+                output, converted = convert(case, windows, initialized_export(allocation),
+                                            no_import_executable('libc.prx'), initialized_export_consumer(allocation))
+                image = converted.read_bytes()
+                if windows:
+                    targets = windows_lifecycle_targets(output.read_bytes())
+                    start = windows_lifecycle_exports(image)['__anyps5_guest_start_v1']
+                    assert targets.count(start) == 2
+                else:
+                    assert lifecycle_tags(image) == {12, 13, 25, 26, 27, 28}
+                    assert needed_libraries(image) == ['lifecycle_host.prx']
+                    assert needed_libraries((converted.parent / 'consumer.prx.guest.prx').read_bytes()) == [
+                        '$ORIGIN/libc.prx.guest.prx', 'lifecycle_host.prx']
+                execute(case, windows, output, converted.parent / 'consumer.prx.guest.prx',
+                        'HBIACaih' if allocation else 'HIADaih',
+                        '--load-initialized-export')
+            if args.allocation_only:
+                continue
