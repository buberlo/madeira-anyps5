+#include "prx/libSceAgcDriver/Graphics/include/GpuStencilSampleTiler.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/DepthSampleSwizzleEquations.hpp"
+#include "prx/libSceAgcDriver/Graphics/shaders/StencilSampleTiling_spv.h"
+#include <algorithm>
+#include <bit>
+#include <limits>
+
+namespace AgcDriver::Graphics {
+namespace {
+std::array<std::uint32_t, 5> Parameters(const Context& context, const DepthTarget& depth,
+                                        DepthLayoutParameters parameters) {
+    Require(context.device != VK_NULL_HANDLE && context.sampleLocations && context.multisampleArrayImage &&
+        (depth.format == VK_FORMAT_D16_UNORM_S8_UINT || depth.format == VK_FORMAT_D32_SFLOAT_S8_UINT) &&
+        depth.samples == 8 && parameters.samples == 8 && parameters.fragments == 8,
+        "GPU stencil sample tiling requires qualified S8 and eight stored samples");
+    const DepthTargetLayout layout(depth.extent.width, depth.extent.height, DepthPlane::Stencil8, parameters);
+    constexpr std::array<std::uint32_t, 16> shaderEquation{0x01000000u,0x02000000u,0x04000000u,
+        0x00000001u,0x00001000u,0x00000002u,0x00002000u,0x00000004u,0x00008008u,0x00010010u,
+        0x00020040u,0x00040020u,0x00008000u,0x00000010u,0x00040000u,0x00084000u};
+    const auto* equation = FindDepthSampleSwizzleEquation(1, 8);
+    Require(equation && equation->bits == shaderEquation && equation->blockWidth == 64 && equation->blockHeight == 128 &&
+        layout.Alignment() == 65536 && layout.BlockWidth() == 64 && layout.BlockHeight() == 128 &&
+        layout.BlocksPerRow() == (depth.extent.width + 63u) / 64u,
+        "GPU stencil sample tiling layout/equation mismatch");
+    const auto expectedBytes = std::uint64_t(layout.BlocksPerRow()) *
+        ((depth.extent.height + 127u) / 128u) * 65536u;
+    Require(expectedBytes == layout.Bytes() && depth.stencilAddress != 0 &&
+        depth.stencilAddress % layout.Alignment() == 0 &&
+        depth.stencilAddress <= std::numeric_limits<std::uint64_t>::max() - layout.Bytes(),
+        "GPU stencil sample tiling guest range/layout mismatch");
+    Require(layout.Bytes() <= std::numeric_limits<std::uint32_t>::max() &&
+        layout.LinearBytes() <= std::numeric_limits<std::uint32_t>::max() &&
+        layout.Bytes() <= context.limits.maxStorageBufferRange && layout.LinearBytes() <= context.limits.maxStorageBufferRange,
+        "GPU stencil sample tiling exceeds storage/index limits");
+    Require(context.limits.maxPushConstantsSize >= 20 && context.limits.maxBoundDescriptorSets >= 1 &&
+        context.limits.maxPerStageDescriptorStorageBuffers >= 2 && context.limits.maxDescriptorSetStorageBuffers >= 2 &&
+        context.limits.maxPerStageResources >= 2, "GPU stencil sample tiling descriptor/push limits are unsupported");
+    Require(context.limits.maxComputeWorkGroupSize[0] >= 8 && context.limits.maxComputeWorkGroupSize[1] >= 8 &&
+        context.limits.maxComputeWorkGroupSize[2] >= 1 && context.limits.maxComputeWorkGroupInvocations >= 64 &&
+        (depth.extent.width + 7u) / 8u <= context.limits.maxComputeWorkGroupCount[0] &&
+        (depth.extent.height + 7u) / 8u <= context.limits.maxComputeWorkGroupCount[1] &&
+        context.limits.maxComputeWorkGroupCount[2] >= 2, "GPU stencil sample tiling compute limits are unsupported");
+    return {depth.extent.width, depth.extent.height, layout.BlocksPerRow(),
+        static_cast<std::uint32_t>(layout.Bytes() / 4u), static_cast<std::uint32_t>(layout.LinearBytes() / 4u)};
+}
+void Barrier(PFN_vkCmdPipelineBarrier call, VkCommandBuffer commands, StencilSampleTilingBufferAccess before,
+             VkDeviceSize bytes, VkPipelineStageFlags stage, VkAccessFlags access) {
+    VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    barrier.srcAccessMask = before.access; barrier.dstAccessMask = access;
+    barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.buffer = before.buffer; barrier.offset = before.offset; barrier.size = bytes;
+    call(commands, before.stage, stage, 0, 0, nullptr, 1, &barrier, 0, nullptr);
+}
+}
+bool GpuStencilSampleTiler::Supports(const Context& context, const DepthTarget& depth, DepthLayoutParameters parameters) {
+    try { static_cast<void>(Parameters(context, depth, parameters)); return true; }
+    catch (const std::runtime_error&) { return false; }
+}
+GpuStencilSampleTiler::GpuStencilSampleTiler(const Context& context) : context(context) {
+    Require(context.device != VK_NULL_HANDLE, "GPU stencil sample tiling device is unavailable");
+    destroyModule = context.Function<PFN_vkDestroyShaderModule>("vkDestroyShaderModule");
+    destroyDescriptors = context.Function<PFN_vkDestroyDescriptorSetLayout>("vkDestroyDescriptorSetLayout");
+    destroyLayout = context.Function<PFN_vkDestroyPipelineLayout>("vkDestroyPipelineLayout");
+    destroyPipeline = context.Function<PFN_vkDestroyPipeline>("vkDestroyPipeline");
+    destroyPool = context.Function<PFN_vkDestroyDescriptorPool>("vkDestroyDescriptorPool");
+    try {
+        const std::array<VkDescriptorSetLayoutBinding, 2> bindings{{
+            {0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr},
+            {1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr}}};
+        VkDescriptorSetLayoutCreateInfo info{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        info.bindingCount = 2; info.pBindings = bindings.data();
+        Check(context.Function<PFN_vkCreateDescriptorSetLayout>("vkCreateDescriptorSetLayout")(
+            context.device, &info, nullptr, &descriptors), "vkCreateDescriptorSetLayout stencil sample tiling");
+        VkPushConstantRange push{VK_SHADER_STAGE_COMPUTE_BIT, 0, 20};
+        VkPipelineLayoutCreateInfo layoutInfo{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        layoutInfo.setLayoutCount = 1; layoutInfo.pSetLayouts = &descriptors;
+        layoutInfo.pushConstantRangeCount = 1; layoutInfo.pPushConstantRanges = &push;
+        Check(context.Function<PFN_vkCreatePipelineLayout>("vkCreatePipelineLayout")(
+            context.device, &layoutInfo, nullptr, &layout), "vkCreatePipelineLayout stencil sample tiling");
+        VkShaderModuleCreateInfo moduleInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+        moduleInfo.codeSize = sizeof(STENCIL_SAMPLE_TILING_COMP_SPV); moduleInfo.pCode = STENCIL_SAMPLE_TILING_COMP_SPV;
+        Check(context.Function<PFN_vkCreateShaderModule>("vkCreateShaderModule")(
+            context.device, &moduleInfo, nullptr, &module), "vkCreateShaderModule stencil sample tiling");
+    } catch (...) { release(); throw; }
+}
+GpuStencilSampleTiler::~GpuStencilSampleTiler() { release(); }
+void GpuStencilSampleTiler::release() noexcept {
+    for (auto pipeline : programs) if (pipeline) destroyPipeline(context.device, pipeline, nullptr);
+    if (module) destroyModule(context.device, module, nullptr);
+    if (layout) destroyLayout(context.device, layout, nullptr);
+    if (descriptors) destroyDescriptors(context.device, descriptors, nullptr);
+}
+VkPipeline GpuStencilSampleTiler::program(bool retile) {
+    std::lock_guard lock(programsMutex);
+    auto& pipeline = programs.at(unsigned(retile));
+    if (pipeline) return pipeline;
+    const std::uint32_t direction = unsigned(retile);
+    const VkSpecializationMapEntry entry{0, 0, 4};
+    const VkSpecializationInfo specialization{1, &entry, sizeof(direction), &direction};
+    VkComputePipelineCreateInfo info{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    info.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+    info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT; info.stage.module = module;
+    info.stage.pName = "main"; info.stage.pSpecializationInfo = &specialization; info.layout = layout;
+    VkPipeline created = VK_NULL_HANDLE;
+    const auto result = context.Function<PFN_vkCreateComputePipelines>("vkCreateComputePipelines")(
+        context.device, context.pipelineCache, 1, &info, nullptr, &created);
+    // Vulkan may return a partial handle even on pipeline creation failure.
+    if (result != VK_SUCCESS) { if (created) destroyPipeline(context.device, created, nullptr); Check(result, "vkCreateComputePipelines stencil sample tiling"); }
+    pipeline = created;
+    return pipeline;
+}
+GpuStencilSampleTiler::Transfer::Transfer(GpuStencilSampleTiler& owner, const DepthTarget& depth, DepthLayoutParameters parameters)
+    : owner(owner), parameters(Parameters(owner.context, depth, parameters)) {}
+GpuStencilSampleTiler::Transfer::~Transfer() {
+    for (const auto pool : pools) owner.destroyPool(owner.context.device, pool, nullptr);
+}
+void GpuStencilSampleTiler::Transfer::Record(VkCommandBuffer commands, bool retile,
+    StencilSampleTilingBufferAccess source, StencilSampleTilingBufferAccess destination,
+    VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess) {
+    const auto& context = owner.context;
+    const VkDeviceSize sourceBytes = VkDeviceSize(parameters[retile ? 4 : 3]) * 4u;
+    const VkDeviceSize destinationBytes = VkDeviceSize(parameters[retile ? 3 : 4]) * 4u;
+    const auto validate = [&](StencilSampleTilingBufferAccess buffer, VkDeviceSize bytes) {
+        const auto alignment = std::max<VkDeviceSize>(4, context.limits.minStorageBufferOffsetAlignment);
+        Require(buffer.device == context.device && buffer.buffer && buffer.stage && buffer.bytes >= bytes &&
+            buffer.offset % alignment == 0 && buffer.offset <= std::numeric_limits<VkDeviceSize>::max() - bytes,
+            "GPU stencil sample tiling buffer device/range/state is invalid");
+    };
+    Require(commands && consumerStage, "GPU stencil sample tiling command/consumer state is unavailable");
+    validate(source, sourceBytes); validate(destination, destinationBytes);
+    Require(source.buffer != destination.buffer || source.offset >= destination.offset + destinationBytes ||
+        destination.offset >= source.offset + sourceBytes, "GPU stencil sample tiling buffers overlap");
+    // Resolve all recording functions and allocate everything before emitting commands.
+    const auto barrier = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto bindPipeline = context.Resolved(&DeviceFunctions::cmdBindPipeline, "vkCmdBindPipeline");
+    const auto bindSets = context.Resolved(&DeviceFunctions::cmdBindDescriptorSets, "vkCmdBindDescriptorSets");
+    const auto push = context.Resolved(&DeviceFunctions::cmdPushConstants, "vkCmdPushConstants");
+    const auto dispatch = context.Resolved(&DeviceFunctions::cmdDispatch, "vkCmdDispatch");
+    const auto allocate = context.Resolved(&DeviceFunctions::allocateDescriptorSets, "vkAllocateDescriptorSets");
+    const auto update = context.Resolved(&DeviceFunctions::updateDescriptorSets, "vkUpdateDescriptorSets");
+    const auto pipeline = owner.program(retile);
+    VkDescriptorPoolSize size{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 2};
+    VkDescriptorPoolCreateInfo poolInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    poolInfo.maxSets = 1; poolInfo.poolSizeCount = 1; poolInfo.pPoolSizes = &size;
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    Check(context.Function<PFN_vkCreateDescriptorPool>("vkCreateDescriptorPool")(
+        context.device, &poolInfo, nullptr, &pool), "vkCreateDescriptorPool stencil sample tiling");
+    VkDescriptorSet set = VK_NULL_HANDLE;
+    try {
+        VkDescriptorSetAllocateInfo info{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        info.descriptorPool = pool; info.descriptorSetCount = 1; info.pSetLayouts = &owner.descriptors;
+        Check(allocate(context.device, &info, &set), "vkAllocateDescriptorSets stencil sample tiling");
+        pools.push_back(pool);
+    } catch (...) { owner.destroyPool(context.device, pool, nullptr); throw; }
+    const std::array<VkDescriptorBufferInfo, 2> buffers{{
+        {source.buffer, source.offset, sourceBytes}, {destination.buffer, destination.offset, destinationBytes}}};
+    std::array<VkWriteDescriptorSet, 2> writes{};
+    for (std::uint32_t i = 0; i < writes.size(); ++i) {
+        writes[i] = {VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET}; writes[i].dstSet = set;
+        writes[i].dstBinding = i; writes[i].descriptorCount = 1;
+        writes[i].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER; writes[i].pBufferInfo = &buffers[i];
+    }
+    update(context.device, 2, writes.data(), 0, nullptr);
+    Barrier(barrier, commands, source, sourceBytes, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+    Barrier(barrier, commands, destination, destinationBytes, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT);
+    bindPipeline(commands, VK_PIPELINE_BIND_POINT_COMPUTE, pipeline);
+    bindSets(commands, VK_PIPELINE_BIND_POINT_COMPUTE, owner.layout, 0, 1, &set, 0, nullptr);
+    push(commands, owner.layout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(parameters), parameters.data());
+    dispatch(commands, (parameters[0] + 7u) / 8u, (parameters[1] + 7u) / 8u, 2);
+    destination.stage = VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT; destination.access = VK_ACCESS_SHADER_WRITE_BIT;
+    Barrier(barrier, commands, destination, destinationBytes, consumerStage, consumerAccess);
+}
+}
