+#version 450
+layout(set = 0, binding = 0, std430) readonly buffer Packed { uint values[]; } source;
+layout(push_constant) uniform Parameters { uint width; uint height; uint samples; uint logicalSample; uint bitIndex; } parameters;
+void main() {
+    uvec2 pixel = uvec2(gl_FragCoord.xy);
+    uint index = (pixel.y * parameters.width + pixel.x) * parameters.samples + parameters.logicalSample;
+    uint byteValue = (source.values[index / 4u] >> ((index % 4u) * 8u)) & 255u;
+    if ((byteValue & (1u << parameters.bitIndex)) == 0u) discard;
+}
