diff --git a/core/libs/prx/libSceAgcDriver/Graphics/shaders/StencilSampleReadback.comp b/core/libs/prx/libSceAgcDriver/Graphics/shaders/StencilSampleReadback.comp
new file mode 100644
index 0000000..299f32e
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/shaders/StencilSampleReadback.comp
@@ -0,0 +1,24 @@
+#version 450
+#extension GL_EXT_samplerless_texture_functions : require
+layout(local_size_x = 64) in;
+layout(set = 0, binding = 0) uniform utexture2DMSArray stencilSamples;
+layout(set = 0, binding = 1, std430) buffer Packed { uint values[]; } destination;
+layout(push_constant) uniform Parameters { uint width; uint height; uint samples; uint nativeSamples; uint logicalBytes; } parameters;
+void main() {
+    uint wordIndex = gl_GlobalInvocationID.x;
+    uint firstByte = wordIndex * 4u;
+    if (firstByte >= parameters.logicalBytes) return;
+    // A single invocation owns all four bytes, including a possible partial final word.
+    uint result = firstByte + 4u > parameters.logicalBytes ? destination.values[wordIndex] : 0u;
+    for (uint lane = 0; lane < 4u; ++lane) {
+        uint index = firstByte + lane;
+        if (index >= parameters.logicalBytes) break;
+        uint sampleIndex = index % parameters.samples;
+        uint pixelIndex = index / parameters.samples;
+        ivec2 pixel = ivec2(pixelIndex % parameters.width, pixelIndex / parameters.width);
+        uint value = texelFetch(stencilSamples, ivec3(pixel, sampleIndex / parameters.nativeSamples), int(sampleIndex % parameters.nativeSamples)).r;
+        uint shift = lane * 8u;
+        result = (result & ~(255u << shift)) | ((value & 255u) << shift);
+    }
+    destination.values[wordIndex] = result;
+}
