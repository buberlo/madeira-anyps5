+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_STENCILZEROINVARIANT_HPP
+
+#include "prx/libSceAgcDriver/Graphics/include/State.hpp"
+#include <span>
+
+namespace AgcDriver::Graphics {
+struct CompiledShader;
+bool ZeroStencilInvariantEnabled();
+// Reads only this owned snapshot span, including its tiled padding.
+bool AllStencilBytesZero(std::span<const std::byte> bytes) noexcept;
+// Necessary semantic proof only: ordinary split/shader/resource/alias validation
+// still runs in Draw. expectedBytes must be the validated full S8 layout size.
+bool PreservesZeroStencil(const State& state, std::span<const CompiledShader> shaders,
+                          std::span<const std::byte> original, std::size_t expectedBytes);
+
+// No programs, buffers or descriptors are owned. The caller keeps this device,
+// borrowed depth image/views and its sample identity through the existing fence.
+// Metadata admission intentionally retains the old general transfer's checks.
+class StencilZeroTransfer {
+public:
+    StencilZeroTransfer(const Context& context, VkImage image, VkFormat format,
+        std::span<const VkImageView> groupAttachments, VkExtent2D extent,
+        std::uint32_t logicalSamples, std::span<const VkSampleLocationEXT> guestPositions);
+    void RecordClear(VkCommandBuffer commands) const;
+    void RecordFinish(VkCommandBuffer commands) const;
+private:
+    void barrier(PFN_vkCmdPipelineBarrier operation, VkCommandBuffer commands,
+                 VkPipelineStageFlags sourceStage, VkAccessFlags sourceAccess,
+                 VkPipelineStageFlags destinationStage, VkAccessFlags destinationAccess) const;
+    Context context;
+    VkImage image;
+    std::uint32_t samples, nativeSamples, groups;
+    std::array<VkSampleLocationEXT, 8> positions{};
+};
+}
