@@ -0,0 +1,86 @@
+#ifndef CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_STENCILSAMPLETRANSFER_HPP
+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_STENCILSAMPLETRANSFER_HPP
+
+#include "prx/libSceAgcDriver/Graphics/include/ColorSampleTransfer.hpp"
+
+namespace AgcDriver::Graphics {
+struct StencilSamplePrograms;
+// Opt-in per-device bounded immutable program cache. Eviction/Clear only drop
+// references: a transfer keeps its programs until its caller's GPU fence completes.
+// Clear after recorder retirement/device idle and before destroying VkDevice.
+class StencilSampleProgramCache {
+public:
+    explicit StencilSampleProgramCache(const Context& context, std::size_t capacity = 8);
+    ~StencilSampleProgramCache();
+    StencilSampleProgramCache(const StencilSampleProgramCache&) = delete;
+    StencilSampleProgramCache& operator=(const StencilSampleProgramCache&) = delete;
+    void Clear();
+private:
+    friend class StencilSampleTransfer;
+    struct State;
+    std::unique_ptr<State> state;
+    std::shared_ptr<const StencilSamplePrograms> Acquire(const Context& context, VkFormat format,
+        std::uint32_t samples, std::span<const VkSampleLocationEXT> positions);
+};
+
+// Exact uncompressed S8 transfers through a combined depth/stencil image. The caller supplies
+// matching image metadata and group attachment views on this Context's device. The image must
+// have SAMPLE_LOCATIONS_COMPATIBLE_DEPTH, DEPTH_STENCIL_ATTACHMENT, SAMPLED and TRANSFER_DST
+// usage, one mip, and logicalSamples/min(logicalSamples,4) array layers. No Z or HTILE import is
+// performed. Positions are the image's unchanged full guest 1x1 sample-location identity.
+// Keep this object, image, attachment views and all buffers alive through GPU fence completion.
+// Buffer bytes are little-endian S8, pixel then logical sample; PackedBytes rounds to a uint.
+// Readback preserves any padding bytes in the last word. Callers must initialize that word.
+class StencilSampleTransfer {
+public:
+    StencilSampleTransfer(const Context& context, VkImage image, VkFormat format,
+                          std::span<const VkImageView> groupAttachments, VkExtent2D extent,
+                          std::uint32_t logicalSamples, std::span<const VkSampleLocationEXT> positions);
+    ~StencilSampleTransfer();
+    StencilSampleTransfer(const StencilSampleTransfer&) = delete;
+    StencilSampleTransfer& operator=(const StencilSampleTransfer&) = delete;
+    VkDeviceSize PackedBytes() const { return packedBytes; }
+    VkDeviceSize LogicalBytes() const { return logicalBytes; }
+    void RecordUpload(VkCommandBuffer commands, const ColorSampleBufferAccess& source,
+                      ColorSampleImageAccess before, ColorSampleImageAccess after);
+    void RecordReadback(VkCommandBuffer commands, const ColorSampleBufferAccess& outputBefore,
+                        ColorSampleImageAccess before, ColorSampleImageAccess after,
+                        VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess);
+private:
+    void release() noexcept;
+    void validateBuffer(const ColorSampleBufferAccess& buffer) const;
+    void validateImage(ColorSampleImageAccess state) const;
+    VkDescriptorSet descriptor(bool upload, const ColorSampleBufferAccess& buffer);
+    void imageBarrier(PFN_vkCmdPipelineBarrier barrier, VkCommandBuffer commands,
+                      ColorSampleImageAccess before, ColorSampleImageAccess after) const;
+    VkSampleLocationsInfoEXT locations(std::uint32_t group) const;
+    std::shared_ptr<const StencilSamplePrograms> programOwner;
+    Context context;
+    VkImage image;
+    VkExtent2D extent;
+    std::uint32_t samples;
+    std::uint32_t nativeSamples;
+    std::uint32_t groups;
+    VkDeviceSize logicalBytes;
+    VkDeviceSize packedBytes;
+    std::array<VkSampleLocationEXT, 8> positions{};
+    VkImageView sampledView = VK_NULL_HANDLE;
+    VkRenderPass renderPass = VK_NULL_HANDLE;
+    std::array<VkFramebuffer, 2> framebuffers{};
+    std::array<std::array<VkPipeline, 4>, 2> uploadPipelines{};
+    VkPipeline readbackPipeline = VK_NULL_HANDLE;
+    VkDescriptorSetLayout uploadDescriptors = VK_NULL_HANDLE;
+    VkDescriptorSetLayout readbackDescriptors = VK_NULL_HANDLE;
+    VkPipelineLayout uploadLayout = VK_NULL_HANDLE;
+    VkPipelineLayout readbackLayout = VK_NULL_HANDLE;
+    std::vector<VkDescriptorPool> retainedPools;
+    PFN_vkDestroyImageView destroyImageView = nullptr;
+    PFN_vkDestroyFramebuffer destroyFramebuffer = nullptr;
+    PFN_vkDestroyRenderPass destroyRenderPass = nullptr;
+    PFN_vkDestroyPipeline destroyPipeline = nullptr;
+    PFN_vkDestroyPipelineLayout destroyPipelineLayout = nullptr;
+    PFN_vkDestroyDescriptorSetLayout destroyDescriptorSetLayout = nullptr;
+    PFN_vkDestroyDescriptorPool destroyDescriptorPool = nullptr;
+};
+}
+#endif
