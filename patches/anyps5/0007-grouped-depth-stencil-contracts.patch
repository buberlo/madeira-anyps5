+void BufferBarrier(PFN_vkCmdPipelineBarrier barrier, VkCommandBuffer commands,
+                   const ColorSampleBufferAccess& before, VkDeviceSize bytes,
+                   VkPipelineStageFlags afterStage, VkAccessFlags afterAccess) {
+    VkBufferMemoryBarrier buffer{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    buffer.srcAccessMask = before.access;
+    buffer.dstAccessMask = afterAccess;
+    buffer.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    buffer.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    buffer.buffer = before.buffer;
+    buffer.offset = before.offset;
+    buffer.size = bytes;
+    barrier(commands, before.stage, afterStage, 0, 0, nullptr, 1, &buffer, 0, nullptr);
+}
+constexpr ColorSampleImageAccess AttachmentAccess{
+    VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
+    VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT};
+constexpr ColorSampleImageAccess ReadbackAccess{
+    VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT};
+constexpr ColorSampleImageAccess ClearAccess{
+    VK_IMAGE_LAYOUT_GENERAL, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT};
+
+}
+
+struct StencilSamplePrograms {
+    Context context;
+    std::uint32_t samples, nativeSamples, groups;
+    std::array<VkSampleLocationEXT, 8> positions{};
+    VkRenderPass renderPass = VK_NULL_HANDLE;
+    std::array<std::array<VkPipeline, 4>, 2> uploadPipelines{};
+    VkPipeline readbackPipeline = VK_NULL_HANDLE;
+    VkDescriptorSetLayout uploadDescriptors = VK_NULL_HANDLE, readbackDescriptors = VK_NULL_HANDLE;
+    VkPipelineLayout uploadLayout = VK_NULL_HANDLE, readbackLayout = VK_NULL_HANDLE;
+    PFN_vkDestroyRenderPass destroyRenderPass;
+    PFN_vkDestroyPipeline destroyPipeline;
+    PFN_vkDestroyPipelineLayout destroyPipelineLayout;
+    PFN_vkDestroyDescriptorSetLayout destroyDescriptorSetLayout;
+    StencilSamplePrograms(const Context& context, VkFormat format, std::uint32_t samples,
+                          std::span<const VkSampleLocationEXT> guestPositions)
+        : context(context), samples(samples), nativeSamples(std::min(samples,4u)), groups(samples/nativeSamples) {
+        std::copy(guestPositions.begin(), guestPositions.end(), positions.begin());
+        destroyRenderPass=context.Function<PFN_vkDestroyRenderPass>("vkDestroyRenderPass");
+        destroyPipeline=context.Function<PFN_vkDestroyPipeline>("vkDestroyPipeline");
+        destroyPipelineLayout=context.Function<PFN_vkDestroyPipelineLayout>("vkDestroyPipelineLayout");
+        destroyDescriptorSetLayout=context.Function<PFN_vkDestroyDescriptorSetLayout>("vkDestroyDescriptorSetLayout");
+        const auto destroyModule=context.Function<PFN_vkDestroyShaderModule>("vkDestroyShaderModule");
+        std::array<VkShaderModule,3> modules{};
+        try {
+        const VkDescriptorSetLayoutBinding uploadBinding{0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_FRAGMENT_BIT, nullptr};
+        VkDescriptorSetLayoutCreateInfo descriptorInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        descriptorInfo.bindingCount = 1;
+        descriptorInfo.pBindings = &uploadBinding;
+        const auto createDescriptors = context.Function<PFN_vkCreateDescriptorSetLayout>("vkCreateDescriptorSetLayout");
+        Check(createDescriptors(context.device, &descriptorInfo, nullptr, &uploadDescriptors), "vkCreateDescriptorSetLayout stencil sample upload");
+        const std::array<VkDescriptorSetLayoutBinding, 2> readbackBindings{{
+            {0, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr},
+            {1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr}}};
+        descriptorInfo.bindingCount = 2;
+        descriptorInfo.pBindings = readbackBindings.data();
+        Check(createDescriptors(context.device, &descriptorInfo, nullptr, &readbackDescriptors), "vkCreateDescriptorSetLayout stencil sample readback");
+        VkPushConstantRange push{VK_SHADER_STAGE_FRAGMENT_BIT, 0, 20};
+        VkPipelineLayoutCreateInfo layoutInfo{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        layoutInfo.setLayoutCount = 1;
+        layoutInfo.pSetLayouts = &uploadDescriptors;
+        layoutInfo.pushConstantRangeCount = 1;
+        layoutInfo.pPushConstantRanges = &push;
+        const auto createLayout = context.Function<PFN_vkCreatePipelineLayout>("vkCreatePipelineLayout");
+        Check(createLayout(context.device, &layoutInfo, nullptr, &uploadLayout), "vkCreatePipelineLayout stencil sample upload");
+        layoutInfo.pSetLayouts = &readbackDescriptors;
+        push.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        Check(createLayout(context.device, &layoutInfo, nullptr, &readbackLayout), "vkCreatePipelineLayout stencil sample readback");
+        VkAttachmentDescription attachment{};
+        attachment.format = format;
+        attachment.samples = static_cast<VkSampleCountFlagBits>(nativeSamples);
+        attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_STORE;
+        attachment.initialLayout = VK_IMAGE_LAYOUT_GENERAL;
+        attachment.finalLayout = VK_IMAGE_LAYOUT_GENERAL;
+        VkAttachmentReference reference{0, VK_IMAGE_LAYOUT_GENERAL};
+        VkSubpassDescription subpass{};
+        subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        subpass.pDepthStencilAttachment = &reference;
+        VkRenderPassCreateInfo passInfo{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+        passInfo.attachmentCount = 1;
+        passInfo.pAttachments = &attachment;
+        passInfo.subpassCount = 1;
+        passInfo.pSubpasses = &subpass;
+        Check(context.Function<PFN_vkCreateRenderPass>("vkCreateRenderPass")(context.device, &passInfo, nullptr, &renderPass), "vkCreateRenderPass stencil sample upload");
+        const std::array<std::span<const std::uint32_t>, 3> programs{
+            STENCIL_SAMPLE_UPLOAD_VERT_SPV, STENCIL_SAMPLE_UPLOAD_FRAG_SPV, STENCIL_SAMPLE_READBACK_COMP_SPV};
+        const auto createModule = context.Function<PFN_vkCreateShaderModule>("vkCreateShaderModule");
+        for (std::uint32_t i = 0; i < modules.size(); ++i) {
+            VkShaderModuleCreateInfo moduleInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+            moduleInfo.codeSize = programs[i].size_bytes();
+            moduleInfo.pCode = programs[i].data();
+            Check(createModule(context.device, &moduleInfo, nullptr, &modules[i]), "vkCreateShaderModule stencil sample transfer");
+        }
+        const std::array<VkPipelineShaderStageCreateInfo, 2> stages{{
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_VERTEX_BIT, modules[0], "main", nullptr},
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_FRAGMENT_BIT, modules[1], "main", nullptr}}};
+        VkPipelineVertexInputStateCreateInfo vertices{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+        VkPipelineInputAssemblyStateCreateInfo assembly{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+        assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        VkPipelineViewportStateCreateInfo viewport{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+        viewport.viewportCount = viewport.scissorCount = 1;
+        VkPipelineRasterizationStateCreateInfo raster{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+        raster.polygonMode = VK_POLYGON_MODE_FILL;
+        raster.cullMode = VK_CULL_MODE_NONE;
+        raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+        raster.lineWidth = 1.0f;
+        VkPipelineMultisampleStateCreateInfo multisample{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+        multisample.rasterizationSamples = static_cast<VkSampleCountFlagBits>(nativeSamples);
+        // One selected native sample per raster invocation; sampleRateShading is unnecessary.
+        VkSampleMask sampleMask = 1;
+        multisample.pSampleMask = &sampleMask;
+        VkPipelineDepthStencilStateCreateInfo depthStencil{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+        depthStencil.depthTestEnable = VK_FALSE;
+        depthStencil.depthWriteEnable = VK_FALSE;
+        depthStencil.stencilTestEnable = VK_TRUE;
+        depthStencil.front = {VK_STENCIL_OP_KEEP, VK_STENCIL_OP_REPLACE, VK_STENCIL_OP_KEEP, VK_COMPARE_OP_ALWAYS, 255u, 255u, 255u};
+        depthStencil.back = depthStencil.front;
+        VkPipelineColorBlendStateCreateInfo blend{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+        const std::array<VkDynamicState, 3> dynamicStates{VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR, VK_DYNAMIC_STATE_STENCIL_WRITE_MASK};
+        VkPipelineDynamicStateCreateInfo dynamic{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+        dynamic.dynamicStateCount = static_cast<std::uint32_t>(dynamicStates.size());
+        dynamic.pDynamicStates = dynamicStates.data();
+        VkGraphicsPipelineCreateInfo graphics{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+        graphics.stageCount = static_cast<std::uint32_t>(stages.size());
+        graphics.pStages = stages.data();
+        graphics.pVertexInputState = &vertices;
+        graphics.pInputAssemblyState = &assembly;
+        graphics.pViewportState = &viewport;
+        graphics.pRasterizationState = &raster;
+        graphics.pMultisampleState = &multisample;
+        graphics.pColorBlendState = &blend;
+        graphics.pDepthStencilState = &depthStencil;
+        graphics.pDynamicState = &dynamic;
+        graphics.layout = uploadLayout;
+        graphics.renderPass = renderPass;
+        const auto createGraphics = context.Function<PFN_vkCreateGraphicsPipelines>("vkCreateGraphicsPipelines");
+        for (std::uint32_t group = 0; group < groups; ++group) {
+            VkPipelineSampleLocationsStateCreateInfoEXT locationState{VK_STRUCTURE_TYPE_PIPELINE_SAMPLE_LOCATIONS_STATE_CREATE_INFO_EXT};
+            locationState.sampleLocationsEnable = VK_TRUE;
+            locationState.sampleLocationsInfo = locations(group);
+            multisample.pNext = &locationState;
+            for (std::uint32_t sample = 0; sample < nativeSamples; ++sample) {
+                sampleMask = 1u << sample;
+                Check(createGraphics(context.device, context.pipelineCache, 1, &graphics, nullptr, &uploadPipelines[group][sample]), "vkCreateGraphicsPipelines stencil sample upload");
+            }
+        }
+        VkComputePipelineCreateInfo compute{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+        compute.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+        compute.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+        compute.stage.module = modules[2];
+        compute.stage.pName = "main";
+        compute.layout = readbackLayout;
+        Check(context.Function<PFN_vkCreateComputePipelines>("vkCreateComputePipelines")(context.device, context.pipelineCache, 1, &compute, nullptr, &readbackPipeline), "vkCreateComputePipelines stencil sample readback");
+            for(auto& module:modules) { destroyModule(context.device,module,nullptr); module=VK_NULL_HANDLE; }
+        } catch (...) {
+            for(auto module:modules) if(module) destroyModule(context.device,module,nullptr);
+            release(); throw;
+        }
+    }
+    ~StencilSamplePrograms() { release(); }
+    VkSampleLocationsInfoEXT locations(std::uint32_t group) const {
+        return {VK_STRUCTURE_TYPE_SAMPLE_LOCATIONS_INFO_EXT,nullptr,static_cast<VkSampleCountFlagBits>(nativeSamples),
+            {1,1},nativeSamples,positions.data()+group*nativeSamples};
+    }
+    void release() noexcept {
+        for(const auto& group:uploadPipelines)for(auto pipeline:group)if(pipeline)destroyPipeline(context.device,pipeline,nullptr);
+        if(readbackPipeline)destroyPipeline(context.device,readbackPipeline,nullptr);
+        if(renderPass)destroyRenderPass(context.device,renderPass,nullptr);
+        if(uploadLayout)destroyPipelineLayout(context.device,uploadLayout,nullptr);
+        if(readbackLayout)destroyPipelineLayout(context.device,readbackLayout,nullptr);
+        if(uploadDescriptors)destroyDescriptorSetLayout(context.device,uploadDescriptors,nullptr);
+        if(readbackDescriptors)destroyDescriptorSetLayout(context.device,readbackDescriptors,nullptr);
+    }
+};
+struct StencilSampleProgramCache::State {
+    struct Key {
+        std::uint64_t domain;
+        VkDevice device;
+        VkFormat format;
+        std::uint32_t samples,nativeSamples,groups,schema=1;
+        std::array<std::uint32_t,16> orderedPositions{};
+        bool operator==(const Key&) const = default;
+    };
+    struct Entry { Key key; std::shared_ptr<const StencilSamplePrograms> programs; };
+    VkDevice device;
+    VkPhysicalDevice physical;
+    std::uint64_t domain;
+    std::size_t capacity;
+    std::mutex mutex;
+    std::once_flag hitNote;
+    std::list<Entry> entries;
+    State(const Context& context,std::size_t capacity):device(context.device),physical(context.physical),capacity(capacity) {
+        static std::atomic<std::uint64_t> nextDomain{1};domain=nextDomain.fetch_add(1);
+    }
+};
+StencilSampleProgramCache::StencilSampleProgramCache(const Context& context,std::size_t capacity) {
+    Require(context.device != VK_NULL_HANDLE && capacity > 0 && capacity <= 8,"invalid stencil program cache device/capacity");
+    state=std::make_unique<State>(context,capacity);
+}
+StencilSampleProgramCache::~StencilSampleProgramCache() = default;
+void StencilSampleProgramCache::Clear() { std::lock_guard lock(state->mutex);state->entries.clear(); }
+std::shared_ptr<const StencilSamplePrograms> StencilSampleProgramCache::Acquire(const Context& context,VkFormat format,
+    std::uint32_t samples,std::span<const VkSampleLocationEXT> positions) {
+    Require(context.device == state->device && context.physical == state->physical,"stencil program cache belongs to another device domain");
+    State::Key key{state->domain,context.device,format,samples,std::min(samples,4u),samples/std::min(samples,4u)};
+    for(std::uint32_t i=0;i<samples;++i) {key.orderedPositions[i*2]=std::bit_cast<std::uint32_t>(positions[i].x);key.orderedPositions[i*2+1]=std::bit_cast<std::uint32_t>(positions[i].y);}
+    std::lock_guard lock(state->mutex);
+    for(auto it=state->entries.begin();it!=state->entries.end();++it)if(it->key==key) {
+        std::call_once(state->hitNote, [] { std::fprintf(stderr,"[stencil-program-cache] immutable bundle reused; ordered sample positions matched\n"); });
+        const auto programs=it->programs;state->entries.splice(state->entries.begin(),state->entries,it);return programs;
+    }
+    auto programs=std::make_shared<StencilSamplePrograms>(context,format,samples,positions);
+    state->entries.push_front({key,programs});
+    if(state->entries.size()>state->capacity)state->entries.pop_back();
+    return programs;
+}
+
+StencilSampleTransfer::StencilSampleTransfer(const Context& context, VkImage image, VkFormat format,
+    std::span<const VkImageView> groupAttachments, VkExtent2D extent, std::uint32_t logicalSamples,
+    std::span<const VkSampleLocationEXT> guestPositions)
+    : context(context), image(image), extent(extent), samples(logicalSamples),
+      nativeSamples(std::min(logicalSamples, 4u)), groups(0), logicalBytes(0), packedBytes(0) {
+    Require(format == VK_FORMAT_D16_UNORM_S8_UINT || format == VK_FORMAT_D32_SFLOAT_S8_UINT,
+            "stencil sample transfer requires a combined D16S8/D32S8 image");
+    Require(image != VK_NULL_HANDLE && std::has_single_bit(samples) && samples >= 2 && samples <= 8,
+            "stencil sample transfer requires a valid 2/4/8 sample image");
+    groups = samples / nativeSamples;
+    Require(groupAttachments.size() == groups && std::all_of(groupAttachments.begin(), groupAttachments.end(),
+            [](auto view) { return view != VK_NULL_HANDLE; }), "stencil sample transfer attachment groups are unavailable");
+    Require(groups == 1u || context.multisampleArrayImage, "stencil sample transfer array feature is unavailable");
+    const auto& properties = context.sampleLocationProperties;
+    Require(context.sampleLocations && guestPositions.size() == samples &&
+            (properties.sampleLocationSampleCounts & nativeSamples) != 0 &&
+            properties.maxSampleLocationGridSize.width >= 1u && properties.maxSampleLocationGridSize.height >= 1u &&
+            properties.sampleLocationSubPixelBits >= 4u, "stencil sample transfer guest sample locations are unsupported");
+    for (std::uint32_t i = 0; i < samples; ++i) {
+        const auto position = guestPositions[i];
+        Require(std::isfinite(position.x) && std::isfinite(position.y) &&
+                position.x >= properties.sampleLocationCoordinateRange[0] && position.x <= properties.sampleLocationCoordinateRange[1] &&
+                position.y >= properties.sampleLocationCoordinateRange[0] && position.y <= properties.sampleLocationCoordinateRange[1],
+                "stencil sample position outside device coordinate range");
+        positions[i] = position;
+    }
+    Require(extent.width && extent.height && extent.width <= context.limits.maxFramebufferWidth &&
+            extent.height <= context.limits.maxFramebufferHeight && extent.width <= context.limits.maxViewportDimensions[0] &&
+            extent.height <= context.limits.maxViewportDimensions[1], "stencil sample transfer extent is unsupported");
+    logicalBytes = std::uint64_t(extent.width) * extent.height * samples;
+    Require(logicalBytes <= std::numeric_limits<std::uint32_t>::max() - 3u, "stencil sample transfer indexing overflows");
+    packedBytes = (logicalBytes + 3u) & ~VkDeviceSize(3u);
+    Require(packedBytes <= context.limits.maxStorageBufferRange, "stencil sample transfer exceeds storage buffer range");
+    Require(context.limits.maxPushConstantsSize >= 20 && context.limits.maxPerStageDescriptorStorageBuffers >= 1 &&
+            context.limits.maxPerStageDescriptorSampledImages >= 1 && context.limits.maxDescriptorSetStorageBuffers >= 1 &&
+            context.limits.maxDescriptorSetSampledImages >= 1, "stencil sample transfer descriptor/push limits are unsupported");
+    Require(context.limits.maxComputeWorkGroupSize[0] >= 64 && context.limits.maxComputeWorkGroupInvocations >= 64 &&
+            (packedBytes / 4u + 63u) / 64u <= context.limits.maxComputeWorkGroupCount[0], "stencil sample transfer compute limits are unsupported");
+    Require(context.formatProperties && context.imageFormatProperties, "stencil sample transfer format queries are unavailable");
+    VkFormatProperties formatSupport{};
+    context.formatProperties(context.physical, format, &formatSupport);
+    constexpr VkFormatFeatureFlags features = VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+    Require((formatSupport.optimalTilingFeatures & features) == features, "stencil sample transfer image format features are unavailable");
+    VkImageFormatProperties imageSupport{};
+    Check(context.imageFormatProperties(context.physical, format, VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL,
+        VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT,
+        VK_IMAGE_CREATE_SAMPLE_LOCATIONS_COMPATIBLE_DEPTH_BIT_EXT, &imageSupport), "stencil sample transfer image format query");
+    Require((imageSupport.sampleCounts & nativeSamples) != 0 && imageSupport.maxArrayLayers >= groups &&
+            imageSupport.maxExtent.width >= extent.width && imageSupport.maxExtent.height >= extent.height,
+            "stencil sample transfer image format limits are unsupported");
+    // Resolve destructors before making anything: partial-construction cleanup cannot fail
+    // because a later vkGetDeviceProcAddr lookup happens to be absent.
+    destroyImageView = context.Function<PFN_vkDestroyImageView>("vkDestroyImageView");
+    destroyFramebuffer = context.Function<PFN_vkDestroyFramebuffer>("vkDestroyFramebuffer");
+    destroyRenderPass = context.Function<PFN_vkDestroyRenderPass>("vkDestroyRenderPass");
+    destroyPipeline = context.Function<PFN_vkDestroyPipeline>("vkDestroyPipeline");
+    destroyPipelineLayout = context.Function<PFN_vkDestroyPipelineLayout>("vkDestroyPipelineLayout");
+    destroyDescriptorSetLayout = context.Function<PFN_vkDestroyDescriptorSetLayout>("vkDestroyDescriptorSetLayout");
+    destroyDescriptorPool = context.Function<PFN_vkDestroyDescriptorPool>("vkDestroyDescriptorPool");
+    try {
+        VkImageViewCreateInfo viewInfo{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        viewInfo.image = image;
+        viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+        viewInfo.format = format;
+        viewInfo.subresourceRange = {VK_IMAGE_ASPECT_STENCIL_BIT, 0, 1, 0, groups};
+        Check(context.Function<PFN_vkCreateImageView>("vkCreateImageView")(context.device, &viewInfo, nullptr, &sampledView), "vkCreateImageView stencil samples");
+        // All target/capability/position validation above runs even on a warm key.
+        programOwner = context.stencilSamplePrograms != nullptr ?
+            context.stencilSamplePrograms->Acquire(context,format,samples,guestPositions) :
+            std::make_shared<StencilSamplePrograms>(context,format,samples,guestPositions);
+        renderPass=programOwner->renderPass;uploadPipelines=programOwner->uploadPipelines;
+        readbackPipeline=programOwner->readbackPipeline;uploadDescriptors=programOwner->uploadDescriptors;
+        readbackDescriptors=programOwner->readbackDescriptors;uploadLayout=programOwner->uploadLayout;readbackLayout=programOwner->readbackLayout;
+        for (std::uint32_t group = 0; group < groups; ++group) {
+            const auto view = groupAttachments[group];
+            VkFramebufferCreateInfo framebufferInfo{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+            framebufferInfo.renderPass = renderPass;
+            framebufferInfo.attachmentCount = 1;
+            framebufferInfo.pAttachments = &view;
+            framebufferInfo.width = extent.width;
+            framebufferInfo.height = extent.height;
+            framebufferInfo.layers = 1;
+            Check(context.Function<PFN_vkCreateFramebuffer>("vkCreateFramebuffer")(context.device, &framebufferInfo, nullptr, &framebuffers[group]), "vkCreateFramebuffer stencil sample group");
+        }
+    } catch (...) { release(); throw; }
+}
+StencilSampleTransfer::~StencilSampleTransfer() { release(); }
+void StencilSampleTransfer::release() noexcept {
+    for (const auto pool : retainedPools) destroyDescriptorPool(context.device, pool, nullptr);
+    for (const auto framebuffer : framebuffers) if (framebuffer) destroyFramebuffer(context.device, framebuffer, nullptr);
+    if (sampledView) destroyImageView(context.device, sampledView, nullptr);
+    programOwner.reset();
+}
+void StencilSampleTransfer::validateBuffer(const ColorSampleBufferAccess& buffer) const {
+    Require(buffer.buffer != VK_NULL_HANDLE && buffer.bytes >= packedBytes && buffer.stage != 0,
+            "stencil sample transfer buffer/range/state is unavailable");
+    const auto alignment = std::max<VkDeviceSize>(4, context.limits.minStorageBufferOffsetAlignment);
+    Require(buffer.offset % alignment == 0 && buffer.offset <= std::numeric_limits<VkDeviceSize>::max() - packedBytes,
+            "stencil sample transfer buffer offset is invalid");
+}
+void StencilSampleTransfer::validateImage(ColorSampleImageAccess state) const {
+    Require(state.stage != 0 && (state.layout == VK_IMAGE_LAYOUT_GENERAL ||
+            state.layout == VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL ||
+            state.layout == VK_IMAGE_LAYOUT_DEPTH_STENCIL_READ_ONLY_OPTIMAL ||
+            state.layout == VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL ||
+            state.layout == VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL || state.layout == VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL),
+            "stencil sample transfer image stage/layout is unsupported");
+    // UNDEFINED would discard Z, violating this transfer's preservation contract.
+}
+VkSampleLocationsInfoEXT StencilSampleTransfer::locations(std::uint32_t group) const {
+    return {VK_STRUCTURE_TYPE_SAMPLE_LOCATIONS_INFO_EXT, nullptr, static_cast<VkSampleCountFlagBits>(nativeSamples),
+        {1, 1}, nativeSamples, positions.data() + group * nativeSamples};
+}
+void StencilSampleTransfer::imageBarrier(PFN_vkCmdPipelineBarrier barrier, VkCommandBuffer commands,
+    ColorSampleImageAccess before, ColorSampleImageAccess after) const {
+    for (std::uint32_t group = 0; group < groups; ++group) {
+        const auto pattern = locations(group);
+        VkImageMemoryBarrier transition{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+        transition.pNext = &pattern;
+        transition.srcAccessMask = before.access;
+        transition.dstAccessMask = after.access;
+        transition.oldLayout = before.layout;
+        transition.newLayout = after.layout;
+        transition.srcQueueFamilyIndex = transition.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        transition.image = image;
+        transition.subresourceRange = {VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, 0, 1, group, 1};
+        barrier(commands, before.stage, after.stage, 0, 0, nullptr, 0, nullptr, 1, &transition);
+    }
+}
+VkDescriptorSet StencilSampleTransfer::descriptor(bool upload, const ColorSampleBufferAccess& buffer) {
+    // Resolve every fallible host operation before recording any GPU commands.
+    const auto createPool = context.Function<PFN_vkCreateDescriptorPool>("vkCreateDescriptorPool");
+    const auto allocateSet = context.Function<PFN_vkAllocateDescriptorSets>("vkAllocateDescriptorSets");
+    const auto updateSet = context.Function<PFN_vkUpdateDescriptorSets>("vkUpdateDescriptorSets");
+    const std::array<VkDescriptorPoolSize, 2> sizes{{{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1}, {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1}}};
+    VkDescriptorPoolCreateInfo poolInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    poolInfo.maxSets = 1;
+    poolInfo.poolSizeCount = upload ? 1 : 2;
+    poolInfo.pPoolSizes = sizes.data();
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    Check(createPool(context.device, &poolInfo, nullptr, &pool), "vkCreateDescriptorPool stencil sample transfer");
+    try {
+        const auto layout = upload ? uploadDescriptors : readbackDescriptors;
+        VkDescriptorSetAllocateInfo allocation{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        allocation.descriptorPool = pool;
+        allocation.descriptorSetCount = 1;
+        allocation.pSetLayouts = &layout;
+        VkDescriptorSet set = VK_NULL_HANDLE;
+        Check(allocateSet(context.device, &allocation, &set), "vkAllocateDescriptorSets stencil sample transfer");
+        const VkDescriptorBufferInfo bufferInfo{buffer.buffer, buffer.offset, packedBytes};
+        const VkDescriptorImageInfo imageInfo{VK_NULL_HANDLE, sampledView, ReadbackAccess.layout};
+        std::array<VkWriteDescriptorSet, 2> writes{};
+        writes[0].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+        writes[0].dstSet = set;
+        writes[0].dstBinding = upload ? 0 : 1;
+        writes[0].descriptorCount = 1;
+        writes[0].descriptorType = VK_DESCRIPTOR_TYPE_STORAGE_BUFFER;
+        writes[0].pBufferInfo = &bufferInfo;
+        if (!upload) {
+            writes[1].sType = VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET;
+            writes[1].dstSet = set;
+            writes[1].dstBinding = 0;
+            writes[1].descriptorCount = 1;
+            writes[1].descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE;
+            writes[1].pImageInfo = &imageInfo;
+        }
+        updateSet(context.device, upload ? 1u : 2u, writes.data(), 0, nullptr);
+        retainedPools.push_back(pool);
+        return set;
+    } catch (...) { destroyDescriptorPool(context.device, pool, nullptr); throw; }
+}
+void StencilSampleTransfer::RecordUpload(VkCommandBuffer commands, const ColorSampleBufferAccess& source,
+                                     ColorSampleImageAccess before, ColorSampleImageAccess after) {
+    Require(commands != VK_NULL_HANDLE, "stencil sample transfer command buffer is unavailable");
+    validateBuffer(source); validateImage(before); validateImage(after);
+    const auto barrier = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto begin = context.Resolved(&DeviceFunctions::cmdBeginRenderPass, "vkCmdBeginRenderPass");
+    const auto end = context.Resolved(&DeviceFunctions::cmdEndRenderPass, "vkCmdEndRenderPass");
+    const auto bind = context.Resolved(&DeviceFunctions::cmdBindPipeline, "vkCmdBindPipeline");
+    const auto bindSet = context.Resolved(&DeviceFunctions::cmdBindDescriptorSets, "vkCmdBindDescriptorSets");
+    const auto push = context.Resolved(&DeviceFunctions::cmdPushConstants, "vkCmdPushConstants");
+    const auto viewport = context.Resolved(&DeviceFunctions::cmdSetViewport, "vkCmdSetViewport");
+    const auto scissor = context.Resolved(&DeviceFunctions::cmdSetScissor, "vkCmdSetScissor");
+    const auto draw = context.Resolved(&DeviceFunctions::cmdDraw, "vkCmdDraw");
+    const auto writeMask = context.Function<PFN_vkCmdSetStencilWriteMask>("vkCmdSetStencilWriteMask");
+    const auto clear = context.Function<PFN_vkCmdClearDepthStencilImage>("vkCmdClearDepthStencilImage");
+    const auto set = descriptor(true, source);
+    BufferBarrier(barrier, commands, source, packedBytes, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+    imageBarrier(barrier, commands, before, ClearAccess);
+    const VkClearDepthStencilValue clearValue{0.0f, 0u};
+    const VkImageSubresourceRange range{VK_IMAGE_ASPECT_STENCIL_BIT, 0, 1, 0, groups};
+    clear(commands, image, VK_IMAGE_LAYOUT_GENERAL, &clearValue, 1, &range);
+    imageBarrier(barrier, commands, ClearAccess, AttachmentAccess);
+    const VkViewport viewportValue{0, 0, float(extent.width), float(extent.height), 0, 1};
+    const VkRect2D scissorValue{{0, 0}, extent};
+    for (std::uint32_t group = 0; group < groups; ++group) {
+        VkRenderPassBeginInfo pass{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+        const auto pattern = locations(group);
+        const VkAttachmentSampleLocationsEXT initial{0, pattern};
+        const VkSubpassSampleLocationsEXT final{0, pattern};
+        VkRenderPassSampleLocationsBeginInfoEXT passLocations{VK_STRUCTURE_TYPE_RENDER_PASS_SAMPLE_LOCATIONS_BEGIN_INFO_EXT};
+        passLocations.attachmentInitialSampleLocationsCount = 1;
+        passLocations.pAttachmentInitialSampleLocations = &initial;
+        passLocations.postSubpassSampleLocationsCount = 1;
+        passLocations.pPostSubpassSampleLocations = &final;
+        pass.pNext = &passLocations;
+        pass.renderPass = renderPass;
+        pass.framebuffer = framebuffers[group];
+        pass.renderArea = scissorValue;
+        begin(commands, &pass, VK_SUBPASS_CONTENTS_INLINE);
+        viewport(commands, 0, 1, &viewportValue);
+        scissor(commands, 0, 1, &scissorValue);
+        bindSet(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, uploadLayout, 0, 1, &set, 0, nullptr);
+        for (std::uint32_t sample = 0; sample < nativeSamples; ++sample) {
+            bind(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, uploadPipelines[group][sample]);
+            for (std::uint32_t bit = 0; bit < 8u; ++bit) {
+                writeMask(commands, VK_STENCIL_FACE_FRONT_AND_BACK, 1u << bit);
+                const std::array<std::uint32_t, 5> parameters{extent.width, extent.height, samples, group * nativeSamples + sample, bit};
+                push(commands, uploadLayout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(parameters), parameters.data());
+                draw(commands, 3, 1, 0, 0);
+            }
+        }
+        end(commands);
+    }
+    imageBarrier(barrier, commands, AttachmentAccess, after);
+}
+void StencilSampleTransfer::RecordReadback(VkCommandBuffer commands, const ColorSampleBufferAccess& outputBefore,
+                                       ColorSampleImageAccess before, ColorSampleImageAccess after,
+                                       VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess) {
+    Require(commands != VK_NULL_HANDLE && consumerStage != 0, "stencil sample readback command/consumer stage is unavailable");
+    validateBuffer(outputBefore); validateImage(before); validateImage(after);
+    const auto barrier = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto bind = context.Resolved(&DeviceFunctions::cmdBindPipeline, "vkCmdBindPipeline");
+    const auto bindSet = context.Resolved(&DeviceFunctions::cmdBindDescriptorSets, "vkCmdBindDescriptorSets");
+    const auto push = context.Resolved(&DeviceFunctions::cmdPushConstants, "vkCmdPushConstants");
+    const auto dispatch = context.Resolved(&DeviceFunctions::cmdDispatch, "vkCmdDispatch");
+    const auto set = descriptor(false, outputBefore);
+    BufferBarrier(barrier, commands, outputBefore, packedBytes, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT);
+    imageBarrier(barrier, commands, before, ReadbackAccess);
+    bind(commands, VK_PIPELINE_BIND_POINT_COMPUTE, readbackPipeline);
+    bindSet(commands, VK_PIPELINE_BIND_POINT_COMPUTE, readbackLayout, 0, 1, &set, 0, nullptr);
+    const std::array<std::uint32_t, 5> parameters{extent.width, extent.height, samples, nativeSamples, static_cast<std::uint32_t>(logicalBytes)};
+    push(commands, readbackLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(parameters), parameters.data());
+    dispatch(commands, static_cast<std::uint32_t>((packedBytes / 4u + 63u) / 64u), 1, 1);
+    const ColorSampleBufferAccess written{outputBefore.buffer, outputBefore.offset, packedBytes,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT};
+    BufferBarrier(barrier, commands, written, packedBytes, consumerStage, consumerAccess);
+    imageBarrier(barrier, commands, ReadbackAccess, after);
+}
+}
