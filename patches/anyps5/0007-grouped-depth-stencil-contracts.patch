@@ -0,0 +1,62 @@
+#ifndef ANYPS5_GPU_STENCIL_SAMPLE_TILER_HPP
+#define ANYPS5_GPU_STENCIL_SAMPLE_TILER_HPP
+#include "prx/libSceAgcDriver/Graphics/include/State.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/DepthTargetLayout.hpp"
+#include <mutex>
+
+namespace AgcDriver::Graphics {
+// Full-buffer storage views created on the stated device. The caller owns the
+// buffers, supplies their real usage/state, and retains them until completion.
+struct StencilSampleTilingBufferAccess {
+    VkDevice device = VK_NULL_HANDLE;
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceSize offset = 0, bytes = 0;
+    VkPipelineStageFlags stage = 0;
+    VkAccessFlags access = 0;
+};
+
+// One device owns two immutable programs, Detile and Retile. No guest state is
+// cached. Only uncompressed S8, SW_64KB_Z_X and eight stored samples are qualified.
+// The caller must supply an already decoded single-mip/slice depth target; the
+// existing grouped-draw Z/HTILE/alias guards remain mandatory and unchanged.
+class GpuStencilSampleTiler {
+public:
+    explicit GpuStencilSampleTiler(const Context& context);
+    ~GpuStencilSampleTiler();
+    GpuStencilSampleTiler(const GpuStencilSampleTiler&) = delete;
+    GpuStencilSampleTiler& operator=(const GpuStencilSampleTiler&) = delete;
+    static bool Supports(const Context& context, const DepthTarget& depth, DepthLayoutParameters parameters = {.samples=8, .fragments=8});
+    class Transfer {
+    public:
+        Transfer(GpuStencilSampleTiler& owner, const DepthTarget& depth, DepthLayoutParameters parameters = {.samples=8, .fragments=8});
+        ~Transfer();
+        Transfer(const Transfer&) = delete;
+        Transfer& operator=(const Transfer&) = delete;
+        // Retile preserves every padding word of the destination's prior seed.
+        // Each call retains distinct descriptors until this Transfer is destroyed.
+        // The owner and both buffers must outlive this Transfer and its GPU fence.
+        void Record(VkCommandBuffer commands, bool retile,
+                    StencilSampleTilingBufferAccess source, StencilSampleTilingBufferAccess destination,
+                    VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess);
+    private:
+        GpuStencilSampleTiler& owner;
+        std::array<std::uint32_t, 5> parameters;
+        std::vector<VkDescriptorPool> pools;
+    };
+private:
+    void release() noexcept;
+    VkPipeline program(bool retile);
+    Context context;
+    VkShaderModule module = VK_NULL_HANDLE;
+    VkDescriptorSetLayout descriptors = VK_NULL_HANDLE;
+    VkPipelineLayout layout = VK_NULL_HANDLE;
+    std::array<VkPipeline, 2> programs{};
+    std::mutex programsMutex;
+    PFN_vkDestroyShaderModule destroyModule = nullptr;
+    PFN_vkDestroyDescriptorSetLayout destroyDescriptors = nullptr;
+    PFN_vkDestroyPipelineLayout destroyLayout = nullptr;
+    PFN_vkDestroyPipeline destroyPipeline = nullptr;
+    PFN_vkDestroyDescriptorPool destroyPool = nullptr;
+};
+}
+#endif
diff --git a/core/libs/prx/libSceAgcDriver/Graphics/include/StencilSampleTransfer.hpp b/core/libs/prx/libSceAgcDriver/Graphics/include/StencilSampleTransfer.hpp
