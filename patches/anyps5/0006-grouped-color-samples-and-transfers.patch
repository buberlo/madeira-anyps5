+    const VkViewport viewportValue{0, 0, float(extent.width), float(extent.height), 0, 1};
+    const VkRect2D scissorValue{{0, 0}, extent};
+    for (std::uint32_t group = 0; group < target.Groups(); ++group) {
+        VkRenderPassBeginInfo pass{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+        pass.renderPass = renderPass;
+        pass.framebuffer = framebuffers[group];
+        pass.renderArea = scissorValue;
+        begin(commands, &pass, VK_SUBPASS_CONTENTS_INLINE);
+        viewport(commands, 0, 1, &viewportValue);
+        scissor(commands, 0, 1, &scissorValue);
+        bindSet(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, uploadLayout, 0, 1, &set, 0, nullptr);
+        for (std::uint32_t sample = 0; sample < nativeSamples; ++sample) {
+            bind(commands, VK_PIPELINE_BIND_POINT_GRAPHICS, uploadPipelines[sample]);
+            const std::array<std::uint32_t, 4> parameters{extent.width, extent.height, samples, group * nativeSamples + sample};
+            push(commands, uploadLayout, VK_SHADER_STAGE_FRAGMENT_BIT, 0, sizeof(parameters), parameters.data());
+            draw(commands, 3, 1, 0, 0);
+        }
+        end(commands);
+    }
+    ImageBarrier(barrier, commands, target, AttachmentAccess, after);
+}
+void ColorSampleTransfer::RecordReadback(VkCommandBuffer commands, const ColorSampleBufferAccess& outputBefore,
+                                       ColorSampleImageAccess before, ColorSampleImageAccess after,
+                                       VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess) {
+    Require(commands != VK_NULL_HANDLE && consumerStage != 0, "color sample readback command/consumer stage is unavailable");
+    validateBuffer(outputBefore); validateImage(before, false); validateImage(after, false);
+    const auto barrier = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto bind = context.Resolved(&DeviceFunctions::cmdBindPipeline, "vkCmdBindPipeline");
+    const auto bindSet = context.Resolved(&DeviceFunctions::cmdBindDescriptorSets, "vkCmdBindDescriptorSets");
+    const auto push = context.Resolved(&DeviceFunctions::cmdPushConstants, "vkCmdPushConstants");
+    const auto dispatch = context.Resolved(&DeviceFunctions::cmdDispatch, "vkCmdDispatch");
+    const auto set = descriptor(false, outputBefore);
+    BufferBarrier(barrier, commands, outputBefore, packedBytes, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT);
+    ImageBarrier(barrier, commands, target, before, ReadbackAccess);
+    bind(commands, VK_PIPELINE_BIND_POINT_COMPUTE, readbackPipeline);
+    bindSet(commands, VK_PIPELINE_BIND_POINT_COMPUTE, readbackLayout, 0, 1, &set, 0, nullptr);
+    const std::array<std::uint32_t, 4> parameters{extent.width, extent.height, samples, nativeSamples};
+    push(commands, readbackLayout, VK_SHADER_STAGE_COMPUTE_BIT, 0, sizeof(parameters), parameters.data());
+    dispatch(commands, (extent.width + 7u) / 8u, (extent.height + 7u) / 8u, 1);
+    const ColorSampleBufferAccess written{outputBefore.buffer, outputBefore.offset, packedBytes,
+        VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_SHADER_WRITE_BIT};
+    BufferBarrier(barrier, commands, written, packedBytes, consumerStage, consumerAccess);
+    ImageBarrier(barrier, commands, target, ReadbackAccess, after);
+}
+}
