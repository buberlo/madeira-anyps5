+};
+
+inline constexpr const ColorSampleSwizzleEquation* FindColorSampleSwizzleEquation(std::uint32_t bytes, std::uint32_t samples) {
+    for (const auto& equation : kColorSampleSwizzleEquations) {
+        if (equation.elementBytes == bytes && equation.samples == samples) return &equation;
+    }
+    return nullptr;
+}
