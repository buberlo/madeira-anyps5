+#ifndef CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_COLORSAMPLETRANSFER_HPP
+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_COLORSAMPLETRANSFER_HPP
+
+#include "prx/libSceAgcDriver/Graphics/include/Resources.hpp"
+
+namespace AgcDriver::Graphics {
+
+// Explicit state on this Context's queue. Queue ownership transfers and concurrent recording
+// are not supported. Buffer offsets are byte offsets; each packed word is little-endian RGBA8.
+struct ColorSampleBufferAccess {
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceSize offset = 0;
+    VkDeviceSize bytes = 0;
+    VkPipelineStageFlags stage = 0;
+    VkAccessFlags access = 0;
+};
+struct ColorSampleImageAccess {
+    VkImageLayout layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    VkPipelineStageFlags stage = 0;
+    VkAccessFlags access = 0;
+};
+
+// A full-image, exact-sample RGBA8_UNORM transfer. Logical sample i is array layer
+// i/nativeSamples, native sample i%nativeSamples. Samples 2/4/8 are supported; single-sample
+// targets keep the existing copy path. No resolve, averaging, or sample-rate shading is used.
+// Keep this object, its RenderTarget, and all recorded buffers alive until their GPU fence has
+// completed. Each call retains a distinct descriptor pool, so a later call cannot rewrite a
+// pending call's bindings. Recording replaces pipeline/descriptor/viewport/scissor state.
+class ColorSampleTransfer {
+public:
+    ColorSampleTransfer(const Context& context, RenderTarget& target, const ColorTarget& color);
+    ~ColorSampleTransfer();
+    ColorSampleTransfer(const ColorSampleTransfer&) = delete;
+    ColorSampleTransfer& operator=(const ColorSampleTransfer&) = delete;
+    VkDeviceSize PackedBytes() const { return packedBytes; }
+    void RecordUpload(VkCommandBuffer commands, const ColorSampleBufferAccess& source,
+                      ColorSampleImageAccess before, ColorSampleImageAccess after);
+    // The output's prior state is supplied separately from its intended consumer state.
+    // This makes using one host-visible storage buffer for upload then readback explicit.
+    void RecordReadback(VkCommandBuffer commands, const ColorSampleBufferAccess& outputBefore,
+                        ColorSampleImageAccess before, ColorSampleImageAccess after,
+                        VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess);
+private:
+    void release() noexcept;
+    void validateBuffer(const ColorSampleBufferAccess& buffer) const;
+    void validateImage(ColorSampleImageAccess state, bool allowUndefined) const;
+    VkDescriptorSet descriptor(bool upload, const ColorSampleBufferAccess& buffer);
+    Context context;
+    RenderTarget& target;
+    VkExtent2D extent;
+    std::uint32_t samples;
+    std::uint32_t nativeSamples;
+    VkDeviceSize packedBytes;
+    VkRenderPass renderPass = VK_NULL_HANDLE;
+    std::array<VkFramebuffer, 2> framebuffers{};
+    std::array<VkPipeline, 4> uploadPipelines{};
+    VkPipeline readbackPipeline = VK_NULL_HANDLE;
+    VkDescriptorSetLayout uploadDescriptors = VK_NULL_HANDLE;
+    VkDescriptorSetLayout readbackDescriptors = VK_NULL_HANDLE;
+    VkPipelineLayout uploadLayout = VK_NULL_HANDLE;
+    VkPipelineLayout readbackLayout = VK_NULL_HANDLE;
+    std::vector<VkDescriptorPool> retainedPools;
+    PFN_vkDestroyFramebuffer destroyFramebuffer = nullptr;
+    PFN_vkDestroyRenderPass destroyRenderPass = nullptr;
+    PFN_vkDestroyPipeline destroyPipeline = nullptr;
+    PFN_vkDestroyPipelineLayout destroyPipelineLayout = nullptr;
+    PFN_vkDestroyDescriptorSetLayout destroyDescriptorSetLayout = nullptr;
+    PFN_vkDestroyDescriptorPool destroyDescriptorPool = nullptr;
+};
+}
+#endif
