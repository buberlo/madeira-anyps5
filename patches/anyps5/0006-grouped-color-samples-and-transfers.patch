+#ifndef ANYPS5_COLOR_SAMPLE_SNAPSHOT_COPY_HPP
+#define ANYPS5_COLOR_SAMPLE_SNAPSHOT_COPY_HPP
+#include "prx/libSceAgcDriver/Graphics/include/GpuColorSampleTiler.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/Resources.hpp"
+
+namespace AgcDriver::Graphics {
+bool ColorSampleStagingCopyEnabled();
+
+// One synchronous draw owns both coherent buffers. The baseline is never a
+// GPU destination, and remains immutable through fence/fault checks and the
+// final changed-byte commit. A full GPU copy seeds every result padding byte.
+class ColorSampleSnapshotCopy {
+public:
+    using Reader = void (*)(std::uint64_t, std::span<std::byte>, std::size_t);
+    ColorSampleSnapshotCopy(const Context& context, const ColorTarget& color, Reader read);
+    ColorSampleSnapshotCopy(const ColorSampleSnapshotCopy&) = delete;
+    ColorSampleSnapshotCopy& operator=(const ColorSampleSnapshotCopy&) = delete;
+    std::span<const std::byte> Original() const;
+    std::span<const std::byte> Result() const;
+    void RecordSeed(VkCommandBuffer commands);
+    ColorSampleTilingBufferAccess DetileSource() const;
+    ColorSampleTilingBufferAccess RetileDestination() const;
+private:
+    Context context;
+    std::unique_ptr<Buffer> baseline;
+    std::unique_ptr<Buffer> result;
+    bool seeded = false;
+};
+}
+#endif
