diff --git a/rebase/0006-grouped-color-samples-and-transfers/after/core/libs/prx/libSceAgcDriver/Graphics/shaders/ColorResolve.frag b/core/libs/prx/libSceAgcDriver/Graphics/shaders/ColorResolve.frag
