index 0000000..6389d3e
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/shaders/ColorSamplePixelOwnedTiling.comp
@@ -0,0 +1,80 @@
+#version 450
+
+// Original pixel-owned8 RGBA8, R64KB_X, samples==fragments compute transfer.
+// One XY invocation owns all eight complete uint words of a logical pixel.
+// Exact Navi1x color sample equations are supplied as immutable specialization
+// values, not guest-controlled data.
+layout(constant_id = 0) const uint SAMPLES = 8u;
+layout(constant_id = 1) const uint RETILE = 0u;
+layout(constant_id = 2) const uint BLOCK_WIDTH = 32u;
+layout(constant_id = 3) const uint BLOCK_HEIGHT = 64u;
+layout(constant_id = 4) const uint EQ0 = 0u;
+layout(constant_id = 5) const uint EQ1 = 0u;
+layout(constant_id = 6) const uint EQ2 = 0u;
+layout(constant_id = 7) const uint EQ3 = 0u;
+layout(constant_id = 8) const uint EQ4 = 0u;
+layout(constant_id = 9) const uint EQ5 = 0u;
+layout(constant_id = 10) const uint EQ6 = 0u;
+layout(constant_id = 11) const uint EQ7 = 0u;
+layout(constant_id = 12) const uint EQ8 = 0u;
+layout(constant_id = 13) const uint EQ9 = 0u;
+layout(constant_id = 14) const uint EQ10 = 0u;
+layout(constant_id = 15) const uint EQ11 = 0u;
+layout(constant_id = 16) const uint EQ12 = 0u;
+layout(constant_id = 17) const uint EQ13 = 0u;
+layout(constant_id = 18) const uint EQ14 = 0u;
+layout(constant_id = 19) const uint EQ15 = 0u;
+
+layout(constant_id = 20) const uint SAMPLE_XOR0 = 0x4000u;
+layout(constant_id = 21) const uint SAMPLE_XOR1 = 0x8000u;
+layout(constant_id = 22) const uint SAMPLE_XOR2 = 0x0800u;
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+layout(set = 0, binding = 0, std430) readonly buffer Input { uint words[]; } source;
+layout(set = 0, binding = 1, std430) writeonly buffer Output { uint words[]; } destination;
+layout(push_constant) uniform Parameters {
+    uint width;
+    uint height;
+    uint blocksPerRow;
+    uint tiledWords;
+    uint linearWords;
+} parameters;
+
+uint sampleOffset(uvec2 pixel, uint sampleIndex) {
+    const uint equations[16] = uint[16](EQ0, EQ1, EQ2, EQ3, EQ4, EQ5, EQ6, EQ7,
+                                       EQ8, EQ9, EQ10, EQ11, EQ12, EQ13, EQ14, EQ15);
+    uint result = 0u;
+    for (uint bit = 0u; bit < 16u; ++bit) {
+        uint mask = equations[bit];
+        // Separate coordinate masks prevent x>=4096 spilling into Y bits,
+        // and y>=4096 spilling into the logical sample bits.
+        uint selected = (pixel.x & mask & 0xfffu) ^
+                        ((pixel.y << 12u) & mask & 0xfff000u) ^
+                        ((sampleIndex << 24u) & mask & 0xff000000u);
+        result |= (bitCount(selected) & 1u) << bit;
+    }
+    uint block = (pixel.y / BLOCK_HEIGHT) * parameters.blocksPerRow + pixel.x / BLOCK_WIDTH;
+    return block * 65536u + result;
+}
+
+void main() {
+    uvec2 pixel = gl_GlobalInvocationID.xy;
+    // The host dispatches Z=1. This guard also prevents duplicate writers if
+    // an invalid Z count is accidentally supplied; it does not qualify that count.
+    if (pixel.x >= parameters.width || pixel.y >= parameters.height ||
+        gl_GlobalInvocationID.z != 0u || SAMPLES != 8u) return;
+    uint pixelWord = (pixel.y * parameters.width + pixel.x) * 8u;
+    uint sampleZeroOffset = sampleOffset(pixel, 0u);
+    for (uint sampleIndex = 0u; sampleIndex < 8u; ++sampleIndex) {
+        uint sampleXor = ((sampleIndex & 1u) != 0u ? SAMPLE_XOR0 : 0u) ^
+                         ((sampleIndex & 2u) != 0u ? SAMPLE_XOR1 : 0u) ^
+                         ((sampleIndex & 4u) != 0u ? SAMPLE_XOR2 : 0u);
+        // Every sample mask is below 64KiB. The aligned macroblock base is
+        // unchanged, while within-block sample parity follows the exact equation.
+        uint tiledWord = (sampleZeroOffset ^ sampleXor) / 4u;
+        uint linearWord = pixelWord + sampleIndex;
+        if (linearWord >= parameters.linearWords || tiledWord >= parameters.tiledWords) continue;
+        if (RETILE == 0u) destination.words[linearWord] = source.words[tiledWord];
+        else destination.words[tiledWord] = source.words[linearWord];
+    }
+}
