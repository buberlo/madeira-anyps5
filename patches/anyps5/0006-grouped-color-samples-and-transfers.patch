+    {2u, 2u, 128u, 128u, {0x00000000u, 0x00000001u, 0x00000002u, 0x00000004u, 0x00001000u, 0x00002000u, 0x00004000u, 0x00000008u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00010000u, 0x00000040u, 0x00040000u, 0x01080000u}},
+    {2u, 4u, 128u, 64u, {0x00000000u, 0x00000001u, 0x00000002u, 0x00000004u, 0x00001000u, 0x00002000u, 0x00004000u, 0x00000008u, 0x00008008u, 0x00010010u, 0x00020040u, 0x00040020u, 0x00010000u, 0x00000040u, 0x01040000u, 0x02080000u}},
