+#version 450
+layout(set = 0, binding = 0, std430) readonly buffer Packed { uint values[]; } source;
+layout(push_constant) uniform Parameters { uint width; uint height; uint samples; uint logicalSample; } parameters;
+layout(location = 0) out vec4 color;
