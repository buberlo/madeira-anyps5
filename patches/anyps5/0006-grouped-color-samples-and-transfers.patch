+bool PixelOwned8Enabled() {
+    const char* value = std::getenv("APS5_GPU_COLOR_SAMPLE_PIXEL_OWNED");
+    return value && std::string_view(value) == "1";
+}
+std::array<std::uint32_t, 5> Parameters(const Context& context, const ColorTarget& color) {
+    Require(context.device != VK_NULL_HANDLE && color.format == VK_FORMAT_R8G8B8A8_UNORM &&
+        color.elementBytes == 4 && color.tileMode == ColorTileMode::RenderTarget &&
+        (color.samples == 2 || color.samples == 4 || color.samples == 8) && color.fragments == color.samples,
+        "GPU sample tiling requires RGBA8 R64KB_X and equal 2/4/8 samples/fragments");
+    Require(color.pipeBankXor == 0, "GPU sample tiling does not implement pipe/bank XOR; use the CPU layout");
+    Require(color.dccAddress == 0 && color.cmaskAddress == 0 && color.cmaskBytes == 0 &&
+        color.mipCount == 1 && color.mip == 0 && !color.mipTail && color.depth == 1 && color.depthSlice == 0 &&
+        (color.surfaceAddress == 0 || color.surfaceAddress == color.address) &&
+        ((color.surfaceExtent.width == 0 && color.surfaceExtent.height == 0) ||
+         (color.surfaceExtent.width == color.extent.width && color.surfaceExtent.height == color.extent.height)),
+        "GPU sample tiling requires an uncompressed, full single-mip 2D surface");
+    const ColorTargetLayout layout(color.extent.width, color.extent.height, color.tileMode, color.elementBytes, color.pipeBankXor, color.samples);
+    const auto* equation = FindColorSampleSwizzleEquation(4, color.samples);
+    Require(equation && layout.Alignment() == 65536 && layout.BlocksPerRow() ==
+        (color.extent.width + equation->blockWidth - 1u) / equation->blockWidth,
+        "GPU sample tiling layout/equation mismatch");
+    const auto expectedBytes = std::uint64_t(layout.BlocksPerRow()) *
+        ((color.extent.height + equation->blockHeight - 1u) / equation->blockHeight) * 65536u;
+    Require(color.bytes == layout.Bytes() && expectedBytes == layout.Bytes() &&
+        color.address % layout.Alignment() == 0 && color.address <= std::numeric_limits<std::uint64_t>::max() - color.bytes,
+        "GPU sample tiling guest range/layout mismatch");
+    // The shader's byte offset and packed word arithmetic are both uint32_t.
+    Require(layout.Bytes() <= std::numeric_limits<std::uint32_t>::max() &&
+        layout.LinearBytes() <= std::numeric_limits<std::uint32_t>::max() &&
+        layout.Bytes() <= context.limits.maxStorageBufferRange && layout.LinearBytes() <= context.limits.maxStorageBufferRange,
+        "GPU sample tiling exceeds storage/index limits");
+    Require(context.limits.maxPushConstantsSize >= 20 && context.limits.maxBoundDescriptorSets >= 1 &&
+        context.limits.maxPerStageDescriptorStorageBuffers >= 2 && context.limits.maxDescriptorSetStorageBuffers >= 2 &&
+        context.limits.maxPerStageResources >= 2, "GPU sample tiling descriptor/push limits are unsupported");
+    Require(context.limits.maxComputeWorkGroupSize[0] >= 8 && context.limits.maxComputeWorkGroupSize[1] >= 8 &&
+        context.limits.maxComputeWorkGroupSize[2] >= 1 && context.limits.maxComputeWorkGroupInvocations >= 64 &&
+        (color.extent.width + 7u) / 8u <= context.limits.maxComputeWorkGroupCount[0] &&
+        (color.extent.height + 7u) / 8u <= context.limits.maxComputeWorkGroupCount[1] &&
+        color.samples <= context.limits.maxComputeWorkGroupCount[2], "GPU sample tiling compute limits are unsupported");
+    return {color.extent.width, color.extent.height, layout.BlocksPerRow(),
+        static_cast<std::uint32_t>(layout.Bytes() / 4u), static_cast<std::uint32_t>(layout.LinearBytes() / 4u)};
+}
+void Barrier(PFN_vkCmdPipelineBarrier call, VkCommandBuffer commands, ColorSampleTilingBufferAccess before,
+             VkDeviceSize bytes, VkPipelineStageFlags stage, VkAccessFlags access) {
+    VkBufferMemoryBarrier barrier{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    barrier.srcAccessMask = before.access; barrier.dstAccessMask = access;
+    barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.buffer = before.buffer; barrier.offset = before.offset; barrier.size = bytes;
+    call(commands, before.stage, stage, 0, 0, nullptr, 1, &barrier, 0, nullptr);
+}
+}
+bool GpuColorSampleTiler::Supports(const Context& context, const ColorTarget& color) {
+    try { static_cast<void>(Parameters(context, color)); return true; }
+    catch (const std::runtime_error&) { return false; }
+}
+GpuColorSampleTiler::GpuColorSampleTiler(const Context& context) : context(context), pixelOwned8(PixelOwned8Enabled()) {
+    Require(context.device != VK_NULL_HANDLE, "GPU sample tiling device is unavailable");
+    destroyModule = context.Function<PFN_vkDestroyShaderModule>("vkDestroyShaderModule");
+    destroyDescriptors = context.Function<PFN_vkDestroyDescriptorSetLayout>("vkDestroyDescriptorSetLayout");
+    destroyLayout = context.Function<PFN_vkDestroyPipelineLayout>("vkDestroyPipelineLayout");
+    destroyPipeline = context.Function<PFN_vkDestroyPipeline>("vkDestroyPipeline");
+    destroyPool = context.Function<PFN_vkDestroyDescriptorPool>("vkDestroyDescriptorPool");
+    try {
+        const std::array<VkDescriptorSetLayoutBinding, 2> bindings{{
+            {0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr},
+            {1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr}}};
+        VkDescriptorSetLayoutCreateInfo info{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        info.bindingCount = 2; info.pBindings = bindings.data();
+        Check(context.Function<PFN_vkCreateDescriptorSetLayout>("vkCreateDescriptorSetLayout")(
+            context.device, &info, nullptr, &descriptors), "vkCreateDescriptorSetLayout sample tiling");
+        VkPushConstantRange push{VK_SHADER_STAGE_COMPUTE_BIT, 0, 20};
+        VkPipelineLayoutCreateInfo layoutInfo{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        layoutInfo.setLayoutCount = 1; layoutInfo.pSetLayouts = &descriptors;
+        layoutInfo.pushConstantRangeCount = 1; layoutInfo.pPushConstantRanges = &push;
+        Check(context.Function<PFN_vkCreatePipelineLayout>("vkCreatePipelineLayout")(
+            context.device, &layoutInfo, nullptr, &layout), "vkCreatePipelineLayout sample tiling");
+        VkShaderModuleCreateInfo moduleInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+        moduleInfo.codeSize = sizeof(COLOR_SAMPLE_TILING_COMP_SPV); moduleInfo.pCode = COLOR_SAMPLE_TILING_COMP_SPV;
+        Check(context.Function<PFN_vkCreateShaderModule>("vkCreateShaderModule")(
+            context.device, &moduleInfo, nullptr, &module), "vkCreateShaderModule sample tiling");
+    } catch (...) { release(); throw; }
+}
+GpuColorSampleTiler::~GpuColorSampleTiler() { release(); }
+void GpuColorSampleTiler::release() noexcept {
+    for (auto pipeline : programs) if (pipeline) destroyPipeline(context.device, pipeline, nullptr);
+    if (pixelOwnedModule) destroyModule(context.device, pixelOwnedModule, nullptr);
+    if (module) destroyModule(context.device, module, nullptr);
+    if (layout) destroyLayout(context.device, layout, nullptr);
+    if (descriptors) destroyDescriptors(context.device, descriptors, nullptr);
+}
+VkPipeline GpuColorSampleTiler::program(std::uint32_t samples, bool retile) {
+    std::lock_guard lock(programsMutex);
+    const bool pixelOwned = pixelOwned8 && samples == 8;
+    const auto index = pixelOwned ? 6u + unsigned(retile) : (std::countr_zero(samples) - 1u) * 2u + unsigned(retile);
+    auto& pipeline = programs.at(index);
+    if (pipeline) return pipeline;
+    const auto* equation = FindColorSampleSwizzleEquation(4, samples);
+    Require(equation != nullptr, "GPU sample tiling program has no qualified equation");
+    // The original module/schema remains byte-identical. Only eight samples can
+    // select the separate pixel-owned module and its additional sample XORs.
+    if (pixelOwned && !pixelOwnedModule) {
+        VkShaderModuleCreateInfo moduleInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+        moduleInfo.codeSize = sizeof(COLOR_SAMPLE_PIXEL_OWNED_TILING_COMP_SPV);
+        moduleInfo.pCode = COLOR_SAMPLE_PIXEL_OWNED_TILING_COMP_SPV;
+        VkShaderModule created = VK_NULL_HANDLE;
+        const auto result = context.Function<PFN_vkCreateShaderModule>("vkCreateShaderModule")(
+            context.device, &moduleInfo, nullptr, &created);
+        if (result != VK_SUCCESS) {
+            if (created) destroyModule(context.device, created, nullptr);
+            Check(result, "vkCreateShaderModule pixel-owned8 sample tiling");
+        }
+        pixelOwnedModule = created;
+    }
+    std::array<std::uint32_t, 23> values{samples, unsigned(retile), equation->blockWidth, equation->blockHeight};
+    std::copy(equation->bits.begin(), equation->bits.end(), values.begin() + 4);
+    if (pixelOwned) {
+        // GF(2) linearity: coordinate parity is computed once for sample zero;
+        // each sample then XORs the byte masks derived from the same equation.
+        for (std::uint32_t bit = 0; bit < equation->bits.size(); ++bit)
+            for (std::uint32_t sampleBit = 0; sampleBit < 3; ++sampleBit)
+                values[20 + sampleBit] |= ((equation->bits[bit] >> (24u + sampleBit)) & 1u) << bit;
+    }
+    std::array<VkSpecializationMapEntry, 23> entries{};
+    for (std::uint32_t i = 0; i < entries.size(); ++i) entries[i] = {i, i * 4u, 4};
+    const std::uint32_t valueCount = pixelOwned ? 23u : 20u;
+    VkSpecializationInfo specialization{valueCount, entries.data(), valueCount * sizeof(std::uint32_t), values.data()};
+    VkComputePipelineCreateInfo info{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+    info.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+    info.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT; info.stage.module = pixelOwned ? pixelOwnedModule : module;
+    info.stage.pName = "main"; info.stage.pSpecializationInfo = &specialization; info.layout = layout;
+    VkPipeline created = VK_NULL_HANDLE;
+    const auto result = context.Function<PFN_vkCreateComputePipelines>("vkCreateComputePipelines")(
+        context.device, context.pipelineCache, 1, &info, nullptr, &created);
+    // Vulkan may return a partial handle even on pipeline creation failure.
+    if (result != VK_SUCCESS) { if (created) destroyPipeline(context.device, created, nullptr); Check(result, "vkCreateComputePipelines sample tiling"); }
+    pipeline = created;
+    return pipeline;
+}
+GpuColorSampleTiler::Transfer::Transfer(GpuColorSampleTiler& owner, const ColorTarget& color)
+    : owner(owner), samples(color.samples), parameters(Parameters(owner.context, color)) {}
+GpuColorSampleTiler::Transfer::~Transfer() {
+    for (const auto pool : pools) owner.destroyPool(owner.context.device, pool, nullptr);
+}
+void GpuColorSampleTiler::Transfer::Record(VkCommandBuffer commands, bool retile,
+    ColorSampleTilingBufferAccess source, ColorSampleTilingBufferAccess destination,
+    VkPipelineStageFlags consumerStage, VkAccessFlags consumerAccess) {
