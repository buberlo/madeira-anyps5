+// Two-dimensional, uncompressed SW_64KB_R_X color layouts for Navi1x (16 pipes,
+// 256-byte pipe interleave). Derived from AMD AddrLib at PAL c5e800072a32f68b6ccc4422936d96167c6e0728.
+// Bits 0..11 encode full-surface x, 12..23 y, and 24..26 the stored sample.
+// High coordinate bits must participate in pipe XOR even across macroblocks.
+// These are color fragment layouts with samples == fragments, no EQAA, array
+// slice, mip tail, FMASK or DCC addressing. Single-sample equations stay separate.
+struct ColorSampleSwizzleEquation {
+    std::uint32_t elementBytes;
+    std::uint32_t samples;
+    std::uint32_t blockWidth;
+    std::uint32_t blockHeight;
+    std::array<std::uint32_t, 16> bits;
+};
