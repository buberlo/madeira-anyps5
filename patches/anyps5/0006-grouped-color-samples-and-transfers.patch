+    {4u, 8u, 32u, 64u, {0x00000000u, 0x00000000u, 0x00000001u, 0x00000002u, 0x00001000u, 0x00002000u, 0x00004000u, 0x00000004u, 0x00008008u, 0x00010010u, 0x00020040u, 0x04040020u, 0x00008000u, 0x00000010u, 0x01040000u, 0x02080000u}},
