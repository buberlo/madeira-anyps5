diff --git a/rebase/0006-grouped-color-samples-and-transfers/after/core/libs/prx/libSceAgcDriver/Graphics/src/ColorRenderTarget.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorRenderTarget.cpp
new file mode 100644
index 0000000..066bf88
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorRenderTarget.cpp
@@ -0,0 +1,88 @@
+#include "prx/libSceAgcDriver/Graphics/include/Resources.hpp"
+#include <bit>
+
+namespace AgcDriver::Graphics {
+
+RenderTarget::RenderTarget(const Context& context, const ColorTarget& target, bool blending) : context(context), format(target.format), extent(target.extent) {
+    Require(std::has_single_bit(target.samples) && target.samples <= 8u && target.fragments == target.samples, "unsupported render-target sample/fragment count");
+    nativeSamples = static_cast<VkSampleCountFlagBits>(target.samples > 4u ? 4u : target.samples);
+    layers = target.samples / static_cast<std::uint32_t>(nativeSamples);
+    Require(layers == 1u || context.multisampleArrayImage, "device does not enable multisample array images");
+    Require(target.extent.width != 0 && target.extent.height != 0, "zero-sized render target");
+    Require(context.formatProperties != nullptr && context.imageFormatProperties != nullptr, "missing render-target format queries");
+    VkFormatProperties properties{};
+    context.formatProperties(context.physical, target.format, &properties);
+    VkFormatFeatureFlags required = VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT | VK_FORMAT_FEATURE_TRANSFER_SRC_BIT | VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+    if (target.samples > 1u) required |= VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+    if (blending) required |= VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BLEND_BIT;
+    Require((properties.optimalTilingFeatures & required) == required, "render-target format does not support required operations");
+    VkImageUsageFlags usage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    if (target.samples > 1u) usage |= VK_IMAGE_USAGE_SAMPLED_BIT;
+    VkImageFormatProperties supported{};
+    Check(context.imageFormatProperties(context.physical, target.format, VK_IMAGE_TYPE_2D, VK_IMAGE_TILING_OPTIMAL, usage, 0, &supported), "vkGetPhysicalDeviceImageFormatProperties");
+    Require(target.extent.width <= supported.maxExtent.width && target.extent.height <= supported.maxExtent.height && (supported.sampleCounts & nativeSamples) != 0 && layers <= supported.maxArrayLayers && target.bytes <= supported.maxResourceSize, "render target exceeds device image limits");
+    Require(target.extent.width <= context.limits.maxFramebufferWidth && target.extent.height <= context.limits.maxFramebufferHeight, "render target exceeds framebuffer limits");
+    try {
+        VkImageCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+        info.imageType = VK_IMAGE_TYPE_2D;
+        info.format = target.format;
+        info.extent = {target.extent.width, target.extent.height, 1};
+        info.mipLevels = 1;
+        info.arrayLayers = layers;
+        info.samples = nativeSamples;
+        info.tiling = VK_IMAGE_TILING_OPTIMAL;
+        info.usage = usage;
+        info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+        Check(context.Function<PFN_vkCreateImage>("vkCreateImage")(context.device, &info, nullptr, &image), "vkCreateImage");
+        VkMemoryRequirements requirements{};
+        context.Function<PFN_vkGetImageMemoryRequirements>("vkGetImageMemoryRequirements")(context.device, image, &requirements);
+        VkMemoryAllocateInfo allocation{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+        allocation.allocationSize = requirements.size;
+        allocation.memoryTypeIndex = context.MemoryType(requirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+        Check(context.Function<PFN_vkAllocateMemory>("vkAllocateMemory")(context.device, &allocation, nullptr, &memory), "vkAllocateMemory render target");
+        Check(context.Function<PFN_vkBindImageMemory>("vkBindImageMemory")(context.device, image, memory, 0), "vkBindImageMemory");
+        VkImageViewCreateInfo viewInfo{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+        viewInfo.image = image;
+        viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D;
+        viewInfo.format = target.format;
+        viewInfo.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        for (std::uint32_t layer = 0; layer < layers; ++layer) {
+            viewInfo.subresourceRange.baseArrayLayer = layer;
+            Check(context.Function<PFN_vkCreateImageView>("vkCreateImageView")(context.device, &viewInfo, nullptr, &views[layer]), "vkCreateImageView color sample group");
+        }
+        if (target.samples > 1u) {
+            // A logical sample i lives in layer i/nativeSamples, native sample i%nativeSamples.
+            // Even a one-group image exposes a 2D-array view so shader routing has one shape.
+            viewInfo.viewType = VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+            viewInfo.subresourceRange.baseArrayLayer = 0;
+            viewInfo.subresourceRange.layerCount = layers;
+            Check(context.Function<PFN_vkCreateImageView>("vkCreateImageView")(context.device, &viewInfo, nullptr, &sampledView), "vkCreateImageView color samples");
+        }
+    } catch (...) {
+        release();
+        throw;
+    }
+}
+
+RenderTarget::~RenderTarget() {
+    release();
+}
+
+void RenderTarget::release() noexcept {
+    if (sampledView) context.Function<PFN_vkDestroyImageView>("vkDestroyImageView")(context.device, sampledView, nullptr);
+    for (const auto view : views) if (view) context.Function<PFN_vkDestroyImageView>("vkDestroyImageView")(context.device, view, nullptr);
+    if (image) context.Function<PFN_vkDestroyImage>("vkDestroyImage")(context.device, image, nullptr);
+    if (memory) context.Function<PFN_vkFreeMemory>("vkFreeMemory")(context.device, memory, nullptr);
+}
+
+VkImage RenderTarget::Image() const {
+    return image;
+}
+
+VkImageView RenderTarget::View(std::uint32_t group) const {
+    Require(group < layers, "render-target sample group out of range");
+    return views[group];
+}
+
+}
diff --git a/rebase/0006-grouped-color-samples-and-transfers/after/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolve.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolve.cpp
new file mode 100644
index 0000000..35a232e
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolve.cpp
@@ -0,0 +1,165 @@
+#include "prx/libSceAgcDriver/Graphics/include/ColorResolve.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/ColorTargetTransfer.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/FramePixelDiagnostics.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/SplitDrawShaderValidation.hpp"
+#include "prx/libSceAgcDriver/Execution/include/GuestMemory.hpp"
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <limits>
+#include <new>
+
+namespace AgcDriver::Graphics {
+
+void ValidateColorResolve(const ColorResolvePass& pass) {
+    const auto& source = pass.source;
+    const auto& destination = pass.destination;
+    Require(source.format == VK_FORMAT_R8G8B8A8_UNORM && destination.format == source.format &&
+            source.elementBytes == 4u && destination.elementBytes == 4u &&
+            source.componentMapping == destination.componentMapping,
+            "CB resolve supports matching RGBA8_UNORM formats only");
+    Require((source.samples == 2u || source.samples == 4u || source.samples == 8u) &&
+            source.fragments == source.samples, "CB resolve source requires 2/4/8 equal samples and fragments; EQAA is unsupported");
+    Require(destination.samples == 1u && destination.fragments == 1u,
+            "CB resolve destination must be single-sampled");
+    Require(source.extent.width != 0 && source.extent.height != 0 &&
+            source.extent.width == destination.extent.width && source.extent.height == destination.extent.height,
+            "CB resolve source and destination dimensions disagree");
+    Require(source.tileMode == ColorTileMode::RenderTarget && destination.tileMode == source.tileMode,
+            "CB resolve requires matching R64KB_X source and destination tiling");
+    Require(source.depth == 1u && destination.depth == 1u && source.depthSlice == 0u && destination.depthSlice == 0u &&
+            source.mip == 0u && destination.mip == 0u && source.mipCount == 1u && destination.mipCount == 1u,
+            "CB resolve mipmapped, array or volume views are unsupported");
+    Require(source.dccAddress == 0 && destination.dccAddress == 0 && source.cmaskAddress == 0 && destination.cmaskAddress == 0,
+            "CB resolve compressed or fast-cleared color targets are unsupported");
+    for (const auto* color : {&source, &destination}) {
+        const ColorTargetLayout layout(color->extent.width, color->extent.height, color->tileMode, 4u, color->pipeBankXor, color->samples);
+        Require(color->bytes == layout.Bytes(), "CB resolve color allocation size disagrees with its layout");
+        Require(color->address != 0 && color->address % layout.Alignment() == 0 &&
+                color->bytes <= std::numeric_limits<std::uint64_t>::max() - color->address,
+                "CB resolve invalid or overflowing guest range");
+    }
+}
+
+
+void ColorResolveReference(const ColorResolvePass& pass,
+    std::span<const std::byte> source, std::span<std::byte> destination) {
+    ValidateColorResolve(pass);
+    const auto samples = pass.source.samples;
+    const auto bytes = static_cast<std::size_t>(pass.source.extent.width) * pass.source.extent.height * 4u;
+    Require(destination.size() == bytes && source.size() == bytes * samples, "CB resolve reference buffer size mismatch");
+    // Original scalar oracle: round-by-half after the complete logical-sample
+    // mean. Native floating-point UNORM conversion may differ by one at ties.
+    for (std::size_t pixel = 0; pixel < bytes / 4u; ++pixel) {
+        for (unsigned channel = 0; channel < 4u; ++channel) {
+            unsigned sum = 0;
+            for (unsigned sample = 0; sample < samples; ++sample)
+                sum += std::to_integer<unsigned>(source[(pixel * samples + sample) * 4u + channel]);
+            destination[pixel * 4u + channel] = static_cast<std::byte>((sum + samples / 2u) / samples);
+        }
+    }
+}
+
+ColorResolveSnapshot CaptureColorResolveSource(const ColorTarget& source, bool diagnostics) {
+    // This helper has the same strict source qualification as RunColorResolve.
+    auto validation = ColorResolvePass{source, source};
+    validation.destination.samples = validation.destination.fragments = 1u;
+    validation.destination.bytes = ColorTargetLayout(source.extent.width, source.extent.height,
+        source.tileMode, source.elementBytes, source.pipeBankXor, 1u).Bytes();
+    ValidateColorResolve(validation);
+    const ColorTargetLayout layout(source.extent.width, source.extent.height,
+                                   source.tileMode, source.elementBytes, source.pipeBankXor, source.samples);
+    static const bool raw = [] {
+        const char* value = std::getenv("APS5_RAW_RESOLVE_SNAPSHOT");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    ColorResolveSnapshot result;
+    result.source = source;
+    const auto alignment = std::align_val_t(65536);
+    result.backing = {static_cast<std::byte*>(::operator new(source.bytes, alignment)),
+        [alignment](std::byte* memory) { ::operator delete(memory, alignment); }};
+    result.source.address = result.source.surfaceAddress = reinterpret_cast<std::uintptr_t>(result.backing.get());
+    auto bytes = std::span<std::byte>(result.backing.get(), static_cast<std::size_t>(source.bytes));
+    if (raw) {
+        GuestMemory::CheckRange(bytes.data(), bytes.size(), layout.Alignment(), true);
+        // Read keeps the existing pending-GPU flush and complete mapped-range
+        // validation. Never flush from inside the guest write-tracker lock.
+        GuestMemory::Read(source.address, bytes, layout.Alignment());
+        // Host allocations can recycle an address the tracker has seen. Keep
+        // driver-generation invalidation after the complete successful copy.
+        GuestMemory::MarkWritten(result.source.address, bytes.size());
+        result.rawCopy = true;
+        if (diagnostics) {
+            result.diagnosticPixels.resize(layout.LinearBytes());
+            layout.Detile(bytes, result.diagnosticPixels);
+        }
+        static std::atomic<bool> reported{false};
+        if (!reported.exchange(true, std::memory_order_relaxed))
+            std::fprintf(stderr, "[resolve-snapshot] raw tiled snapshot executed bytes=%llu; pending flush, immutable backing and write stamps retained\n",
+                static_cast<unsigned long long>(source.bytes));
+    } else {
+        std::vector<std::byte> linear(layout.LinearBytes());
+        ReadColorTarget(source, linear);
+        std::memset(bytes.data(), 0, bytes.size());
+        WriteColorTarget(result.source, linear);
+        if (diagnostics) result.diagnosticPixels = std::move(linear);
+    }
+    return result;
+}
+
+void RunColorResolve(const Context& context, const ColorResolvePass& pass,
+    const State& raster, const Pm4::DrawParameters& draw,
+    const ShaderRecompiler::RecompileResult& vertex,
+    std::span<const GuestMemorySnapshot> snapshots,
+    const ShaderRecompiler::SpirvTarget& target) {
+    ValidateColorResolve(pass);
+    Require(raster.rectList && raster.samples.count == 1u && raster.colors.size() == 1u &&
+            raster.color.address == pass.destination.address && !raster.depthTest && !raster.depthWrite && !raster.stencilTest,
+            "CB resolve requires its checked single-sample rectangle state");
+    Require(!draw.indirect && !draw.indexed && draw.indexCount == 3u && draw.instanceCount == 1u,
+            "CB resolve requires one direct three-vertex rectangle");
+    // Read through the production flush hook before the destination can change:
+    // pending GPU writes land first, including when source and destination alias.
+    const auto pixelEvent = FramePixelDiagnosticEvent(FramePixelDiagnosticStage::Resolve);
+    auto captured = CaptureColorResolveSource(pass.source, pixelEvent.has_value());
+    if (pixelEvent) {
+        const auto stats = SampleFramePixels(captured.diagnosticPixels, pass.source.extent.width,
+            pass.source.extent.height, pass.source.samples);
+        PrintFramePixelStatistics("resolve-source", *pixelEvent, pass.source.address,
+            pass.destination.address, pass.source.extent.width, pass.source.extent.height,
+            pass.source.samples, stats);
+        std::fprintf(stderr, "[pixel-diag] stage=resolve-state event=%llu source=%llx destination=%llx rect_list=%d index_count=%u instances=%u viewport=%.3f,%.3f,%.3f,%.3f,%.3f,%.3f scissor=%d,%d,%u,%u cull=%u front_face=%u color_write_mask=%u\n",
+            static_cast<unsigned long long>(*pixelEvent), static_cast<unsigned long long>(pass.source.address),
+            static_cast<unsigned long long>(pass.destination.address), raster.rectList, draw.indexCount,
+            draw.instanceCount, raster.viewport.x, raster.viewport.y, raster.viewport.width, raster.viewport.height,
+            raster.viewport.minDepth, raster.viewport.maxDepth, raster.scissor.offset.x, raster.scissor.offset.y,
+            raster.scissor.extent.width, raster.scissor.extent.height, raster.cullMode,
+            static_cast<unsigned>(raster.frontFace), raster.blends.at(raster.color.exportIndex).colorWriteMask);
+    }
+    auto fragment = BuildColorResolveFragment(captured.source, vertex);
+    auto rectangle = ShaderRecompiler::BuildRectListShaders(vertex, fragment, target);
+    using Stage = ShaderRecompiler::ShaderStage;
+    const std::array<CompiledShader, 4> shaders{{
+        {Stage::Vertex, &vertex, 0}, {Stage::TessellationControl, &rectangle.control, 0},
+        {Stage::TessellationEvaluation, &rectangle.evaluation, 0},
+        {Stage::Fragment, &fragment, 0, PipelineShaderIdentity::ColorResolveFragment}
+    }};
+    const auto reason = SplitRectListShaderRejection(shaders, target);
+    Require(reason.empty(), reason);
+    // Single destination attachment: normal draw validation, load/store,
+    // retained descriptors, barriers, fault-buffer completion and alias stamps
+    // still apply. This executes actual geometry, including partial rectangles.
+    Draw(context, raster, draw, shaders, snapshots, nullptr, &target);
+    if (pixelEvent) {
+        // Return from Draw is not a GPU completion proof: a resident target can
+        // remain queued. Never read destination guest RAM or add an early flush.
+        std::fprintf(stderr, "[pixel-diag] stage=resolve-draw-returned event=%llu destination=%llx gpu_completion_not_assumed=1\n",
+            static_cast<unsigned long long>(*pixelEvent), static_cast<unsigned long long>(pass.destination.address));
+    }
+    // Retain the guest-address backing at least through every recorded upload
+    // and read. A synchronous draw already finished; a later batch keeps it
+    // until all earlier work on this queue has completed.
+    if (context.recorder != nullptr) context.recorder->Keep(captured.backing, pass.source.bytes);
+}
+
+}
diff --git a/rebase/0006-grouped-color-samples-and-transfers/after/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolveFragment.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolveFragment.cpp
new file mode 100644
index 0000000..5b0c40e
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorResolveFragment.cpp
@@ -0,0 +1,72 @@
+#include "prx/libSceAgcDriver/Graphics/include/ColorResolve.hpp"
+#include "prx/libSceAgcDriver/Graphics/shaders/ColorResolve_spv.h"
+#include <spirv/unified1/spirv.hpp>
+#include <algorithm>
+#include <bit>
+#include <limits>
+
+namespace AgcDriver::Graphics {
+
+ShaderRecompiler::RecompileResult BuildColorResolveFragment(
+    const ColorTarget& source, const ShaderRecompiler::RecompileResult& vertex) {
+    // DecodeTextureResource's GC10 T# uses a 14-bit width and height and a
+    // 48-bit address. NUM_FRAGMENTS is duplicated in LAST_LEVEL and word5.
+    Require(source.format == VK_FORMAT_R8G8B8A8_UNORM && source.elementBytes == 4u &&
+            source.fragments == source.samples && (source.samples == 2u || source.samples == 4u || source.samples == 8u),
+            "CB resolve fragment source must be 2/4/8-sample RGBA8_UNORM");
+    Require(source.tileMode == ColorTileMode::RenderTarget && source.extent.width > 0 && source.extent.width <= 16384u &&
+            source.extent.height > 0 && source.extent.height <= 16384u && source.address != 0 && source.address < (1ull << 48u) &&
+            source.address % 65536u == 0, "CB resolve source cannot be represented by the GC10 image descriptor");
+    std::uint32_t bindingIndex = 0;
+    for (const auto& binding : vertex.bindings) {
+        Require(binding.binding < std::numeric_limits<std::uint32_t>::max(), "CB resolve descriptor binding overflow");
+        bindingIndex = std::max(bindingIndex, binding.binding + 1u);
+    }
+    const std::span<const std::uint32_t> words = source.samples == 2u ? std::span<const std::uint32_t>(COLOR_RESOLVE_2_SPV) :
+        source.samples == 4u ? std::span<const std::uint32_t>(COLOR_RESOLVE_4_SPV) : std::span<const std::uint32_t>(COLOR_RESOLVE_8_SPV);
+    ShaderRecompiler::RecompileResult fragment{};
+    std::vector<std::uint32_t> code(words.begin(), words.end());
+    unsigned patched = 0;
+    for (std::size_t at = 5; at < code.size();) {
+        const auto count = code[at] >> 16u;
+        Require(count > 0 && count <= code.size() - at, "CB resolve embedded SPIR-V is malformed");
+        if ((code[at] & 0xffffu) == spv::OpDecorate && count == 4u && code[at + 2] == spv::DecorationBinding) {
+            Require(code[at + 3] == 0u, "CB resolve embedded descriptor binding changed");
+            code[at + 3] = bindingIndex;
+            ++patched;
+        }
+        at += count;
+    }
+    Require(patched == 1u, "CB resolve must have exactly one known image binding");
+    fragment.spirv = std::move(code);
+    const auto log = static_cast<std::uint32_t>(std::countr_zero(source.samples));
+    const auto width = source.extent.width - 1u;
+    const auto height = source.extent.height - 1u;
+    ShaderRecompiler::DescriptorBinding binding{};
+    binding.kind = ShaderRecompiler::DescriptorKind::SampledImage;
+    binding.role = ShaderRecompiler::DescriptorRole::GuestImages;
+    binding.descriptorSet = 0;
+    binding.binding = bindingIndex;
+    binding.count = 1;
+    binding.guestDescriptor = {
+        static_cast<std::uint32_t>(source.address >> 8u),
+        static_cast<std::uint32_t>(source.address >> 40u) | (56u << 20u) | ((width & 3u) << 30u),
+        (width >> 2u) | (height << 14u),
+        0xfacu | (log << 16u) | (27u << 20u) | (14u << 28u),
+        0u, log << 4u, 0u, 0u
+    };
+    binding.imageShape = ShaderRecompiler::DescriptorImageShape::Image2DMsaaArray;
+    binding.imageWritten = {false};
+    binding.imageDepthCompare = {false};
+    binding.imageAtomic = {false};
+    binding.imageAtomic64 = {false};
+    binding.imageUnnormalized = {false};
+    binding.imageSamplers = {0u};
+    binding.imageLogicalSamples = {source.samples};
+    binding.imageNativeSamples = {std::min(source.samples, 4u)};
+    fragment.bindings.push_back(std::move(binding));
+    return fragment;
+}
+
+
+}
diff --git a/rebase/0006-grouped-color-samples-and-transfers/after/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleSnapshotCopy.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleSnapshotCopy.cpp
new file mode 100644
index 0000000..f84e5d4
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleSnapshotCopy.cpp
@@ -0,0 +1,68 @@
+#include "prx/libSceAgcDriver/Graphics/include/ColorSampleSnapshotCopy.hpp"
+#include <cstdlib>
+#include <cstring>
+
+namespace AgcDriver::Graphics {
+bool ColorSampleStagingCopyEnabled() {
+    static const bool enabled = [] {
+        const auto* value = std::getenv("APS5_GPU_COLOR_SAMPLE_STAGING_COPY");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+ColorSampleSnapshotCopy::ColorSampleSnapshotCopy(const Context& context,
+        const ColorTarget& color, Reader read) : context(context) {
+    Require(read != nullptr && GpuColorSampleTiler::Supports(context, color),
+        "sample staging copy requires its qualified color layout and reader");
+    const ColorTargetLayout layout(color.extent.width, color.extent.height,
+        color.tileMode, color.elementBytes, color.pipeBankXor, color.samples);
+    baseline = std::make_unique<Buffer>(context, layout.Bytes(),
+        VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+    // Draw passes GuestMemory::Read: its pending-GPU flush and full mapped
+    // range validation precede this copy. No guest write or writable mapping.
+    read(color.address, baseline->Bytes(), layout.Alignment());
+    result = std::make_unique<Buffer>(context, layout.Bytes(),
+        VK_BUFFER_USAGE_TRANSFER_DST_BIT | VK_BUFFER_USAGE_STORAGE_BUFFER_BIT);
+}
+std::span<const std::byte> ColorSampleSnapshotCopy::Original() const { return baseline->Bytes(); }
+std::span<const std::byte> ColorSampleSnapshotCopy::Result() const { return result->Bytes(); }
+
+void ColorSampleSnapshotCopy::RecordSeed(VkCommandBuffer commands) {
+    Require(commands != VK_NULL_HANDLE && !seeded && baseline->Handle() && result->Handle() &&
+        baseline->Handle() != result->Handle() && baseline->Bytes().size() == result->Bytes().size() &&
+        baseline->Bytes().size() % 4u == 0, "sample staging copy command/buffers are invalid");
+    // Resolve before recording: a missing entry point cannot leave half a copy.
+    const auto barrier = context.Resolved(&DeviceFunctions::cmdPipelineBarrier, "vkCmdPipelineBarrier");
+    const auto copy = context.Resolved(&DeviceFunctions::cmdCopyBuffer, "vkCmdCopyBuffer");
+    std::array<VkBufferMemoryBarrier, 2> before{};
+    for (auto& item : before) {
+        item.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER;
+        item.srcQueueFamilyIndex = item.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        item.offset = 0; item.size = baseline->Bytes().size();
+    }
+    before[0].buffer = baseline->Handle(); before[0].srcAccessMask = VK_ACCESS_HOST_WRITE_BIT;
+    before[0].dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_READ_BIT;
+    // The distinct pooled result has no live prior commands: its previous owner
+    // completed its fence before return to BufferPool. No stale contents read.
+    before[1].buffer = result->Handle(); before[1].dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    barrier(commands, VK_PIPELINE_STAGE_HOST_BIT | VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        0, 0, nullptr, 2, before.data(), 0, nullptr);
+    const VkBufferCopy region{0, 0, baseline->Bytes().size()};
+    copy(commands, baseline->Handle(), result->Handle(), 1, &region);
+    seeded = true;
+}
+ColorSampleTilingBufferAccess ColorSampleSnapshotCopy::DetileSource() const {
+    Require(seeded, "sample staging copy must seed its result before detiling");
+    return {context.device, baseline->Handle(), 0, baseline->Bytes().size(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT | VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+        VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_SHADER_READ_BIT};
+}
+ColorSampleTilingBufferAccess ColorSampleSnapshotCopy::RetileDestination() const {
+    Require(seeded, "sample staging copy must seed its padding before retiling");
+    // Retile overwrites logical words only; the full copy owns padding.
+    return {context.device, result->Handle(), 0, result->Bytes().size(),
+        VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT};
+}
+}
diff --git a/rebase/0006-grouped-color-samples-and-transfers/after/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleTransfer.cpp b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleTransfer.cpp
new file mode 100644
index 0000000..d0b53c5
--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/Graphics/src/ColorSampleTransfer.cpp
@@ -0,0 +1,331 @@
+#include "prx/libSceAgcDriver/Graphics/include/ColorSampleTransfer.hpp"
+#include "prx/libSceAgcDriver/Graphics/shaders/ColorSampleTransfer_spv.h"
+#include <bit>
+#include <limits>
+
+namespace AgcDriver::Graphics {
+namespace {
+void ImageBarrier(PFN_vkCmdPipelineBarrier barrier, VkCommandBuffer commands,
+                  const RenderTarget& target, ColorSampleImageAccess before,
+                  ColorSampleImageAccess after) {
+    VkImageMemoryBarrier image{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    image.srcAccessMask = before.access;
+    image.dstAccessMask = after.access;
+    image.oldLayout = before.layout;
+    image.newLayout = after.layout;
+    image.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    image.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    image.image = target.Image();
+    image.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, target.Groups()};
+    barrier(commands, before.stage, after.stage, 0, 0, nullptr, 0, nullptr, 1, &image);
+}
+void BufferBarrier(PFN_vkCmdPipelineBarrier barrier, VkCommandBuffer commands,
+                   const ColorSampleBufferAccess& before, VkDeviceSize bytes,
+                   VkPipelineStageFlags afterStage, VkAccessFlags afterAccess) {
+    VkBufferMemoryBarrier buffer{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+    buffer.srcAccessMask = before.access;
+    buffer.dstAccessMask = afterAccess;
+    buffer.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    buffer.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    buffer.buffer = before.buffer;
+    buffer.offset = before.offset;
+    buffer.size = bytes;
+    barrier(commands, before.stage, afterStage, 0, 0, nullptr, 1, &buffer, 0, nullptr);
+}
+constexpr ColorSampleImageAccess AttachmentAccess{
+    VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL, VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+    VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT};
+constexpr ColorSampleImageAccess ReadbackAccess{
+    VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+    VK_ACCESS_SHADER_READ_BIT};
+}
+
+ColorSampleTransfer::ColorSampleTransfer(const Context& context, RenderTarget& target,
+                                         const ColorTarget& color)
+    : context(context), target(target), extent(color.extent), samples(color.samples),
+      nativeSamples(static_cast<std::uint32_t>(target.NativeSamples())), packedBytes(0) {
+    Require(color.format == VK_FORMAT_R8G8B8A8_UNORM && target.Format() == color.format, "color sample transfer requires matching RGBA8_UNORM format");
+    Require(target.Extent().width == extent.width && target.Extent().height == extent.height && target.Device() == context.device,
+            "color sample transfer target extent/device mismatch");
+    Require(std::has_single_bit(samples) && samples >= 2 && samples <= 8 && color.fragments == samples,
+            "color sample transfer requires equal 2/4/8 sample and fragment counts");
+    Require(nativeSamples == (samples > 4 ? 4u : samples) && target.Groups() == samples / nativeSamples,
+            "color sample transfer target group/count mismatch");
+    Require(target.Image() != VK_NULL_HANDLE && target.SampledView() != VK_NULL_HANDLE,
+            "color sample transfer target is unavailable");
+    Require(extent.width && extent.height && extent.width <= context.limits.maxFramebufferWidth &&
+            extent.height <= context.limits.maxFramebufferHeight, "color sample transfer extent is unsupported");
+    Require(extent.width <= context.limits.maxViewportDimensions[0] && extent.height <= context.limits.maxViewportDimensions[1],
+            "color sample transfer extent exceeds viewport limits");
+    const auto words = std::uint64_t(extent.width) * extent.height * samples;
+    Require(words <= std::numeric_limits<std::uint32_t>::max(), "color sample transfer indexing overflows");
+    packedBytes = words * 4u;
+    Require(packedBytes <= context.limits.maxStorageBufferRange, "color sample transfer exceeds storage buffer range");
+    Require(context.limits.maxPushConstantsSize >= 16 && context.limits.maxPerStageDescriptorStorageBuffers >= 1 &&
+            context.limits.maxPerStageDescriptorSampledImages >= 1 && context.limits.maxDescriptorSetStorageBuffers >= 1 &&
+            context.limits.maxDescriptorSetSampledImages >= 1, "color sample transfer descriptor/push limits are unsupported");
+    Require(context.limits.maxComputeWorkGroupSize[0] >= 8 && context.limits.maxComputeWorkGroupSize[1] >= 8 &&
+            context.limits.maxComputeWorkGroupInvocations >= 64 && (extent.width + 7u) / 8u <= context.limits.maxComputeWorkGroupCount[0] &&
+            (extent.height + 7u) / 8u <= context.limits.maxComputeWorkGroupCount[1], "color sample transfer compute limits are unsupported");
+    // Resolve destructors before making anything: partial-construction cleanup cannot fail
+    // because a later vkGetDeviceProcAddr lookup happens to be absent.
+    destroyFramebuffer = context.Function<PFN_vkDestroyFramebuffer>("vkDestroyFramebuffer");
+    destroyRenderPass = context.Function<PFN_vkDestroyRenderPass>("vkDestroyRenderPass");
+    destroyPipeline = context.Function<PFN_vkDestroyPipeline>("vkDestroyPipeline");
+    destroyPipelineLayout = context.Function<PFN_vkDestroyPipelineLayout>("vkDestroyPipelineLayout");
+    destroyDescriptorSetLayout = context.Function<PFN_vkDestroyDescriptorSetLayout>("vkDestroyDescriptorSetLayout");
+    destroyDescriptorPool = context.Function<PFN_vkDestroyDescriptorPool>("vkDestroyDescriptorPool");
+    const auto destroyModule = context.Function<PFN_vkDestroyShaderModule>("vkDestroyShaderModule");
+    std::array<VkShaderModule, 3> modules{};
+    try {
+        const VkDescriptorSetLayoutBinding uploadBinding{0, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_FRAGMENT_BIT, nullptr};
+        VkDescriptorSetLayoutCreateInfo descriptorInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+        descriptorInfo.bindingCount = 1;
+        descriptorInfo.pBindings = &uploadBinding;
+        const auto createDescriptors = context.Function<PFN_vkCreateDescriptorSetLayout>("vkCreateDescriptorSetLayout");
+        Check(createDescriptors(context.device, &descriptorInfo, nullptr, &uploadDescriptors), "vkCreateDescriptorSetLayout color sample upload");
+        const std::array<VkDescriptorSetLayoutBinding, 2> readbackBindings{{
+            {0, VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr},
+            {1, VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1, VK_SHADER_STAGE_COMPUTE_BIT, nullptr}}};
+        descriptorInfo.bindingCount = 2;
+        descriptorInfo.pBindings = readbackBindings.data();
+        Check(createDescriptors(context.device, &descriptorInfo, nullptr, &readbackDescriptors), "vkCreateDescriptorSetLayout color sample readback");
+        VkPushConstantRange push{VK_SHADER_STAGE_FRAGMENT_BIT, 0, 16};
+        VkPipelineLayoutCreateInfo layoutInfo{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+        layoutInfo.setLayoutCount = 1;
+        layoutInfo.pSetLayouts = &uploadDescriptors;
+        layoutInfo.pushConstantRangeCount = 1;
+        layoutInfo.pPushConstantRanges = &push;
+        const auto createLayout = context.Function<PFN_vkCreatePipelineLayout>("vkCreatePipelineLayout");
+        Check(createLayout(context.device, &layoutInfo, nullptr, &uploadLayout), "vkCreatePipelineLayout color sample upload");
+        layoutInfo.pSetLayouts = &readbackDescriptors;
+        push.stageFlags = VK_SHADER_STAGE_COMPUTE_BIT;
+        Check(createLayout(context.device, &layoutInfo, nullptr, &readbackLayout), "vkCreatePipelineLayout color sample readback");
+        VkAttachmentDescription attachment{};
+        attachment.format = color.format;
+        attachment.samples = target.NativeSamples();
+        attachment.loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+        attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+        attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+        attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+        attachment.initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        attachment.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+        VkAttachmentReference reference{0, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+        VkSubpassDescription subpass{};
+        subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        subpass.colorAttachmentCount = 1;
+        subpass.pColorAttachments = &reference;
+        VkRenderPassCreateInfo passInfo{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+        passInfo.attachmentCount = 1;
+        passInfo.pAttachments = &attachment;
+        passInfo.subpassCount = 1;
+        passInfo.pSubpasses = &subpass;
+        Check(context.Function<PFN_vkCreateRenderPass>("vkCreateRenderPass")(context.device, &passInfo, nullptr, &renderPass), "vkCreateRenderPass color sample upload");
+        for (std::uint32_t group = 0; group < target.Groups(); ++group) {
+            const auto view = target.View(group);
+            VkFramebufferCreateInfo framebufferInfo{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+            framebufferInfo.renderPass = renderPass;
+            framebufferInfo.attachmentCount = 1;
+            framebufferInfo.pAttachments = &view;
+            framebufferInfo.width = extent.width;
+            framebufferInfo.height = extent.height;
+            framebufferInfo.layers = 1;
+            Check(context.Function<PFN_vkCreateFramebuffer>("vkCreateFramebuffer")(context.device, &framebufferInfo, nullptr, &framebuffers[group]), "vkCreateFramebuffer color sample group");
+        }
+        const std::array<std::span<const std::uint32_t>, 3> programs{
+            COLOR_SAMPLE_UPLOAD_VERT_SPV, COLOR_SAMPLE_UPLOAD_FRAG_SPV, COLOR_SAMPLE_READBACK_COMP_SPV};
+        const auto createModule = context.Function<PFN_vkCreateShaderModule>("vkCreateShaderModule");
+        for (std::uint32_t i = 0; i < modules.size(); ++i) {
+            VkShaderModuleCreateInfo moduleInfo{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+            moduleInfo.codeSize = programs[i].size_bytes();
+            moduleInfo.pCode = programs[i].data();
+            Check(createModule(context.device, &moduleInfo, nullptr, &modules[i]), "vkCreateShaderModule color sample transfer");
+        }
+        const std::array<VkPipelineShaderStageCreateInfo, 2> stages{{
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_VERTEX_BIT, modules[0], "main", nullptr},
+            {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO, nullptr, 0, VK_SHADER_STAGE_FRAGMENT_BIT, modules[1], "main", nullptr}}};
+        VkPipelineVertexInputStateCreateInfo vertices{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+        VkPipelineInputAssemblyStateCreateInfo assembly{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+        assembly.topology = VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+        VkPipelineViewportStateCreateInfo viewport{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+        viewport.viewportCount = viewport.scissorCount = 1;
+        VkPipelineRasterizationStateCreateInfo raster{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+        raster.polygonMode = VK_POLYGON_MODE_FILL;
+        raster.cullMode = VK_CULL_MODE_NONE;
+        raster.frontFace = VK_FRONT_FACE_COUNTER_CLOCKWISE;
+        raster.lineWidth = 1.0f;
+        VkPipelineMultisampleStateCreateInfo multisample{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+        multisample.rasterizationSamples = target.NativeSamples();
+        // One selected native sample per raster invocation; sampleRateShading is unnecessary.
+        VkSampleMask sampleMask = 1;
+        multisample.pSampleMask = &sampleMask;
+        VkPipelineColorBlendAttachmentState blending{};
+        blending.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT | VK_COLOR_COMPONENT_A_BIT;
+        VkPipelineColorBlendStateCreateInfo blend{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+        blend.attachmentCount = 1;
+        blend.pAttachments = &blending;
+        const std::array<VkDynamicState, 2> dynamicStates{VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR};
+        VkPipelineDynamicStateCreateInfo dynamic{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+        dynamic.dynamicStateCount = static_cast<std::uint32_t>(dynamicStates.size());
+        dynamic.pDynamicStates = dynamicStates.data();
+        VkGraphicsPipelineCreateInfo graphics{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+        graphics.stageCount = static_cast<std::uint32_t>(stages.size());
+        graphics.pStages = stages.data();
+        graphics.pVertexInputState = &vertices;
+        graphics.pInputAssemblyState = &assembly;
+        graphics.pViewportState = &viewport;
+        graphics.pRasterizationState = &raster;
+        graphics.pMultisampleState = &multisample;
+        graphics.pColorBlendState = &blend;
+        graphics.pDynamicState = &dynamic;
+        graphics.layout = uploadLayout;
+        graphics.renderPass = renderPass;
+        const auto createGraphics = context.Function<PFN_vkCreateGraphicsPipelines>("vkCreateGraphicsPipelines");
+        for (std::uint32_t sample = 0; sample < nativeSamples; ++sample) {
+            sampleMask = 1u << sample;
+            Check(createGraphics(context.device, context.pipelineCache, 1, &graphics, nullptr, &uploadPipelines[sample]), "vkCreateGraphicsPipelines color sample upload");
+        }
+        VkComputePipelineCreateInfo compute{VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO};
+        compute.stage = {VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO};
+        compute.stage.stage = VK_SHADER_STAGE_COMPUTE_BIT;
+        compute.stage.module = modules[2];
+        compute.stage.pName = "main";
+        compute.layout = readbackLayout;
+        Check(context.Function<PFN_vkCreateComputePipelines>("vkCreateComputePipelines")(context.device, context.pipelineCache, 1, &compute, nullptr, &readbackPipeline), "vkCreateComputePipelines color sample readback");
+        for (auto& module : modules) { destroyModule(context.device, module, nullptr); module = VK_NULL_HANDLE; }
+    } catch (...) {
+        for (const auto module : modules) if (module) destroyModule(context.device, module, nullptr);
+        release();
+        throw;
+    }
+}
+ColorSampleTransfer::~ColorSampleTransfer() { release(); }
+void ColorSampleTransfer::release() noexcept {
+    for (const auto pool : retainedPools) destroyDescriptorPool(context.device, pool, nullptr);
+    for (const auto framebuffer : framebuffers) if (framebuffer) destroyFramebuffer(context.device, framebuffer, nullptr);
+    for (const auto pipeline : uploadPipelines) if (pipeline) destroyPipeline(context.device, pipeline, nullptr);
+    if (readbackPipeline) destroyPipeline(context.device, readbackPipeline, nullptr);
+    if (renderPass) destroyRenderPass(context.device, renderPass, nullptr);
+    if (uploadLayout) destroyPipelineLayout(context.device, uploadLayout, nullptr);
+    if (readbackLayout) destroyPipelineLayout(context.device, readbackLayout, nullptr);
+    if (uploadDescriptors) destroyDescriptorSetLayout(context.device, uploadDescriptors, nullptr);
+    if (readbackDescriptors) destroyDescriptorSetLayout(context.device, readbackDescriptors, nullptr);
+}
+void ColorSampleTransfer::validateBuffer(const ColorSampleBufferAccess& buffer) const {
+    Require(buffer.buffer != VK_NULL_HANDLE && buffer.bytes >= packedBytes && buffer.stage != 0,
+            "color sample transfer buffer/range/state is unavailable");
+    const auto alignment = std::max<VkDeviceSize>(4, context.limits.minStorageBufferOffsetAlignment);
+    Require(buffer.offset % alignment == 0 && buffer.offset <= std::numeric_limits<VkDeviceSize>::max() - packedBytes,
+            "color sample transfer buffer offset is invalid");
+}
+void ColorSampleTransfer::validateImage(ColorSampleImageAccess state, bool allowUndefined) const {
+    Require(state.stage != 0, "color sample transfer image stage is missing");
+    Require(state.layout == VK_IMAGE_LAYOUT_GENERAL || state.layout == VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL ||
+            state.layout == VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL || state.layout == VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL ||
+            state.layout == VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL || (allowUndefined && state.layout == VK_IMAGE_LAYOUT_UNDEFINED),
+            "color sample transfer image layout is unsupported");
+    Require(state.layout != VK_IMAGE_LAYOUT_UNDEFINED || state.access == 0, "undefined color image cannot have prior access");
+}
+VkDescriptorSet ColorSampleTransfer::descriptor(bool upload, const ColorSampleBufferAccess& buffer) {
+    // Resolve every fallible host operation before recording any GPU commands.
+    const auto createPool = context.Function<PFN_vkCreateDescriptorPool>("vkCreateDescriptorPool");
+    const auto allocateSet = context.Function<PFN_vkAllocateDescriptorSets>("vkAllocateDescriptorSets");
+    const auto updateSet = context.Function<PFN_vkUpdateDescriptorSets>("vkUpdateDescriptorSets");
+    const std::array<VkDescriptorPoolSize, 2> sizes{{{VK_DESCRIPTOR_TYPE_STORAGE_BUFFER, 1}, {VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE, 1}}};
+    VkDescriptorPoolCreateInfo poolInfo{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+    poolInfo.maxSets = 1;
+    poolInfo.poolSizeCount = upload ? 1 : 2;
+    poolInfo.pPoolSizes = sizes.data();
+    VkDescriptorPool pool = VK_NULL_HANDLE;
+    Check(createPool(context.device, &poolInfo, nullptr, &pool), "vkCreateDescriptorPool color sample transfer");
+    try {
+        const auto layout = upload ? uploadDescriptors : readbackDescriptors;
+        VkDescriptorSetAllocateInfo allocation{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        allocation.descriptorPool = pool;
+        allocation.descriptorSetCount = 1;
+        allocation.pSetLayouts = &layout;
+        VkDescriptorSet set = VK_NULL_HANDLE;
+        Check(allocateSet(context.device, &allocation, &set), "vkAllocateDescriptorSets color sample transfer");
