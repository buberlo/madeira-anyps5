+#ifndef CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_COLORRESOLVE_HPP
+#define CORE_LIBS_PRX_LIBSCEAGCDRIVER_GRAPHICS_INCLUDE_COLORRESOLVE_HPP
+
+#include "prx/libSceAgcDriver/Graphics/include/Draw.hpp"
+
+namespace AgcDriver::Graphics {
+
+// GC10 CB_RESOLVE averages MRT0 into MRT1. Storage samples do not
+// determine raster samples: resolve rectangle coverage is single-sampled.
+void ValidateColorResolve(const ColorResolvePass& pass);
+// The original shader is specialized only by sample count and an unused
+// descriptor binding; all reads are from a retained immutable source copy.
+ShaderRecompiler::RecompileResult BuildColorResolveFragment(
+    const ColorTarget& source, const ShaderRecompiler::RecompileResult& vertex);
+void ColorResolveReference(const ColorResolvePass& pass,
+    std::span<const std::byte> source, std::span<std::byte> destination);
+// Private source backing survives source/destination aliasing and later queued
+// draws. Optional diagnostic pixels are taken from that same captured source.
+struct ColorResolveSnapshot {
+    ColorTarget source;
+    std::shared_ptr<std::byte> backing;
+    std::vector<std::byte> diagnosticPixels;
+    bool rawCopy = false;
+};
+ColorResolveSnapshot CaptureColorResolveSource(const ColorTarget& source, bool diagnostics);
+// Uses the actual guest vertex program and canonical rectangle stages. The
+// normal draw path loads destination contents, preserving uncovered pixels.
+void RunColorResolve(const Context& context, const ColorResolvePass& pass,
+    const State& raster, const Pm4::DrawParameters& draw,
+    const ShaderRecompiler::RecompileResult& vertex,
+    std::span<const GuestMemorySnapshot> snapshots,
+    const ShaderRecompiler::SpirvTarget& target);
+
+}
+#endif
