--- /dev/null
+++ b/core/libs/prx/libSceAgcDriver/tests/PlaceholderImages.cpp
@@ -0,0 +1,188 @@
+#include "prx/libSceAgcDriver/Graphics/include/PlaceholderImages.hpp"
+#include "IntermediateRepresentation/IrProgram.hpp"
+#include "prx/libSceAgcDriver/Graphics/include/ImageDescriptorValidation.hpp"
+#include <array>
+#include <cstdint>
+#include <exception>
+#include <iostream>
+#include <set>
+#include <stdexcept>
+#include <string>
+
+using namespace ShaderRecompiler;
+
+namespace {
+
+void Require(bool condition, const std::string& message) {
+    if (!condition) throw std::runtime_error(message);
+}
+
+VkImageViewType ViewType(RdnaImageDimension dimension, std::uint32_t nativeSamples) {
+    switch (dimension) {
+        case RdnaImageDimension::Dim1D: return VK_IMAGE_VIEW_TYPE_1D;
+        case RdnaImageDimension::Dim1DArray: return VK_IMAGE_VIEW_TYPE_1D_ARRAY;
+        case RdnaImageDimension::Dim2D: return VK_IMAGE_VIEW_TYPE_2D;
+        case RdnaImageDimension::Dim2DMsaa: return nativeSamples != 0u ? VK_IMAGE_VIEW_TYPE_2D_ARRAY : VK_IMAGE_VIEW_TYPE_2D;
+        case RdnaImageDimension::Dim2DArray:
+        case RdnaImageDimension::Dim2DMsaaArray: return VK_IMAGE_VIEW_TYPE_2D_ARRAY;
+        case RdnaImageDimension::Dim3D: return VK_IMAGE_VIEW_TYPE_3D;
+        default: throw std::runtime_error("unknown image dimension");
+    }
+}
+
+VkFormat Format(const ImageResource& image) {
+    if (image.depthCompare) return VK_FORMAT_D16_UNORM;
+    if (image.atomic64) return VK_FORMAT_R64_UINT;
+    switch (image.numericClass) {
+        case IrTextureNumericClass::Float: return VK_FORMAT_R8G8B8A8_UNORM;
+        case IrTextureNumericClass::Uint: return VK_FORMAT_R32_UINT;
+        case IrTextureNumericClass::Sint: return VK_FORMAT_R32_SINT;
+        default: throw std::runtime_error("unknown numeric class");
+    }
+}
+
+void CheckEveryHeap() {
+    constexpr std::array dimensions{RdnaImageDimension::Dim1D, RdnaImageDimension::Dim1DArray, RdnaImageDimension::Dim2D, RdnaImageDimension::Dim2DArray,
+                                    RdnaImageDimension::Dim2DMsaa, RdnaImageDimension::Dim2DMsaaArray, RdnaImageDimension::Dim3D};
+    std::set<std::uint32_t> heaps;
+    for (const auto resourceClass : {ImageResourceClass::Sampled, ImageResourceClass::Storage}) {
+        for (const auto numericClass : {IrTextureNumericClass::Float, IrTextureNumericClass::Uint, IrTextureNumericClass::Sint}) {
+            for (const bool depthCompare : {false, true}) {
+                for (const bool atomic : {false, true}) {
+                    for (const bool atomic64 : {false, true}) {
+                        if ((depthCompare && resourceClass == ImageResourceClass::Storage) || (atomic64 && !atomic)) continue;
+                        for (const auto dimension : dimensions) {
+                            for (const std::uint32_t nativeSamples : {0u, 2u, 4u}) {
+                            if (nativeSamples != 0u && dimension != RdnaImageDimension::Dim2DMsaa && dimension != RdnaImageDimension::Dim2DMsaaArray) continue;
+                            ImageResource image;
+                            image.resourceClass = resourceClass;
+                            image.numericClass = numericClass;
+                            image.dimension = dimension;
+                            image.depthCompare = depthCompare;
+                            image.atomic = atomic;
+                            image.atomic64 = atomic64;
+                            image.nativeSamples = nativeSamples;
+                            std::uint32_t heap = 0;
+                            try {
+                                heap = static_cast<std::uint32_t>(DescriptorBindingForImage(image));
+                            } catch (const std::exception&) {
+                                continue;
+                            }
+                            const auto shape = AgcDriver::Graphics::PlaceholderImageShapeOf(heap);
+                            const auto where = " for heap " + std::to_string(heap);
+                            const bool storage = resourceClass == ImageResourceClass::Storage;
+                            const bool multisampled = dimension == RdnaImageDimension::Dim2DMsaa || dimension == RdnaImageDimension::Dim2DMsaaArray;
+                            Require(((shape.usage & VK_IMAGE_USAGE_STORAGE_BIT) != 0) == storage && ((shape.usage & VK_IMAGE_USAGE_SAMPLED_BIT) != 0) == !storage, "placeholder usage disagrees with the resource class" + where);
+                            Require((shape.aspect == VK_IMAGE_ASPECT_DEPTH_BIT) == depthCompare, "placeholder aspect disagrees with depth comparison" + where);
+                            Require(shape.format == Format(image), "placeholder format disagrees with the numeric class" + where);
+                            Require(shape.viewType == ViewType(dimension, nativeSamples), "placeholder view type disagrees with the dimension" + where);
+                            Require((shape.samples != VK_SAMPLE_COUNT_1_BIT) == multisampled, "placeholder sample count disagrees with multisampling" + where);
+                            Require(((shape.features & VK_FORMAT_FEATURE_STORAGE_IMAGE_ATOMIC_BIT) != 0) == atomic, "placeholder format features disagree with atomics" + where);
+                            heaps.insert(heap);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+    Require(heaps.size() == RuntimeAbi::ImageBindingCount, "not every typed image heap is reachable from an image resource: " + std::to_string(heaps.size()));
+}
+
+VkFormatFeatureFlags queriedFeatures = ~VkFormatFeatureFlags{0};
+VkSampleCountFlags queriedSamples = VK_SAMPLE_COUNT_1_BIT | VK_SAMPLE_COUNT_4_BIT;
+VkResult queriedResult = VK_SUCCESS;
+VkImageFormatProperties queriedLimits{ {1u,1u,1u},1u,1u,queriedSamples,4096u };
+std::uint32_t queryCount = 0u;
+VKAPI_ATTR void VKAPI_CALL FormatProperties(VkPhysicalDevice, VkFormat, VkFormatProperties* properties) {
+    ++queryCount; *properties = {}; properties->optimalTilingFeatures = queriedFeatures;
+}
+VKAPI_ATTR VkResult VKAPI_CALL ImageFormatProperties(VkPhysicalDevice, VkFormat, VkImageType, VkImageTiling, VkImageUsageFlags, VkImageCreateFlags, VkImageFormatProperties* limits) {
+    ++queryCount; *limits = queriedLimits; limits->sampleCounts = queriedSamples; return queriedResult;
+}
+template<typename F> void Rejected(F action, const char* expected) {
+    try { action(); }
+    catch (const std::exception& error) { Require(std::string(error.what()).find(expected) != std::string::npos, "unexpected typed-placeholder rejection"); return; }
+    throw std::runtime_error("invalid typed-placeholder contract accepted");
+}
+void CheckExactDeviceSupport() {
+    using namespace AgcDriver::Graphics;
+    Context context{};
+    context.formatProperties = FormatProperties;
+    context.imageFormatProperties = ImageFormatProperties;
+    context.storageImageMultisample = true;
+    context.multisampleArrayImage = true;
+    context.imageInt64Atomics = true;
+    for (std::uint32_t heap = RuntimeAbi::FirstImageBinding; heap < RuntimeAbi::FirstImageBinding + RuntimeAbi::ImageBindingCount; ++heap) {
+        const auto shape = PlaceholderImageShapeOf(heap);
+        Require(PlaceholderImageSupported(context, shape), "fully supported typed heap rejected");
+        queriedFeatures &= ~VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+        Require(!PlaceholderImageSupported(context, shape), "missing transfer destination support accepted");
+        queriedFeatures = ~VkFormatFeatureFlags{0};
+        queriedResult = VK_ERROR_FORMAT_NOT_SUPPORTED;
+        Require(!PlaceholderImageSupported(context, shape), "unsupported exact format/usage accepted");
+        queriedResult = VK_SUCCESS;
+        queriedLimits.maxArrayLayers = 0u;
+        Require(!PlaceholderImageSupported(context, shape), "zero array limit accepted");
+        queriedLimits.maxArrayLayers = 1u;
+        if (shape.samples != VK_SAMPLE_COUNT_1_BIT) {
+            queriedSamples = VK_SAMPLE_COUNT_1_BIT;
+            Require(!PlaceholderImageSupported(context, shape), "unsupported actual sample count accepted");
+            queriedSamples = VK_SAMPLE_COUNT_1_BIT | VK_SAMPLE_COUNT_4_BIT;
+            if (shape.viewType == VK_IMAGE_VIEW_TYPE_2D_ARRAY) {
+                context.multisampleArrayImage = false; queryCount = 0u;
+                Require(!PlaceholderImageSupported(context, shape) && queryCount == 0u, "disabled portability MS array queried/accepted");
+                context.multisampleArrayImage = true;
+            }
+            if ((shape.usage & VK_IMAGE_USAGE_STORAGE_BIT) != 0u) {
+                context.storageImageMultisample = false; queryCount = 0u;
+                Require(!PlaceholderImageSupported(context, shape) && queryCount == 0u, "disabled storage MS feature queried/accepted");
+                context.storageImageMultisample = true;
+            }
+        }
+        if (shape.format == VK_FORMAT_R64_UINT) {
+            context.imageInt64Atomics = false; queryCount = 0u;
+            Require(!PlaceholderImageSupported(context, shape) && queryCount == 0u, "disabled 64-bit image atomics queried/accepted");
+            context.imageInt64Atomics = true;
+        }
+    }
+    Rejected([] { static_cast<void>(PlaceholderImageShapeOf(0u)); }, "typed image heap");
+    Rejected([] { static_cast<void>(PlaceholderImageShapeOf(static_cast<std::uint32_t>(RuntimeAbi::Binding::Samplers))); }, "typed image heap");
+}
+void CheckPoliciesRemainDistinct() {
+    using namespace AgcDriver::Graphics;
+    Require(ValidImageDescriptorPolicy(ImageDescriptorPolicy::TypedPlaceholders) && !ValidImageDescriptorPolicy(static_cast<ImageDescriptorPolicy>(3u)), "typed fallback policy validation missing");
+    Context valid{};
+    DescriptorBinding binding{};
+    binding.kind = DescriptorKind::SampledImage;
+    binding.role = DescriptorRole::GuestImages;
+    binding.count = 1u;
+    binding.guestDescriptor.resize(8u,0u);
+    Rejected([&] { ValidateGuestImageDescriptors(valid, binding, VK_SHADER_STAGE_FRAGMENT_BIT); }, "zero guest image descriptor");
+    VkDescriptorImageInfo zero{VK_NULL_HANDLE,VK_NULL_HANDLE,VK_IMAGE_LAYOUT_GENERAL};
+    VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+    write.descriptorType = VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE; write.descriptorCount = 1u; write.pImageInfo = &zero;
+    Rejected([&] { ValidateImageDescriptorWrites(valid, std::span(&write,1u)); }, "null Vulkan image view");
+    Context native{}; native.nullDescriptors = true; native.imageDescriptorPolicy = ImageDescriptorPolicy::NativeNull;
+    ValidateGuestImageDescriptors(native,binding,VK_SHADER_STAGE_FRAGMENT_BIT);
+    ValidateImageDescriptorWrites(native,std::span(&write,1u));
+    Context typed{}; typed.typedImagePlaceholders = true; typed.imageDescriptorPolicy = ImageDescriptorPolicy::TypedPlaceholders;
+    Rejected([&] { ValidateGuestImageDescriptors(typed,binding,VK_SHADER_STAGE_FRAGMENT_BIT); }, "actual device provider");
+    typed.nullDescriptors = true;
+    Rejected([&] { ValidateImageDescriptorPolicy(typed); }, "disagrees");
+}
+
+}
+
+int main() {
+    try {
+        CheckEveryHeap();
+        CheckExactDeviceSupport();
+        CheckPoliciesRemainDistinct();
+        std::cout << "placeholder image tests passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
