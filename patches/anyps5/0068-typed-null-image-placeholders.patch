+namespace {
+using namespace AgcDriver::Graphics;
+using ShaderRecompiler::RuntimeAbi::FirstImageBinding;
+using ShaderRecompiler::RuntimeAbi::ImageBindingCount;
+struct Probe {
+    std::uint64_t next = 1u;
+    std::map<VkImage,VkImageCreateInfo> images;
+    std::map<VkImageView,VkImage> views;
+    std::set<VkDeviceMemory> memories;
+    std::map<VkImage,VkImageLayout> layouts;
+    std::set<VkImage> cleared;
+    std::uint32_t submits = 0u, waits = 0u, creates = 0u, failCreate = 0u;
+}* probe = nullptr;
+template<typename T> T New() {
+    const auto value = probe->next++;
+    if constexpr (std::is_pointer_v<T>) return reinterpret_cast<T>(static_cast<std::uintptr_t>(value));
+    else return static_cast<T>(value);
+}
+VKAPI_ATTR void VKAPI_CALL Formats(VkPhysicalDevice,VkFormat,VkFormatProperties* out) { *out={};out->optimalTilingFeatures=~VkFormatFeatureFlags{0}; }
+VKAPI_ATTR VkResult VKAPI_CALL ImageFormats(VkPhysicalDevice,VkFormat,VkImageType,VkImageTiling,VkImageUsageFlags,VkImageCreateFlags,VkImageFormatProperties* out) { *out={{1u,1u,1u},1u,1u,VK_SAMPLE_COUNT_1_BIT|VK_SAMPLE_COUNT_4_BIT,4096u};return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL CreateImage(VkDevice,const VkImageCreateInfo* info,const VkAllocationCallbacks*,VkImage* out) {
+    if (++probe->creates==probe->failCreate) return VK_ERROR_OUT_OF_DEVICE_MEMORY;
+    Require(info->extent.width==1u&&info->extent.height==1u&&info->extent.depth==1u&&info->mipLevels==1u&&info->arrayLayers==1u,"placeholder extent/mips/layers invalid");
+    Require((info->usage&VK_IMAGE_USAGE_TRANSFER_DST_BIT)!=0u&&info->initialLayout==VK_IMAGE_LAYOUT_UNDEFINED,"placeholder clear contract missing");
+    *out=New<VkImage>();probe->images.emplace(*out,*info);probe->layouts[*out]=VK_IMAGE_LAYOUT_UNDEFINED;return VK_SUCCESS;
+}
+VKAPI_ATTR void VKAPI_CALL ImageRequirements(VkDevice,VkImage image,VkMemoryRequirements* out) { Require(probe->images.contains(image),"unknown image requirements");*out={4096u,256u,1u}; }
+VKAPI_ATTR VkResult VKAPI_CALL Allocate(VkDevice,const VkMemoryAllocateInfo* info,const VkAllocationCallbacks*,VkDeviceMemory* out) { Require(info->allocationSize==4096u&&info->memoryTypeIndex==0u,"wrong placeholder memory allocation");*out=New<VkDeviceMemory>();probe->memories.insert(*out);return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL Bind(VkDevice,VkImage image,VkDeviceMemory memory,VkDeviceSize offset) { Require(probe->images.contains(image)&&probe->memories.contains(memory)&&offset==0u,"unbound placeholder memory");return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL CreateView(VkDevice,const VkImageViewCreateInfo* info,const VkAllocationCallbacks*,VkImageView* out) {
+    const auto& image=probe->images.at(info->image);
+    Require(info->format==image.format&&info->subresourceRange.levelCount==1u&&info->subresourceRange.layerCount==1u,"view format/range mismatch");
+    Require((image.imageType==VK_IMAGE_TYPE_1D&&(info->viewType==VK_IMAGE_VIEW_TYPE_1D||info->viewType==VK_IMAGE_VIEW_TYPE_1D_ARRAY))||(image.imageType==VK_IMAGE_TYPE_2D&&(info->viewType==VK_IMAGE_VIEW_TYPE_2D||info->viewType==VK_IMAGE_VIEW_TYPE_2D_ARRAY))||(image.imageType==VK_IMAGE_TYPE_3D&&info->viewType==VK_IMAGE_VIEW_TYPE_3D),"view dimension mismatch");
+    *out=New<VkImageView>();probe->views.emplace(*out,info->image);return VK_SUCCESS;
+}
+VKAPI_ATTR void VKAPI_CALL DestroyView(VkDevice,VkImageView view,const VkAllocationCallbacks*) { Require(probe->views.erase(view)==1u,"duplicate view release"); }
+VKAPI_ATTR void VKAPI_CALL DestroyImage(VkDevice,VkImage image,const VkAllocationCallbacks*) { Require(std::none_of(probe->views.begin(),probe->views.end(),[&](const auto& row){return row.second==image;}),"image released before its view");Require(probe->images.erase(image)==1u,"duplicate image release"); }
+VKAPI_ATTR void VKAPI_CALL Free(VkDevice,VkDeviceMemory memory,const VkAllocationCallbacks*) { Require(probe->memories.erase(memory)==1u,"duplicate memory release"); }
+VKAPI_ATTR VkResult VKAPI_CALL Commands(VkDevice,const VkCommandBufferAllocateInfo*,VkCommandBuffer* out) { *out=New<VkCommandBuffer>();return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL Fence(VkDevice,const VkFenceCreateInfo*,const VkAllocationCallbacks*,VkFence* out) { *out=New<VkFence>();return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL Begin(VkCommandBuffer,const VkCommandBufferBeginInfo*) { return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL End(VkCommandBuffer) { return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL Submit(VkQueue,std::uint32_t,const VkSubmitInfo*,VkFence) { ++probe->submits;return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL Wait(VkDevice,std::uint32_t,const VkFence*,VkBool32,std::uint64_t) { ++probe->waits;return VK_SUCCESS; }
+VKAPI_ATTR VkResult VKAPI_CALL FenceStatus(VkDevice,VkFence) { return VK_SUCCESS; }
+VKAPI_ATTR void VKAPI_CALL FreeCommands(VkDevice,VkCommandPool,std::uint32_t,const VkCommandBuffer*) {}
+VKAPI_ATTR void VKAPI_CALL DestroyFence(VkDevice,VkFence,const VkAllocationCallbacks*) {}
+VKAPI_ATTR void VKAPI_CALL Barriers(VkCommandBuffer,VkPipelineStageFlags,VkPipelineStageFlags,VkDependencyFlags,std::uint32_t,const VkMemoryBarrier*,std::uint32_t,const VkBufferMemoryBarrier*,std::uint32_t count,const VkImageMemoryBarrier* barriers) {
+    for(std::uint32_t i=0;i<count;++i){const auto& b=barriers[i];Require(probe->layouts.at(b.image)==b.oldLayout,"placeholder barrier old layout mismatch");if(b.newLayout==VK_IMAGE_LAYOUT_GENERAL)Require(probe->cleared.contains(b.image)&&b.srcAccessMask==VK_ACCESS_TRANSFER_WRITE_BIT,"placeholder visible before clear");probe->layouts[b.image]=b.newLayout;}
+}
+VKAPI_ATTR void VKAPI_CALL ClearColor(VkCommandBuffer,VkImage image,VkImageLayout layout,const VkClearColorValue* value,std::uint32_t count,const VkImageSubresourceRange* ranges) {
+    Require(probe->layouts.at(image)==layout&&layout==VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL&&count==1u&&ranges->aspectMask==VK_IMAGE_ASPECT_COLOR_BIT,"illegal color placeholder clear");for(auto v:value->uint32)Require(v==0u,"nonzero placeholder clear");Require(probe->images.at(image).format!=VK_FORMAT_D16_UNORM,"depth image cleared as color");probe->cleared.insert(image);
+}
+VKAPI_ATTR void VKAPI_CALL ClearDepth(VkCommandBuffer,VkImage image,VkImageLayout layout,const VkClearDepthStencilValue* value,std::uint32_t count,const VkImageSubresourceRange* ranges) {
+    Require(probe->layouts.at(image)==layout&&layout==VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL&&count==1u&&ranges->aspectMask==VK_IMAGE_ASPECT_DEPTH_BIT&&value->depth==0.f&&value->stencil==0u&&probe->images.at(image).format==VK_FORMAT_D16_UNORM,"illegal depth placeholder clear");probe->cleared.insert(image);
+}
+VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL Proc(VkDevice,const char* name) {
+#define P(n,f) if(std::strcmp(name,n)==0)return reinterpret_cast<PFN_vkVoidFunction>(f)
+    P("vkCreateImage",CreateImage);P("vkGetImageMemoryRequirements",ImageRequirements);P("vkAllocateMemory",Allocate);P("vkBindImageMemory",Bind);P("vkCreateImageView",CreateView);P("vkDestroyImageView",DestroyView);P("vkDestroyImage",DestroyImage);P("vkFreeMemory",Free);P("vkAllocateCommandBuffers",Commands);P("vkCreateFence",Fence);P("vkBeginCommandBuffer",Begin);P("vkEndCommandBuffer",End);P("vkQueueSubmit",Submit);P("vkWaitForFences",Wait);P("vkGetFenceStatus",FenceStatus);P("vkFreeCommandBuffers",FreeCommands);P("vkDestroyFence",DestroyFence);P("vkCmdPipelineBarrier",Barriers);P("vkCmdClearColorImage",ClearColor);P("vkCmdClearDepthStencilImage",ClearDepth);
+#undef P
+    throw std::runtime_error(std::string("unexpected placeholder entry point: ")+name);
+}
+Context MakeContext() { Context c{};c.deviceProc=Proc;c.formatProperties=Formats;c.imageFormatProperties=ImageFormats;c.memory.memoryTypeCount=1u;c.memory.memoryTypes[0].propertyFlags=VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT;c.storageImageMultisample=true;c.multisampleArrayImage=true;c.imageInt64Atomics=true;return c; }
+}
+
+void RunPlaceholderImageRuntimeTests() {
+    std::unique_lock lock(AgcDriver::GuestMemory::GpuMutex());
+    Probe state;probe=&state;
+    auto context=MakeContext();
+    {
+        PlaceholderImages images(context);
+        Require(state.images.size()==ImageBindingCount&&state.cleared.size()==ImageBindingCount&&state.submits==1u&&state.waits==1u,"typed images not fully initialized and fence-completed");
+        context.placeholderImages=&images;context.typedImagePlaceholders=true;context.imageDescriptorPolicy=ShaderRecompiler::ImageDescriptorPolicy::TypedPlaceholders;
+        for(std::uint32_t heap=FirstImageBinding;heap<FirstImageBinding+ImageBindingCount;++heap){const auto view=images.View(heap);const auto image=state.views.at(view);Require(state.layouts.at(image)==VK_IMAGE_LAYOUT_GENERAL,"typed image layout was not published");VkDescriptorImageInfo info{VK_NULL_HANDLE,view,VK_IMAGE_LAYOUT_GENERAL};VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};write.descriptorType=heap<ShaderRecompiler::RuntimeAbi::FirstStorageImageBinding?VK_DESCRIPTOR_TYPE_SAMPLED_IMAGE:VK_DESCRIPTOR_TYPE_STORAGE_IMAGE;write.descriptorCount=1u;write.pImageInfo=&info;ValidateImageDescriptorWrites(context,std::span(&write,1u));info.imageView=VK_NULL_HANDLE;bool rejected=false;try{ValidateImageDescriptorWrites(context,std::span(&write,1u));}catch(const std::runtime_error&){rejected=true;}Require(rejected,"typed fallback allowed a bare zero Vulkan view");}
+    }
+    Require(state.images.empty()&&state.views.empty()&&state.memories.empty(),"placeholder release leaked device resources");
+    state=Probe{};state.failCreate=3u;context=MakeContext();bool failed=false;
+    try{PlaceholderImages images(context);}catch(const std::runtime_error&){failed=true;}
+    Require(failed&&state.images.empty()&&state.views.empty()&&state.memories.empty(),"partial placeholder construction leaked resources");
+    state=Probe{};context=MakeContext();context.multisampleArrayImage=false;
+    {
+        PlaceholderImages images(context);bool rejected=false;try{static_cast<void>(images.View(FirstImageBinding+5u));}catch(const std::runtime_error&){rejected=true;}Require(rejected,"unsupported portability MS array heap returned a view");
+    }
+    Require(state.images.empty()&&state.views.empty()&&state.memories.empty(),"unsupported heap teardown leaked resources");
+    probe=nullptr;
+}
diff --git a/core/libs/prx/libSceAgcDriver/tests/PlaceholderImages.cpp b/core/libs/prx/libSceAgcDriver/tests/PlaceholderImages.cpp
