 need(sha(regular(INSTALL_READER))==INSTALL_READER_SHA and sha(regular(INSTALL_REVIEW))==INSTALL_REVIEW_SHA,'Exact fresh60 typed reader/review')
 return module(INSTALL_READER,'pure_actual60_full_cpu_reader')
def tools():return module(HERE/'cpu_tools.py','exact_typed_cpu_compiler_providers')
def reference_declarations(adapter):
 # CPU tools are a distinct frozen provenance category, never signed declarations.
 declared=s.declarations(s.SIGNED_SHA)
 for name,h in tools().frozen_external().items():merge(declared,name,h)
 return declared
def verify_input_map(bound):
 adapter=declaration_adapter();declared=reference_declarations(adapter)
 absolute={str(adapter.input_path(name,h,declared)):h for name,h in bound.items()}
 need(len(absolute)==len(bound),'Unique exact provider spelling required')
 sealed_input_replay(absolute)
def signed58_contract(binding,concrete_inputs):
 need(sha(regular(s.SIGNED))==s.SIGNED_SHA and concrete_inputs.get(str(s.SIGNED))==s.SIGNED_SHA and binding['signedNative60ReceiptSha256']==s.SIGNED_SHA,'Actual60 signed source included in accepted install')
 signed=load(s.SIGNED);path=s.BUILD_DIR/'inputs.json'
 need(sha(regular(path))==s.PREPARED_SHA and concrete_inputs.get(str(path))==s.PREPARED_SHA,'Actual60 prepared declarations included')
 s.signed_shape(signed,load(path));need(binding['fexRuntimeSha256']==s.FEX_SHA,'Exact new60 FEX');return signed
def draft_paths():
 need(sha(regular(PENDING50/'draft-source-review.json'))==PENDING50_REVIEW_SHA,'Exact preserved pending Original50 review')
 return sorted({*[HERE/n for n in LOCAL_FILES],*[FULL_PREDECESSOR/n for n in ['probe.py','composition.py','launch_query.py','log_contracts.py','original50.py','test_full_route.py','HOLD.md']],PENDING50/'composition.py',PENDING50/'draft-source-review.json',INSTALL_READER,INSTALL_REVIEW,UPDATE/'support.py',UPDATE/'providers.py',UPDATE/'package.py',UPDATE/'source-relocations.json',DECLARATION_ADAPTER,DECLARATION_REVIEW,PACKAGE_READER,PACKAGE_REVIEW,tools().PACKAGE_RECEIPT,tools().DIAGNOSTIC_REVIEW,tools().CURRENT_TOOL},key=str)
def reviewed_paths():
 require_runtime();d=continuing_reader();return sorted({*draft_paths(),CONTINUING_PROBE,CONTINUING_COMPOSITION,CONTINUING_REVIEW,*d.reviewed_paths()},key=str)
def source_contract(path):
 require_runtime();need(path==SOURCE_FREEZE,'Exact actual full60 source freeze')
 f=load(path)
 need(f['status']==STATUS and f['cpuPackageSourceFreezeSha256']==FREEZE and f['installationReaderSha256']==INSTALL_READER_SHA and f['deviceActions'] is f['executionPlanCreated'] is f['packageCreated'] is False and set(f['files'])=={rel(p)for p in reviewed_paths()},'Exact full60 source scope differs')
 for name,h in f['files'].items():need(sha(regular(ROOT/name))==h,'Reviewed full60 source changed')
 need(f['actualInstallationPins']=={'bindingSha256':SEALED_INSTALL_SHA,'resultSha256':SEALED_RESULT_SHA,'inputCount':SEALED_INPUT_COUNT} and f['original50Pins']=={'compositionSha256':CONTINUING_COMPOSITION_SHA,'reviewSha256':CONTINUING_REVIEW_SHA,'bindingSha256':CONTINUING_BINDING_SHA,'receiptSha256':CONTINUING_RECEIPT_SHA},'Exact actual60 and Original50 source pins')
 s.tool.verify_current_python();return f
def collector_bindings(proposal_path,runtime_path,install_path,phase='cpu-avx2'):
 require_runtime();need(phase in SUPPORTED_PHASES,'Only full CPU phases after Original50')
 source_contract(proposal_path);need(runtime_path==SELECT and install_path==INSTALL,'Exact retained full package/install bindings')
 extra=continuing_inputs()
 for name,h in tools().frozen_external().items():merge(extra,name,h)
 install,absolute,view,payload=inspected_install(extra_inputs=extra)
 union=dict(absolute)
 for name,h in extra.items():merge(union,name,h)
 bound=collector_input_map(union);continuing_claim(install,bound,extra)
 paths=[proposal_path,*reviewed_paths(),INSTALL,SELECT]
 selection,pkg,physical=selected_package(phase)
 need(type(physical)is dict and physical,'Complete original63 physical providers required')
 for name,h in physical.items():merge(bound,name,h)
 paths += [ROOT/selection['packageReceipt']['path'],*[ROOT/pkg['package']/n for n in pkg['files']]]
 for path in paths:merge(bound,rel(regular(path)),sha(path))
 return install,bound,view,payload
def plan_lineage(plan):
 installation_lineage(plan);installation=load(INSTALL)
 need(plan['continuingPrerequisite']==continuing_claim(installation,plan['inputs']),'Same60 genuine Original50 prerequisite omitted or changed')
