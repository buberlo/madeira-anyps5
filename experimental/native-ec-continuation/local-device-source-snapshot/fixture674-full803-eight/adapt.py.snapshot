class Literals(ast.NodeTransformer):
 def visit_Constant(self,n):
  if type(n.value)is str:n.value={OLD_INSTALL_STATUS:NEW_INSTALL_STATUS,'58':'60'}.get(n.value,n.value.replace('native58','native60').replace('Native58','Native60').replace('accepted58','accepted60').replace('own58','own60'))
  return n
class PreparedUnion(ast.NodeTransformer):
 def __init__(self):self.count=0
 def visit_Call(self,n):
