#!/usr/bin/env python3
"""Borrow unchanged exact180 CPU and50 Continuing readers; no device/I/O writes."""
import hashlib, importlib.util, re
from pathlib import Path
HERE=Path(__file__).resolve().parent
OLD=HERE.parent/'qualified-runtime-observation-collector-proposal/log_contracts.py'
OLD_SHA='6fbaad84c13bd2e8cd005ec5b5756555a77185f64134d20c106dd68d836eec32'
CONTINUING=HERE.parent/'continuing-only-diagnostic-collector-proposal/log_contracts.py'
CONTINUING_SHA='53e36dae41f40dd9cd5a9ead19b68b245feb541f07728caf254148dfe43dd61c'
def imported(path,wanted,name):
 if hashlib.sha256(path.read_bytes()).hexdigest()!=wanted:raise ValueError('Exact borrowed CPU log reader changed')
 s=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(s);s.loader.exec_module(m);return m
def duplicate_keys(pairs):return imported(OLD,OLD_SHA,'native57_duplicate_reader').duplicate_keys(pairs)
def __getattr__(name):return getattr(imported(OLD,OLD_SHA,'native57_retained_log_constants'),name)
def validate(raw,phase,path):
 if phase=='continuing-only-diagnostic':
  r=imported(CONTINUING,CONTINUING_SHA,'native57_continuing_log').validate(raw,phase,path)
  if r.get('fixturePassed') is not True or r.get('outcome')!='passed_50_continuing_only':raise ValueError('All50 Continuing deliveries must pass before subsequent Native57 CPU phases')
  return r
 return imported(OLD,OLD_SHA,'native57_full_cpu_log').validate(raw,phase,path)
