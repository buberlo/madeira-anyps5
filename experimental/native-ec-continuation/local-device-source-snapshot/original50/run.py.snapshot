#!/usr/bin/env python3
"""Only execution entry point for the explicit Native60 Original50 route."""
import importlib.util, sys
from pathlib import Path
sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent

def module(name):
    spec = importlib.util.spec_from_file_location('native60_current_tool_' + name, HERE / (name + '.py'))
    loaded = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(loaded)
    return loaded

def main():
    return module('execution_tool').main_function(module('adapt'))()

if __name__ == '__main__':
    raise SystemExit(main())
