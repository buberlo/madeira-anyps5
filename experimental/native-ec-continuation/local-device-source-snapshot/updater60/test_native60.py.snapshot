import ast,copy,importlib.util,json,tempfile,unittest
from pathlib import Path
from unittest import mock
HERE=Path(__file__).resolve().parent
sp=importlib.util.spec_from_file_location('tested60',HERE/'install.py');i=importlib.util.module_from_spec(sp);sp.loader.exec_module(i);s=i.s;v=s.pv
class SourceView(unittest.TestCase):
 def setUp(self):
  self.temp=tempfile.TemporaryDirectory();self.root=Path(self.temp.name).resolve();self.logical=self.root/'upstreams/AnyPS5/core/example.cpp';self.old=self.root/'build/anyps5-full-main-update-20261012/old-applied-stack/core/example.cpp';self.old.parent.mkdir(parents=True);self.old.write_bytes(b'old source');self.row={'path':str(self.old),'sha256':v.sha(self.old),'bytes':10,'stableLocalStat':v.seven(self.old.stat())};self.rows={str(self.logical):self.row}
 def tearDown(self):self.temp.cleanup()
 def test_retained_bytes_not_live(self):
  self.logical.parent.mkdir(parents=True);self.logical.write_bytes(b'new source');q=v.View(self.rows,self.root);self.assertEqual(q.file(self.logical),self.old);self.assertEqual(q.physical_map({str(self.logical):self.row['sha256']}),{str(self.old):self.row['sha256']});self.assertEqual(self.logical.read_bytes(),b'new source')
 def test_wrong_historical_digest(self):
  q=v.View(self.rows,self.root)
  with self.assertRaises(ValueError):q.physical_map({str(self.logical):'0'*64})
 def test_changed_bytes(self):
  q=v.View(self.rows,self.root);self.old.write_bytes(b'bad source')
  with self.assertRaises(ValueError):q.file(self.logical)
 def test_saved_inode(self):
  self.row['stableLocalStat'][1]+=1
  with self.assertRaises(ValueError):v.View(self.rows,self.root)
 def test_symlink(self):
  self.old.unlink();self.old.symlink_to(self.logical)
  with self.assertRaises(ValueError):v.View(self.rows,self.root)
 def test_duplicate_identity(self):
  other=self.root/'upstreams/AnyPS5/core/other.cpp';rows={**self.rows,str(other):self.row}
  with self.assertRaises(ValueError):v.View(rows,self.root)
 def test_unknown_logical_prefix(self):
  with self.assertRaises(ValueError):v.View({str(self.root/'saves/file'):self.row},self.root)
class Native60(unittest.TestCase):
 def setUp(self):self.r=s.load(s.SIGNED);self.p=s.load(s.BUILD_DIR/'inputs.json')
 def test_actual_signed_shape(self):self.assertTrue(s.signed_shape(self.r,self.p))
 def test_old_build_refused(self):
  self.r['appBuild']='59'
