 def test_fake_cpu_claim_refused(self):
  self.r['cpuEightQualified']=True
  with self.assertRaises(ValueError):s.signed_shape(self.r,self.p)
 def test_wrong_frame_rebuild_refused(self):
  self.r['freshNativeFexObjectCount']=43
  with self.assertRaises(ValueError):s.signed_shape(self.r,self.p)
 def test_wrong_fex_refused(self):
  self.r['embeddedPEComponents']['xtajit64.dll']['sha256']='0'*64
  with self.assertRaises(ValueError):s.signed_shape(self.r,self.p)
 def test_wrong_rollback_refused(self):
  self.r['native59RollbackSigningReceiptSha256']='0'*64
  with self.assertRaises(ValueError):s.signed_shape(self.r,self.p)
 def test_unsigned_provider_gate_refused(self):
  self.r['deepStrictCodesignVerified']=False
