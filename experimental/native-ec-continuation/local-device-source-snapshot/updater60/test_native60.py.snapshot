 def test_actual_sampler_route(self):
  p,records,dirs,session,values=i.ref.failed_origin();self.assertEqual(len(records),63);self.assertEqual(p['nativeBuild'],'59');self.assertIn('/raw/unix',str(sorted(dirs)));self.assertIn(str(i.ref.FAILED/'execution/receipt.json'),values)
 def test_undeclared_appconfig_file_refused(self):
  lib={'kind':'file','bytes':1,'sha256':'0'*64};ref={'inventory':{'Documents/madeira-library.json':lib},'originalLibrarySha256':'0'*64,'acceptedNative59BindingSha256':s.INSTALL59_SHA,'approvedCpuRecords':{},'approvedCpuDirectories':['Documents/CPU/raw/unix/AppConfig'],'exactSessionLog':'Documents/logs/one','exactConfig':'x','observedBundlePath':'/private/var/containers/Bundle/Application/094BA806-38AD-48FF-A866-E42BCC6A8477/Madeira.app'}
  current={**ref['inventory'],'Documents/CPU/raw/unix/AppConfig/unseen.json':lib};policy=mock.Mock();policy.system_artifact_records.return_value={}
  with self.assertRaises(ValueError):i.ref.transition(ref,current,policy)
 def test_install_budgets_unchanged(self):self.assertEqual((i.MIN_FREE,i.LIVE_RESERVE,i.MAX_OUTPUT,i.INSTALL_SECONDS,i.FALLBACK_SECONDS,i.WRAPPER_SECONDS),(6<<30,2<<30,1152<<20,1800,900,2850))
 def test_preservation_function_bodies_only_literal_delta(self):
  old=i.borrowed().pbody.extracted();actual=ast.fix_missing_locations(i.Adapter().visit(copy.deepcopy(old)))
  import types
  namespace=dict(vars(i));exec(compile(actual,'expected-private-literal-adapter','exec'),namespace)
  def code(f):
   c=f if isinstance(f,types.CodeType)else f.__code__;return(c.co_code,c.co_names,tuple(code(x)if isinstance(x,types.CodeType)else x for x in c.co_consts))
  for n in actual.body:
   expected=namespace[n.name];got=getattr(i,n.name)
   if isinstance(n,ast.ClassDef):
    for name,m in vars(expected).items():
     if isinstance(m,types.FunctionType):self.assertEqual(code(m),code(getattr(got,name)))
   else:self.assertEqual(code(expected),code(got))
 def test_cli_pending_before_plan(self):
  with mock.patch('sys.argv',['install.py']),mock.patch.object(i,'freeze_plan',side_effect=AssertionError):self.assertEqual(i.main(),0)
