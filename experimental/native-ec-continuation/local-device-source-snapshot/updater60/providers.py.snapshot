"""Explicit logical→physical old source view; no digest aliases or global patches."""
import hashlib,importlib.util,json,os,stat,types
from pathlib import Path
HERE=Path(__file__).resolve().parent;ROOT=HERE.parents[3]
MAP_SHA='9062c826471bbaffbd9caa3d034aafb47774543cf7f96b30ed5b431a5c8a92e5'
BINDING_SHA='811cd15b15f726aa4d41d73985b2044de567ee1284d139725ae6416606810682'
def need(v,m):
 if not v:raise ValueError(m)
def sha(p):
 h=hashlib.sha256()
 with Path(p).open('rb')as f:
  for b in iter(lambda:f.read(1<<20),b''):h.update(b)
 return h.hexdigest()
def seven(s):return [s.st_dev,s.st_ino,s.st_mode,s.st_nlink,s.st_size,s.st_mtime_ns,s.st_ctime_ns]
def regular(p,root=ROOT):
 p=Path(p).absolute();need(p.is_relative_to(root)and p==p.resolve()and not any(x.is_symlink()for x in [p,*p.parents])and stat.S_ISREG(p.lstat().st_mode)and p.stat().st_nlink==1,'Exact canonical single-link project provider');return p
class View:
 def __init__(self,rows,root=ROOT):
  self.root=root;self.rows=rows;paths=set();identities=set()
  for logical,r in rows.items():
   need(Path(logical).is_relative_to(root/'upstreams/AnyPS5'),'Only exact AnyPS5 old logical source names')
   p=regular(r['path'],root);need(p.is_relative_to(root/'build/anyps5-full-main-update-20261012/old-applied-stack'),'Only preserved old stack source')
   need(p.relative_to(root/'build/anyps5-full-main-update-20261012/old-applied-stack')==Path(logical).relative_to(root/'upstreams/AnyPS5'),'Exact source relative route')
   identity=tuple(seven(p.stat())[:2]);need(str(p)not in paths and identity not in identities,'Unique retained physical path and inode');paths.add(str(p));identities.add(identity);self.verify(logical)
 def verify(self,logical):
  r=self.rows[logical];p=regular(r['path'],self.root);before=seven(p.lstat());need(before==r['stableLocalStat']and before[4]==r['bytes'],'Exact retained saved source identity')
  h=hashlib.sha256()
  with p.open('rb')as f:
   need(seven(os.fstat(f.fileno()))==before,'Retained opened identity')
   for b in iter(lambda:f.read(1<<20),b''):h.update(b)
   need(seven(os.fstat(f.fileno()))==before,'Retained source changed while reading')
  need(h.hexdigest()==r['sha256']and seven(p.lstat())==before,'Retained full bytes/final identity');return p
 def file(self,path):
  p=Path(path).absolute();return self.verify(str(p))if str(p)in self.rows else regular(p,self.root)
 def digest(self,path):
  key=str(Path(path).absolute());return sha(self.verify(key))if key in self.rows else sha(path)
 def physical_map(self,values):
  result={}
  for name,h in values.items():
   p=Path(name)if Path(name).is_absolute()else self.root/name;key=str(p)
   if key in self.rows:need(h==self.rows[key]['sha256'],'Historical logical digest must not change');p=self.verify(key)
   key=str(p);need(key not in result or result[key]==h,'Conflicting physical provider');result[key]=h
  return result
 def final(self):
  for name in self.rows:self.verify(name)
 def module(self,path,digest,name):
  """Exact-source private module instance with only explicit source-file resolution.

  Every original function body is retained. Only this instance's file/sha/module
  boundary uses the 673-entry view; imports and unrelated modules are untouched.
  """
  path=self.file(path);need(sha(path)==digest,'Exact held module body')
  spec=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m)
  old_regular=getattr(m,'regular',None);old_sha=getattr(m,'sha',None)
  if old_regular:
   m.regular=lambda p,*a,**kw: self.file(p)if str(Path(p).absolute())in self.rows else old_regular(p,*a,**kw)
  if old_sha:m.sha=lambda p:self.digest(p)if str(Path(p).absolute())in self.rows else old_sha(p)
  if hasattr(m,'module'):m.module=self.module
  return m
 def clone(self,function,**overrides):
  n=dict(function.__globals__);n.update(overrides);f=types.FunctionType(function.__code__,n,function.__name__,function.__defaults__,function.__closure__);f.__kwdefaults__=function.__kwdefaults__;return f

