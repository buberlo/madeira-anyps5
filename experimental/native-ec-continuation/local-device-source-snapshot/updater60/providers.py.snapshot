 p=regular(HERE/'source-relocations.json');need(sha(p)==MAP_SHA,'Exact673 relocation declaration');r=json.loads(p.read_text());need(r['schema']==1 and r['count']==len(r['rows'])==673 and r['acceptedNative59BindingSha256']==BINDING_SHA and r['status']=='exact_retained_native59_logical_source_bytes_not_current_a11c_qualification'and r['canonicalSourcesChanged']is r['historicalExpectedHashesRewritten']is r['newHleQualified']is False,'Immutable old source scope');return View(r['rows'])
