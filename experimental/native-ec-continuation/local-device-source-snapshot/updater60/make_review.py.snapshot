 for name in ['providers.py','support.py','reference.py','install.py','binding.py','package.py','test_native60.py','README.md','make_review.py','source-relocations.json','signature-observation.json','package-replay.json']:
  p=s.regular(HERE/name);values[str(p)]=s.sha(p)
 for logical,r in v.rows.items():values[str(v.file(logical))]=r['sha256']
 for p in [s.OLD59/'source-review-freeze.json',s.ROOT/'build/native-ec-continuation-native60-final-verifier-attempt2-proposal-20261012/source-review-freeze.json',s.ROOT/'build/minigolf-upstream-20261010/cpu-device-probe-prep/complete-retained-package-provider-proposal/source-review-freeze.json']:
  r=s.load(p);s.merge(values,{str(p):s.sha(p)});s.merge(values,v.physical_map({n:h for n,h in r.get('inputHashes',r.get('inputs',{})).items()if Path(n).is_relative_to(s.ROOT)}))
 replay=s.load(HERE/'package-replay.json');s.need(replay['helperSha256']==values[str(HERE/'package.py')]and len(replay['package']['files'])==63 and replay['package']['files']['raw/guest_raise_exception_tests.exe']=='34ec640f54c8581ae833e8ff6d5276b9dea456ad5ca699460221e47f87dddb20','Actual retained63/34ec local package replay')
 for p in [s.INSTALL59,s.ROOT/s.load(s.INSTALL59)['compositeInstallationResult'],s.SIGNED,s.SIGNED59]:s.merge(values,{str(p):s.sha(p)})
 ref=s.module(HERE/'reference.py',values[str(HERE/'reference.py')],'review_only_current59_diagnostic_reference');_,_,_,_,extra=ref.failed_origin()
 # Retain all actual evidence but not a new full historical input-map replay here.
