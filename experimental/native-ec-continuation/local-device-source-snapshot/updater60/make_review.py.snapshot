 s.merge(values,s.load(HERE/'signature-observation.json')['inputHashes'])
 stamps={n:s.pv.seven(s.regular(n).stat())for n in values};log=HERE/'offline-tests.log'
 argv=[s.tool.PYTHON,'-I','-B','-m','unittest','discover','-s',str(HERE),'-p','test_native60.py']
 with log.open('x')as f:run=subprocess.run(argv,stdout=f,stderr=subprocess.STDOUT,timeout=60)
 s.need(run.returncode==0,'Meaningful source/temp controls');s.replay(values);s.need({n:s.pv.seven(s.regular(n).stat())for n in values}==stamps,'Reviewed input identities changed');values[str(log)]=s.sha(log);stamps[str(log)]=s.pv.seven(log.stat());v.final()
 proof={'schema':1,'status':'source_only_native60_preserved59_update_reader_not_executed','caseCount':19,'inputHashes':values,'inputFingerprints':stamps,'currentToolInputs':{s.tool.PYTHON:s.tool.CURRENT},'oldLogicalSourceMapSha256':s.pv.MAP_SHA,'oldLogicalSourceCount':673,'actualRetainedPackageReplaySha256':s.sha(HERE/'package-replay.json'),'actualSignedNative60ReceiptSha256':s.SIGNED_SHA,'actualAcceptedNative59BindingSha256':s.INSTALL59_SHA,'deviceActions':False,'executionPlanCreated':False,'installed60':False,'cpuQualified':False,'historicalExpectedHashesRewritten':False}
 p=HERE/'source-review-freeze.json'
