def need(ok, message):
    if not ok:
        raise ValueError(message)

def sha(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for data in iter(lambda : stream.read(1048576), b''):
            h.update(data)
    return h.hexdigest()

def regular(path):
    p = Path(path).absolute()
    need(p == p.resolve() and p.is_relative_to(ROOT) and p.is_file() and (not any((x.is_symlink() for x in [p, *p.parents]))), 'Exact unlinked project provider required')
    return p

def load(path):
    return json.loads(regular(path).read_text())

def module(path, name):
    s = importlib.util.spec_from_file_location(name, path)
    m = importlib.util.module_from_spec(s)
    s.loader.exec_module(m)
    return m

def rel(path):
    return str(regular(path).relative_to(ROOT))

def ref(path):
    return {'path': rel(path), 'sha256': sha(path)}

def merge(result, name, digest):
    need(type(digest) is str and re.fullmatch('[0-9a-f]{64}', digest) and (name not in result or result.get(name) == digest), 'Concrete nonconflicting provider required')
    result[name] = digest

def declaration_adapter():
    need(re.fullmatch('[0-9a-f]{64}', DECLARATION_ADAPTER_SHA) is not None, 'Reviewed declared-provider adapter remains pending')
    need(sha(regular(DECLARATION_ADAPTER)) == DECLARATION_ADAPTER_SHA and sha(regular(DECLARATION_REVIEW)) == DECLARATION_REVIEW_SHA, 'Exact declared-provider adapter/review changed')
    return module(DECLARATION_ADAPTER, 'held_native60_declared_provider_adapter')

def collector_input_map(absolute):
    adapter = declaration_adapter()
    declared = reference_declarations(adapter)
    bound = {}
    for (name, h) in absolute.items():
        merge(bound, adapter.input_key(name, h, declared), h)
    return bound

def verify_input_map(bound):
    adapter = declaration_adapter()
    declared = reference_declarations(adapter)
    absolute = {str(adapter.input_path(name, h, declared)): h for (name, h) in bound.items()}
    need(len(absolute) == len(bound), 'Unique exact collector provider spelling required')
    before = adapter.fingerprints(absolute, declared)
    for (name, h) in absolute.items():
        need(sha(name) == h, 'Reviewed collector/source/producer identity changed')
    need(adapter.fingerprints(absolute, declared) == before, 'Collector provider identity changed during byte replay')

def current_metadata_source(view, name):
    need(type(name) is str and (not name.startswith('/')) and ('\\' not in name) and all((x not in ('', '.', '..') for x in name.split('/'))), 'Exact protected metadata path required')
    record = view['inventory'][name]
    provider = view['providers'][name]
    need(record['kind'] == 'file' and provider['bytes'] == record['bytes'] and (provider['sha256'] == record['sha256']), 'Current accepted provider record differs')
    p = regular(provider['path'])
    need(p.stat().st_size == record['bytes'] and sha(p) == record['sha256'], 'Current protected metadata bytes changed')
    return p

def seven_stat(st):
    return (st.st_dev, st.st_ino, st.st_mode, st.st_nlink, st.st_size, st.st_mtime_ns, st.st_ctime_ns)

def sealed_input_replay(absolute):
    """Fresh per-file bytes/FD identities, plus the held lexical declaration guards."""
    adapter = declaration_adapter()
    declared = reference_declarations(adapter)
    paths = {}
    need(type(absolute) is dict and absolute, 'Complete absolute sealed input map required')
    for (name, h) in absolute.items():
        need(type(name) is str and Path(name).is_absolute(), 'Exact absolute sealed input spelling required')
        key = adapter.input_key(name, h, declared)
        path = adapter.input_path(key, h, declared)
        need(str(path) == name and name not in paths, 'Sealed input spelling or alias changed')
        paths[name] = path
    before = adapter.fingerprints(absolute, declared)
    stamps = {name: (seven_stat(path.lstat()), seven_stat(path.stat())) for (name, path) in paths.items()}
    for (name, path) in paths.items():
        (lexical, leaf) = stamps[name]
        need(seven_stat(path.lstat()) == lexical and seven_stat(path.stat()) == leaf, 'Sealed provider changed before open')
        hashed = hashlib.sha256()
        with path.open('rb') as stream:
            need(seven_stat(os.fstat(stream.fileno())) == leaf and seven_stat(path.lstat()) == lexical, 'Sealed opened file identity differs')
            for data in iter(lambda : stream.read(1048576), b''):
                hashed.update(data)
            need(seven_stat(os.fstat(stream.fileno())) == leaf, 'Sealed open provider changed during replay')
        need(hashed.hexdigest() == absolute[name], 'Sealed provider full bytes differ')
        need(seven_stat(path.lstat()) == lexical and seven_stat(path.stat()) == leaf, 'Sealed provider changed after replay')
    need(adapter.fingerprints(absolute, declared) == before, 'Sealed lexical/provider closure changed during replay')
    need(all(((seven_stat(path.lstat()), seven_stat(path.stat())) == stamps[name] for (name, path) in paths.items())), 'Sealed final seven-field input identities differ')

def continuing_evidence(stage, evidence):
    need(type(evidence) is dict and 0 < len(evidence) <= 256, 'Bounded actual Continuing evidence map required')
    actual = {p.name for p in stage.iterdir() if p.is_file() and p.name != 'receipt.json'}
    need(set(evidence) == actual, 'Complete actual Continuing output inventory required')
    total = 0
    for (name, h) in evidence.items():
        need(type(name) is str and (name in ('before.owned-log', 'pre-cleanup.<LOCAL_LOG_LEAF>') or re.fullmatch('[0-9]{3}-(?:apps|processes|initial-close-exact-existing-own60-main|launch-own-single-use-cpu|close-exact-launched-main)\\.(?:json|log)', name) or re.fullmatch('[0-9]{3}-launch-own-single-use-cpu\\.command\\.json', name)), 'Unknown actual Continuing output name')
        item = regular(stage / name)
        size = item.stat().st_size
        total += size
        need(size <= 8 * 1024 ** 2 and total <= 64 * 1024 ** 2, 'Continuing output byte closure exceeds original CPU reader bounds')
        need(type(h) is str and re.fullmatch('[0-9a-f]{64}', h) and (sha(item) == h), 'Actual Continuing evidence changed')

def continuing_receipt(path, digest, installation):
    path = regular(path)
    need(path.name == 'receipt.json' and path.parent.name == 'execution' and (path.parent.parent.parent == HERE) and re.fullmatch('plan-[0-9a-f]{32}', path.parent.parent.name) and (sha(path) == digest), 'Exact actual Native60 Continuing receipt required')
    r = load(path)
    plan_path = path.parent.parent / 'plan.json'
    p = load(plan_path)
    verified = module(HERE / 'adapt.py', 'completed57_continuing_plan_reader').verify_plan(plan_path, sha(plan_path))
    need(verified == p and r['inputHashes'] == p['inputs'], 'Actual Continuing plan/source/package/provider closure differs')
    need(r['status'] == 'actual_initial_cpu_phase_passed_not_game_or_gpu_qualification' and r['nativeBuild'] == p['nativeBuild'] == '60' and (r['phase'] == p['phase'] == 'continuing-only-diagnostic') and (r['sourceSha256'] == sha(HERE / 'probe.py')) and (r['planSha256'] == sha(plan_path)), 'Native60 Continuing50 actual execution required')
    for key in ['success', 'totalBudgetSatisfied', 'guestZeroExitObservedBeforeAnyTermination', 'ownProcessesClosed', 'libraryRestored', 'protectedMetadataPreserved']:
        need(r[key] is True, 'Continuing prerequisite incomplete: ' + key)
    need(r['cleanupErrors'] == [] and r['failure'] is None and (type(r['seconds']) in (int, float)) and math.isfinite(r['seconds']) and (0 <= r['seconds'] <= 330) and (r['preCleanupLogReads'] == 1) and (r['duringFixtureLogReads'] == 0) and (r['deviceActions'] is True), 'Finite zero-error real Continuing run required')
    need(r['acceptedInstallationBindingSha256'] == p['acceptedInstallationBindingSha256'] == sha(INSTALL) and r['acceptedInstallationResultSha256'] == p['acceptedInstallationResultSha256'] == installation['compositeInstallationResultSha256'] and (r['signedNative60ReceiptSha256'] == installation['signedNative60ReceiptSha256']) and (r['fexRuntimeSha256'] == installation['fexRuntimeSha256']) and (r['cpuPackageSourceFreezeSha256'] == FREEZE) and (p['expectedBundlePath'] == installation['observedBundlePath']) and (p['continuingPrerequisite'] is None), 'Continuing must execute the same explicitly accepted Native60/JIT installation')
    need(p['packageFiles']['raw/guest_raise_exception_tests.exe'] == CONTINUING_EXE_SHA, 'Actual compiled Continuing50 fixture required')
    continuing_evidence(path.parent, r['evidence'])
    raw = regular(path.parent / 'pre-cleanup.<LOCAL_LOG_LEAF>')
    need(r['evidence'].get(raw.name) == sha(raw), 'Actual Continuing pre-cleanup log not in sealed evidence')
    reader = module(HERE / 'log_contracts.py', 'fresh57_continuing_prerequisite')
    review = reader.validate(raw.read_bytes(), 'continuing-only-diagnostic', p['windowsPath'])
    need(r['logReview'] == review and review['fixturePassed'] is True and (review['outcome'] == 'passed_50_continuing_only') and (type(r['logReadFinishedBeforeCleanupMonotonic']) in (int, float)) and math.isfinite(r['logReadFinishedBeforeCleanupMonotonic']) and ('ownedTerminationAttemptedMonotonic' not in r or r['logReadFinishedBeforeCleanupMonotonic'] < r['ownedTerminationAttemptedMonotonic']), 'All50 real continuing deliveries/owned zero exit must precede collector termination')
    return (r, p)

def continuing_claim():
    b = load(CONTINUING_BINDING)
    (install, unused, view, payload) = inspected_install()
    need(b['schema'] == 1 and b['status'] == 'actual_native60_continuing50_prerequisite_bound_not_full803_or_gpu' and (b['acceptedInstallationBindingSha256'] == sha(INSTALL)), 'Exact new58 Continuing prerequisite binding required')
    continuing_receipt(ROOT / b['receipt']['path'], b['receipt']['sha256'], install)
    return {'binding': ref(CONTINUING_BINDING), 'receipt': b['receipt'], 'acceptedInstallationBindingSha256': b['acceptedInstallationBindingSha256']}

def bind_continuing(path, digest):
    need(not CONTINUING_BINDING.exists(), 'Do not overwrite actual Continuing binding')
    (install, unused, view, payload) = inspected_install()
    continuing_receipt(path, digest, install)
    with CONTINUING_BINDING.open('x') as f:
        json.dump({'schema': 1, 'status': 'actual_native60_continuing50_prerequisite_bound_not_full803_or_gpu', 'receipt': ref(path), 'acceptedInstallationBindingSha256': sha(INSTALL), 'deviceActions': False, 'full803OrEightPhasesClaimed': False}, f, indent=2)
        f.write('\n')
    return CONTINUING_BINDING

def collector_bindings(proposal_path, runtime_path, install_path, phase='cpu-avx2'):
    need(phase == 'continuing-only-diagnostic', 'Only one Native60 Continuing50 phase is permitted')
    source_contract(proposal_path)
    need(runtime_path == SELECT and install_path == INSTALL, 'Exact retained package selection and new58 install binding required')
    (install, absolute, view, payload) = inspected_install()
    bound = collector_input_map(absolute)
    paths = [proposal_path, *reviewed_paths(), INSTALL, SELECT]
    (selection, pkg, physical) = selected_package(phase)
    need(type(physical) is dict and physical, 'Exact physical retained-package proof inputs required')
    for (name, h) in physical.items():
        need(not Path(name).is_absolute(), 'Package proof inputs must keep strict project-relative physical names')
        merge(bound, name, h)
    paths += [ROOT / selection['packageReceipt']['path'], *[ROOT / pkg['package'] / n for n in pkg['files']]]
    for p in paths:
        merge(bound, rel(regular(p)), sha(p))
    return (install, bound, view, payload)

