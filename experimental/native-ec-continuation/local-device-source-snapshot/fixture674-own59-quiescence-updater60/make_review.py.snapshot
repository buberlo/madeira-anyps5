"""Exclusive source/evidence proof only; no plan, device or accepted59 replay."""
import importlib.util,json,subprocess
from pathlib import Path
HERE=Path(__file__).resolve().parent
sp=importlib.util.spec_from_file_location('partial60_source_review',HERE/'reference.py');r=importlib.util.module_from_spec(sp);sp.loader.exec_module(r);s=r.s
def main():
 prior=HERE.parent/'initial-own59-quiescence-ordered-evidence-preserved-source-update-proposal/source-review-freeze.json'
 values=dict(s.load(prior)['inputHashes']);values[str(prior)]=s.sha(prior)
 chronology_review=s.ROOT/'build/native60-initial-close-independent-review-20261012/review-original-bf3ffef.json'
 s.need(s.sha(chronology_review)=='9acb90aa1b42d5820327d55762ac45614390d758770f6faecfc200f44e7423d9','Exact independent chronology finding retained')
 s.merge(values,{str(chronology_review):s.sha(chronology_review)})
 refused=HERE.parent/'exact-partial-read-observed59-preserved-source-update-proposal/install-2650ba9a63cf/result.json';f=s.load(refused)
 s.need(f['installationAttempted']is f['success']is False and f['observationError']=="ValueError: Initially running own app is not closed automatically by this proposal" and all(f[k]is True for k in ['nativeJoinConfirmed','monitorJoinConfirmed','observerJoinConfirmed']),'Historical initial-close refusal stays unaccepted')
 s.merge(values,{str(refused):s.sha(refused)})
 for n,h in f['outputEvidence'].items():s.need(s.sha(s.regular(refused.parent/n))==h,'Exact prior refusal output');s.merge(values,{str(refused.parent/n):h})
 _,_,note,evidence=r.observed_evidence()
 drift=s.ROOT/'build/native60-historical-source-drift-observation-20261012.json';s.merge(values,{str(drift):s.sha(drift)})
 fixture=r.s.source_view().file(s.ROOT/'upstreams/AnyPS5/core/libs/prx/libSceAgcDriver/tests/UnusedBarycentricProof.cpp');s.merge(values,{str(fixture):s.sha(fixture)})
 tools=dict(s.load(prior)['currentToolInputs'])
 for name,digest in evidence.items():
  if Path(name).is_relative_to(s.ROOT):s.merge(values,{name:digest})
  else:
   s.need(s.PRIMITIVES.get(name)==digest,'Only the two already-pinned reader/query primitives');s.merge(tools,{name:digest})
 for name in ['providers.py','support.py','reference.py','install.py','binding.py','package.py','test_native60.py','test_observed.py','test_partial.py','test_quiescence.py','test_fixture674.py','README.md','make_review.py','source-relocations.json','signature-observation.json','package-replay.json','observed-rows.json','partial-retention-observation.json']:
  p=s.regular(HERE/name);s.merge(values,{str(p):s.sha(p)})
 stamps={name:s.pv.seven(s.regular(name).stat())for name in values}
 tool_stamps={name:s.pv.seven(Path(name).stat())for name in tools}
 log=HERE/'offline-tests.log'
 with log.open('x')as f:q=subprocess.run([s.tool.PYTHON,'-I','-B','-m','unittest','discover','-s',str(HERE),'-p','test_*.py'],stdout=f,stderr=subprocess.STDOUT,timeout=60)
 s.need(q.returncode==0,'Meaningful retained/partial source and byte controls')
 s.replay(values);s.replay(tools)
 s.need({name:s.pv.seven(s.regular(name).stat())for name in values}==stamps and {name:s.pv.seven(Path(name).stat())for name in tools}==tool_stamps,'Full source/evidence identity closure')
 r.observed_evidence()
 values[str(log)]=s.sha(log);stamps[str(log)]=s.pv.seven(log.stat())
 proof={'schema':1,'status':'source_only_native60_initial_quiescence_partial_read_update_reader_not_executed','caseCount':54,'inputHashes':values,'inputFingerprints':stamps,'currentToolInputs':tools,'currentToolFingerprints':tool_stamps,'failedRetentionReceiptSha256':r.READ_RECEIPT_SHA,'partialRetentionObservationSha256':s.sha(r.PARTIAL_OBSERVATION),'partialByteCountVerified':note['fileBytesVerified'],'partialFirstInventoryRecordCount':6057,'retentionFinalClosedInventoryAccepted':False,'freshFullPreinstallInventoryRequired':True,'postInstallPolicyChanged':False,'historicalExpectedHashesRewritten':False,'deviceActions':False,'executionPlanCreated':False,'installed60':False,'cpuQualified':False}
 p=HERE/'source-review-freeze.json'
 with p.open('x')as f:json.dump(proof,f,indent=2);f.write('\n')
 print(json.dumps({'sourceReview':str(p),'sha256':s.sha(p),'caseCount':54,'inputCount':len(values),'bytes':sum(Path(n).stat().st_size for n in values),'failedReaderKeptFailed':True}))
if __name__=='__main__':main()
