"""Root-owned isolated build runner. Inert by default; no signing/device calls."""
from pathlib import Path
import argparse,importlib.util,json,os,re,shlex,shutil,signal,struct,subprocess,time
HERE=Path(__file__).resolve().parent
ROOT=HERE.parent.parent
FULL=ROOT/'build/fex-native-critical-suspend-full-link-20261011'
NATIVE=ROOT/'build/fex-native-critical-native-archives-proposal-20261011'
def module(path,name):
 s=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(s);s.loader.exec_module(m);return m
p=module(HERE/'prepare_production.py','ec_prepare')
u=module(FULL/'build.py','held_pe_utilities')
n=module(NATIVE/'build.py','held_native_utilities')
def need(v,m):
 if not v:raise ValueError(m)
def frame(path):
 data=Path(path).read_bytes();count=struct.unpack_from('<H',data,2)[0];optional=struct.unpack_from('<H',data,16)[0]
 for i in range(count):
  at=20+optional+40*i
  if data[at:at+8].rstrip(b'\0')==b'.fexfrm':
   size,raw=struct.unpack_from('<II',data,at+16);body=data[raw:raw+size]
   need(size in [32,56] and len(body)==size,'Exact frame probe section');return list(struct.unpack('<'+'Q'*(size//8),body))
 raise ValueError('Frame probe section absent')
def import_delta(old,new):
 a=dict(u.import_contract(old));b=dict(u.import_contract(new));need(set(a)==set(b) and len(a)==12,'Exact DLL set')
 for name,syms in a.items():
  if name.lower()!='ntdll.dll':need(b[name]==syms,'Unexpected import change '+name);continue
  extra=set(b[name])-set(syms);need(set(syms).issubset(b[name]) and len(extra)==1 and re.fullmatch(r'RtlIsEcCode \(\d+\)',next(iter(extra))),'Only exact RtlIsEcCode import added')
def bounded_command(name,argv,env,stage,totalroot,timeout=900,cap=64<<20):
 stage.mkdir(parents=True,exist_ok=True);stdout=stage/(name+'.stdout');stderr=stage/(name+'.stderr')
 rec={'argv':list(map(str,argv)),'cwd':str(ROOT),'timeoutSeconds':timeout,'liveStdoutStderrCap':cap};start=time.monotonic();child=None
 try:
  with stdout.open('wb') as o,stderr.open('wb') as e:
   child=subprocess.Popen(rec['argv'],cwd=ROOT,env=env,stdout=o,stderr=e,start_new_session=True);rec['pid']=child.pid
   while child.poll() is None:
    need(time.monotonic()-start<timeout,'Owned compiler deadline')
    need(stdout.stat().st_size+stderr.stat().st_size<=cap,'Live compiler output cap')
    need(sum(x.stat().st_size for x in totalroot.rglob('*') if x.is_file())<=3<<30,'Live3GiB build output bound')
    time.sleep(0.5)
   child.wait();rec['actualExitCode']=child.returncode
  need(stdout.stat().st_size+stderr.stat().st_size<=cap,'Final compiler output cap');need(child.returncode==0,'Failed actual compiler '+name)
 except BaseException as error:
  rec['error']=str(error)
  if child is not None and child.poll() is None:
   need(os.getpgid(child.pid)==child.pid,'Exact compiler child group');os.killpg(child.pid,signal.SIGKILL);child.wait(timeout=10)
  raise
 finally:
  rec['ownedChildReaped']=child is not None and child.poll() is not None;rec['elapsedSeconds']=time.monotonic()-start
  rec['stdoutSha256']=p.sha(stdout);rec['stderrSha256']=p.sha(stderr)
  (stage/(name+'-command.json')).write_text(json.dumps(rec,indent=2)+'\n')
 return stdout.read_text(errors='replace')
def execute(expected):
 recipe=json.loads((HERE/'production-rebuild-recipe.json').read_text());source=Path(recipe['sourceDestination']);out=source.parent;freeze=out/'production-source-freeze.json'
 need(len(expected)==64 and p.sha(freeze)==expected,'Exact production freeze')
 f=json.loads(freeze.read_text());need(f['status']=='prepared_fresh6973_overlay3_generated5_not_compiled' and f['recipeSha256']==p.sha(HERE/'production-rebuild-recipe.json'),'Prepared source/recipe')
 def replay():
  for name,h in f['inputHashes'].items():need(p.sha(name)==h and p.stamp(name)==f['inputFingerprints'][name],'Provider drift '+name)
  for rel,h in {**f['sourceFiles'],**f['generatedHeaders']}.items():need(p.sha(source/rel)==h,'Source/header drift '+rel)
  need(p.sha(freeze)==expected,'Final immutable freeze')
 replay();stage=out/'arm64ec';build=stage/'build';need(not stage.exists() and not (out/'native').exists(),'Fresh build destinations')
 stage.mkdir()
 tool=Path(json.loads((FULL/'source-freeze.json').read_text())['toolchainBin'])
 env={k:v for k,v in os.environ.items() if not k.startswith(('DYLD_','CCACHE_')) and k not in {'CC','CXX','CFLAGS','CXXFLAGS','CPPFLAGS','LDFLAGS','CPATH','LIBRARY_PATH','SDKROOT'}}
 env['PATH']=str(tool)+':/opt/homebrew/bin:/usr/bin:/bin'
 def command(name,argv):
  text=bounded_command(name,argv,env,stage,out)
  need(sum(x.stat().st_size for x in out.rglob('*') if x.is_file())<=3<<30,'Finite3GiB build output bound after joined stage')
  return text
 start=time.monotonic();q={'status':'failed','sourceFreezeSha256':expected,'sourceReviewSha256':f['sourceReviewSha256'],'canonicalChanged':False,'installed':False,'deviceActions':False,'runtimeAccepted':False,'retainedNativeVersionMetadata':True}
 try:
  reverse=out/'reverse-check'
  for rel in json.loads((HERE/'baseline-bindings.json').read_text())['candidateHashes']:
   dst=reverse/rel;dst.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(source/rel,dst)
  command('reverse-patch',['/usr/bin/patch','--batch','-R','-p1','-d',reverse,'-i',HERE/'candidate.patch'])
  for rel in json.loads((HERE/'baseline-bindings.json').read_text())['candidateHashes']:need(p.sha(reverse/rel)==p.sha(HERE/'original'/rel),'Patch reverse baseline')
  command('configure',recipe['configure']);command('full187',recipe['build'])
  objects={str(x.relative_to(build)):p.sha(x) for x in build.rglob('*.obj')};need(len(objects)==187,'Fresh187 objects')
  modulecpp=build/'Source/Windows/ARM64EC/CMakeFiles/arm64ecfex.dir/Module.cpp.obj';modules=modulecpp.with_name('Module.S.obj')
  need(p.sha(modules)==json.loads((FULL/'final-receipt.json').read_text())['actualCheckCallObjectSha256'],'Unchanged CheckCall object')
  ms=command('moduleS',[tool/'llvm-objdump','-dr',modules]);body=re.search(r'<CheckCall>:(.*?)(?=\n[0-9a-f]+ <|\Z)',ms,re.S)
  need(body and re.search(r'ldr\s+w17,',body.group(1)) and re.search(r'b\.hs\s',body.group(1)) and not re.search(r'b\.hi\s',body.group(1)),'CheckCall6021')
  mc=command('moduleCpp',[tool/'llvm-readobj','--symbols','--relocations',modulecpp])
  for name in ['RtlIsEcCode','fex_ios_native_critical_enter','fex_ios_native_critical_leave','NtQueryInformationThread']:need(name in mc,'Compiled reference '+name)
  oldcommand=next(x for x in json.loads((FULL/'arm64ec/build/compile_commands.json').read_text()) if x['file'].endswith('/ARM64EC/Module.cpp'))
  args=shlex.split(oldcommand['command']);prefix=[];i=0
  while i<len(args):
   if args[i] in ['-o','-c']:i+=2;continue
   prefix.append(args[i]);i+=1
  frames=[]
  for label,route,extra in [('old',FULL/'source',['-DORIGINAL_FRAME']),('new',source,[])]:
   flags=[a.replace(str(FULL/'source'),str(route)).replace(str(FULL/'arm64ec/build'),str(build)) for a in prefix]
   probe=stage/(label+'-frame.obj');command(label+'-frame',flags+extra+['-c',HERE/'frame-offsets-coff.cpp','-o',probe]);frames.append(frame(probe))
  need(len(frames[0])==4 and len(frames[1])==7 and frames[0]==frames[1][:4],'TargetCOFF unchanged size/old offsets')
  need(frames[1][4:]==[frames[1][3]+8,frames[1][3]+16,frames[1][3]+24] and frames[1][-1]<=32760,'TargetCOFF appended record/order/range')
  dll=build/'Bin/libarm64ecfex.dll';pe=command('new-pe',[tool/'llvm-readobj','--coff-imports','--coff-exports','--file-headers',dll]);old=command('old-pe',[tool/'llvm-readobj','--coff-imports','--coff-exports',FULL/'arm64ec/xtajit64.dll'])
  need(u.export_contract(pe)==u.export_contract(old) and len(u.export_contract(pe))==30,'Exact30 exports');import_delta(old,pe)
  native=out/'native';native.mkdir();deps={};fresh={}
  nativefreeze=json.loads((NATIVE/'source-freeze.json').read_text());group=nativefreeze['groups'][0]
  for i,row in enumerate(recipe['nativeCommands']):
   obj=Path(row['compile'][row['compile'].index('-o')+1]);obj.parent.mkdir(parents=True,exist_ok=True)
   pp=command('native'+str(i)+'-pp',row['preprocess']);need('fex_ios_native_critical_enter' not in pp and 'ios_fex_critical_request' not in pp,'Native Windows bridge inactive')
   command('native'+str(i)+'-compile',row['compile']);fresh[obj.name]=obj
   for name in n.dep_paths(str(obj)+'.d',ROOT):
    path=Path(name);classified=n.lexical(path)
    h={**f['sourceFiles'],**f['generatedHeaders']}.get(str(classified.relative_to(source))) if classified.is_relative_to(source) else f['inputHashes'].get(name)
    need(h is not None and p.sha(path)==h,'Actual native dependency '+name);deps[name]=h
  for row in recipe['retainedFexCoreMembers']:
   dst=Path(row['destination']);dst.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(row['provider'],dst);need(p.sha(dst)==row['sha256'],'Current retained member');fresh[dst.name]=dst
  ordered=[native/'objects'/f'{i}-{r["name"]}' for i,r in enumerate(group['objects'])];need(len(fresh)==59 and all(x in fresh.values() for x in ordered),'Ordered59 members')
  archive=native/'libFEXCore.a';command('native-ar',[group['ar'],'qc',archive,*ordered]);command('native-ranlib',[group['ranlib'],archive])
  need(n.members(archive)==[{'name':x.name,'sha256':p.sha(x)} for x in ordered],'Actual ordered member bytes')
  current=next(Path(x) for x in recipe['selectedCurrentArchives'] if Path(x).name=='libFEXCore.a')
  need(n.symbols(command('old-native-nm',[nativefreeze['nm'],'-g',current]))==n.symbols(command('new-native-nm',[nativefreeze['nm'],'-g',archive])),'Native global symbol contract')
  selected={name:h for name,h in recipe['selectedCurrentArchives'].items() if Path(name).name!='libFEXCore.a'};need(len(selected)==6,'Six current archive routes');selected[str(archive)]=p.sha(archive)
  replay();need(all(json.loads(x.read_text())['ownedChildReaped'] and json.loads(x.read_text())['actualExitCode']==0 for x in stage.glob('*-command.json')),'All joined commands')
  shutil.copy2(dll,stage/'xtajit64.dll')
  q.update(status='fresh_ec_native_link_snapshot_DLL_and_native_archives_built_not_runtime_qualified',artifact=str(stage/'xtajit64.dll'),newDLLSha256=p.sha(dll),sourceFiles=f['sourceFiles'],sourceRoute=str(source),freshArm64ecObjectCount=187,objects=objects,frameOffsetRecords=frames,frameSizeUnchanged=True,freshNativeObjectCount=50,freshNativeArchiveCount=1,reusedNativeArchiveCount=6,archives=selected,actualNativeDependencies=deps,exportsExact=True,importDeltaOnlyRtlIsEcCode=True,sourceVersion='EC-link-'+recipe['exactPatchSha256'][:12],appConsumersNeedRebuild=['FEXBridge'],nativeGeneratedHeaders=f['generatedHeaders'])
 except BaseException as error:q['error']=str(error);raise
 finally:
  q['elapsedSeconds']=time.monotonic()-start;q['inputHashes']=f['inputHashes'];q['outputHashes']={str(x):p.sha(x) for x in out.rglob('*') if x.is_file() and x!=out/'final-receipt.json'}
  (out/'final-receipt.json').write_text(json.dumps(q,indent=2)+'\n');print(q['status'])
if __name__=='__main__':
 a=argparse.ArgumentParser();m=a.add_mutually_exclusive_group();m.add_argument('--prepare',action='store_true');m.add_argument('--execute',action='store_true');a.add_argument('--expected-source-review-sha256');a.add_argument('--expected-freeze-sha256');args=a.parse_args()
 if args.prepare:print(p.prepare(args.expected_source_review_sha256 or ''))
 elif args.execute:execute(args.expected_freeze_sha256 or '')
 else:print('inert; no build or device action')
