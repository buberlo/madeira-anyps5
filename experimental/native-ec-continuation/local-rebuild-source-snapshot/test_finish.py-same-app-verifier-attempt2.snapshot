from pathlib import Path
import ast
import importlib.util
import subprocess
import sys
import tempfile
import unittest

HERE = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location('same_app_finish60', HERE/'finish60.py')
f = importlib.util.module_from_spec(spec); spec.loader.exec_module(f)
c = f.c
OBJECTS = c.DEFAULT_OUT/'DerivedData/Build/Intermediates.noindex/Madeira.build/Debug-iphoneos/Madeira.build/Objects-normal/arm64'

class Finish(unittest.TestCase):
    def test_actual_failed_swift_four_records(self):
        text = (OBJECTS/'Madeira-primary-emit-module.d').read_text()
        rows = f.dep_records(text)
        self.assertEqual(len(rows), 4)
        self.assertEqual({Path(targets[0]).suffix for targets, _ in rows},
                         {'.swiftmodule','.swiftdoc','.swiftsourceinfo','.h'})
        self.assertTrue(all(names for _, names in rows))
        self.assertEqual(f.dep_names(text), {Path(c.os.path.normpath(name)) for _, names in rows for name in names})
        self.assertTrue(all(name.is_absolute() for name in f.dep_names(text)))
        old = ast.parse((f.OLD/'finish60.py').read_text())
        node = next(n for n in old.body if isinstance(n, ast.FunctionDef) and n.name == 'dep_names')
        namespace = {'c':c, 'Path':Path, 'shlex':f.shlex}
        exec(compile(ast.Module(body=[node], type_ignores=[]), '<retained-parser>', 'exec'), namespace)
        with self.assertRaisesRegex(ValueError, 'Absolute compiler dependencies'):
            namespace['dep_names'](text)

    def test_actual_all_host_dependency_records_and_fexbridge(self):
        inputs = c.read(c.DEFAULT_OUT/'inputs.json')
        for path in OBJECTS.glob('*.d'):
            self.assertTrue(f.dep_records(path.read_text()), path.name)
        records = f.app_core_state_readback(c.DEFAULT_OUT, inputs)
        self.assertEqual(set(records), {'FEXBridge'})
        core = c.DEFAULT_OUT/'layout/Madeira/FEX/FEXCore/include/FEXCore/Core/CoreState.h'
        self.assertEqual(records['FEXBridge']['actualFexHeaders'][str(core)],
                         inputs['sourceFiles'][str(core.relative_to(c.DEFAULT_OUT/'layout'))])

    def test_actual_build_and_failed_verifier_history(self):
        self.assertEqual(c.sha(f.OLD/'source-review-freeze.json'), f.OLD_REVIEW)
        self.assertEqual(c.sha(c.DEFAULT_OUT/'finish-receipt.json'), f.FAILED_FINISH)
        self.assertEqual(c.sha(c.DEFAULT_OUT/'inputs.json'), f.ACTUAL_INPUT)
        self.assertEqual(c.read(c.DEFAULT_OUT/'xcodebuild-result.json')['exitCode'], 0)
        self.assertEqual(c.read(c.DEFAULT_OUT/'finish-receipt.json')['error'],
                         'ValueError: Absolute compiler dependencies')

    def test_continuations_and_escaped_space(self):
        text = '/target\\ path.o: /header\\ path.h \\\n /second.h\n/target2.o: /third.h\n'
        self.assertEqual(f.dep_names(text), {Path('/header path.h'),Path('/second.h'),Path('/third.h')})

    def test_later_relative_dependency_rejects(self):
        with self.assertRaisesRegex(ValueError, 'Absolute compiler dependencies'):
            f.dep_names('/a.o: /a.h\n/b.o: relative.h\n')

    def test_later_malformed_record_rejects(self):
        for line in ['no delimiter', 'relative.o: /b.h', ': /b.h', '/b.o: /unterminated"']:
            with self.assertRaises(ValueError): f.dep_names('/a.o: /a.h\n'+line+'\n')

    def test_empty_dependency_file_rejects(self):
        with self.assertRaises(ValueError): f.dep_names(' \n\n')

    def test_later_corestate_alternative_rejects(self):
        with tempfile.TemporaryDirectory() as directory:
            layout = Path(directory).resolve()/'layout'
            old = layout.parent/'old'
            core = layout/'Madeira/FEX/FEXCore/include/FEXCore/Core/CoreState.h'
            core.parent.mkdir(parents=True); core.write_bytes(b'header')
            relative = str(core.relative_to(layout)); files = {relative:c.sha(core)}
            prior = 'dependencies: '+str(old/relative)
            with self.assertRaisesRegex(ValueError, 'Exactly the new physical CoreState'):
                f.core_dependencies('/a.o: '+str(core)+'\n/b.o: /unknown/CoreState.h',
                                    prior, layout, old, files)

    def test_later_record_membership_and_bytes_remain_strict(self):
        with tempfile.TemporaryDirectory() as directory:
            layout = Path(directory).resolve()/'layout'; old = layout.parent/'old'
            core = layout/'Madeira/FEX/FEXCore/include/FEXCore/Core/CoreState.h'
            extra = core.parent/'extra.h'; core.parent.mkdir(parents=True)
            core.write_bytes(b'core'); extra.write_bytes(b'extra')
            files = {str(p.relative_to(layout)):c.sha(p) for p in (core,extra)}
            prior = 'dependencies: '+str(old/core.relative_to(layout))+' '+str(old/extra.relative_to(layout))
            now = '/a.o: '+str(core)+'\n/b.o: '+str(extra)
            self.assertEqual(len(f.core_dependencies(now,prior,layout,old,files)),2)
            with self.assertRaisesRegex(ValueError, 'membership'):
                f.core_dependencies('/a.o: '+str(core),prior,layout,old,files)
            extra.write_bytes(b'drift')
            with self.assertRaisesRegex(ValueError, 'byte provider'):
                f.core_dependencies(now,prior,layout,old,files)

    def test_retained_verifier_functions_ast_equal(self):
        def functions(path):
            return {n.name:ast.dump(n,include_attributes=False) for n in ast.parse(path.read_text()).body
                    if isinstance(n,ast.FunctionDef)}
        old = functions(f.OLD/'finish60.py'); new = functions(HERE/'finish60.py')
        self.assertEqual(set(new)-set(old), {'dep_records'})
        for name in old.keys()-{'dep_names','main'}: self.assertEqual(old[name],new[name],name)

    def test_all_new_command_and_pe_outputs_use_appendix(self):
        tree = ast.parse((HERE/'finish60.py').read_text())
        main = next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name == 'main')
        calls = [n for n in ast.walk(main) if isinstance(n,ast.Call) and isinstance(n.func,ast.Attribute)
                 and isinstance(n.func.value,ast.Name) and n.func.value.id == 'c']
        for call in calls:
            if call.func.attr in {'command','pe_component','put'}:
                self.assertIn('appendix', ast.unparse(call.args[0]))
            if call.func.attr == 'verify_inputs': self.assertEqual(ast.unparse(call.args[0]), 'out')
        self.assertNotIn('xcodebuild', [v.value for v in ast.walk(main)
                                      if isinstance(v,ast.Constant) and isinstance(v.value,str)])
        for call in calls:
            if call.func.attr == 'command' and len(call.args)>2 and isinstance(call.args[2],ast.List):
                argv = [v.value for v in call.args[2].elts if isinstance(v,ast.Constant)]
                self.assertNotIn('--sign',argv)

    def test_isolated_help_does_not_create_appendix(self):
        appendix = c.DEFAULT_OUT/'signature-verification-attempt2'
        before = appendix.exists()
        run = subprocess.run([sys.executable,'-I','-B',str(HERE/'finish60.py'),'--help'],
                             capture_output=True,timeout=10)
        self.assertEqual(run.returncode,0,run.stderr.decode())
        self.assertEqual(appendix.exists(),before)

if __name__ == '__main__': unittest.main()
