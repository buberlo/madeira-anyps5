+#ifdef FEX_IOS_HOST
+// Preserve the incoming EC link only in the native EnterEC snapshot. Generic
+// JIT/MM snapshots and FillSRA entries have no authoritative live native LR.
+static bool PreserveEnterECNativeLink(FEXCore::Core::InternalThreadState* Thread, const EXCEPTION_RECORD& Rec,
+                                      const ARM64_NT_CONTEXT& Context, ARM64_NT_CONTEXT& GuestContext) {
+  const auto& Frame = *Thread->CurrentFrame;
+  if (Rec.ExceptionCode != 0xe0425355u || Context.Pc != Frame.Pointers.DispatcherLoopTop ||
+      Frame.IosEnterECSuspendTarget == 0 || Frame.IosEnterECSuspendTarget != Frame.State.rip ||
+      Frame.IosEnterECSuspendSP != Context.X23 || Frame.IosEnterECSuspendLR != Context.Lr ||
+      GuestContext.Pc != Frame.State.rip || GuestContext.Sp != Frame.IosEnterECSuspendSP) {
+    return false;
+  }
+  // Pool aliases are checked by their exact PE identity, never by address band.
+  if (!RtlIsEcCode(static_cast<ULONG_PTR>(IosJitReverseTranslate(GuestContext.Pc)))) {
+    return false;
+  }
+  GuestContext.Lr = Frame.IosEnterECSuspendLR;
+  return true;
+}
+#endif
