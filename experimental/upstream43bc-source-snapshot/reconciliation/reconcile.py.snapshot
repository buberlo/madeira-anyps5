 assert conflicts,(p.name,r.stderr)
 assert set(conflicts)<=set(paths)
 r=run(SRC,'apply',*[f'--exclude={rel}' for rel in conflicts],str(orig));assert r.returncode==0,(p.name,r.stderr)
 unresolved=[];merged=case/'merged';resolved=case/'resolved';merged.mkdir();resolved.mkdir()
 for rel in conflicts:
  current=before/rel;base=refBefore/rel;local=REF/rel
