OUT=Path(__file__).resolve().parent;SRC=OUT/'source';REF=OUT/'reference-ca4-skeleton';STATE=OUT/'rebase-state.json';OLD='ca4ab0d5d66f3855991fa95eec6e7e15e34e24c6'
def run(repo,*args):return subprocess.run(['git','-C',str(repo),*args],capture_output=True,text=True)
def sha(p):return hashlib.sha256(p.read_bytes()).hexdigest()
def copy_existing(src,dst,paths):
 for rel in paths:
  p=src/rel
  if p.exists():q=dst/rel;q.parent.mkdir(parents=True,exist_ok=True);shutil.copy2(p,q)
