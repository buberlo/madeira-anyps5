 r=subprocess.run(['git','diff','--no-index','--binary','--',str((case/'before').relative_to(OUT)),str(after.relative_to(OUT))],cwd=OUT,capture_output=True,text=True);assert r.returncode in [0,1]
 assert r.returncode==1,'Entire patch already present needs explicit proof/dedup review'
 oldPrefix='a/'+str((case/'before').relative_to(OUT))+'/';newPrefix='b/'+str(after.relative_to(OUT))+'/'
 s=r.stdout.replace(oldPrefix,'a/').replace(newPrefix,'b/');patch.write_text(s)
 return sha(patch)
