  mode=subprocess.check_output(['git','-C',str(SRC),'ls-tree',OLD,'--',rel]).decode().split()[0]
  q.chmod(0o755 if mode=='100755' else 0o644)
 state={'completed':[],'pending':None};STATE.write_text(json.dumps(state,indent=2)+'\n')
else:state=json.loads(STATE.read_text())
patches=sorted((OUT/'patches').glob('*.patch'));assert len(patches)==20
if state['pending']:
