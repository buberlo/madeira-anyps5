 case=OUT/'rebase'/p.stem;case.mkdir(parents=True);before=case/'before';before.mkdir();refBefore=case/'reference-before';refBefore.mkdir();copy_existing(SRC,before,paths);copy_existing(REF,refBefore,paths)
 r=run(REF,'apply','--check',str(orig));assert r.returncode==0,(p.name,r.stderr)
 r=run(REF,'apply',str(orig));assert r.returncode==0,(p.name,r.stderr)
 r=run(SRC,'apply','--check',str(orig));(case/'original-check.json').write_text(json.dumps({'returncode':r.returncode,'stderr':r.stderr},indent=2)+'\n')
 if r.returncode==0:
  r=run(SRC,'apply',str(orig));assert r.returncode==0;state['completed'].append({'patch':p.name,'rebased':False,'patchSha256':sha(p)});STATE.write_text(json.dumps(state,indent=2)+'\n');print(p.name,'unchanged',flush=True);continue
