+// Diagnostic only: bounded raw output, with no CRT stream, allocation or unwind.
+// Preserve the normal failure and LastError; no native frame is admitted here.
+void NoteDecodeFrameMiss(Word pc, void* image, const char* reason,
+                         const IMAGE_NT_HEADERS64* nt = nullptr) noexcept {
+    const DWORD savedError = GetLastError();
+    char enabled[2] {};
+    if (GetEnvironmentVariableA("APS5_UNWIND_MISS_TRACE", enabled, sizeof(enabled)) != 1 || enabled[0] != '1') {
+        SetLastError(savedError);
+        return;
+    }
+    static std::atomic<unsigned> records {0};
+    unsigned record = records.load(std::memory_order_relaxed);
+    do {
+        if (record >= 8) {
+            SetLastError(savedError);
+            return;
+        }
+    } while (!records.compare_exchange_weak(record, record + 1, std::memory_order_relaxed));
+
+    char output[1024] {};
+    std::size_t used = 0;
+    const auto character = [&](char value) {
+        if (used < sizeof(output)) output[used++] = value;
+    };
+    const auto text = [&](const char* value) {
+        while (*value && used < sizeof(output)) character(*value++);
+    };
+    const auto hex = [&](Word value, unsigned digits) {
+        constexpr char alphabet[] = "0123456789abcdef";
+        for (unsigned n = digits; n; --n) character(alphabet[(value >> ((n - 1) * 4)) & 15]);
+    };
+    char module[384] {};
+    DWORD moduleSize = image ? GetModuleFileNameA(static_cast<HMODULE>(image), module, sizeof(module)) : 0;
+    if (moduleSize >= sizeof(module)) moduleSize = sizeof(module) - 1;
+    bool ehfram = false, ehmeta = false, pdata = false, xdata = false;
+    if (nt) {
+        const auto* base = static_cast<const Byte*>(image);
+        const auto* sections = IMAGE_FIRST_SECTION(nt);
+        const Word sectionOffset = reinterpret_cast<const Byte*>(sections) - base;
+        const unsigned count = nt->FileHeader.NumberOfSections;
+        if (count <= 96 && sectionOffset <= nt->OptionalHeader.SizeOfImage &&
+            count <= (nt->OptionalHeader.SizeOfImage - sectionOffset) / sizeof(*sections)) {
+            for (unsigned n = 0; n < count; ++n) {
+                ehfram |= std::memcmp(sections[n].Name, ".ehfram", 8) == 0;
+                ehmeta |= std::memcmp(sections[n].Name, ".ehmeta", 8) == 0;
+                pdata |= std::memcmp(sections[n].Name, ".pdata", 7) == 0;
+                xdata |= std::memcmp(sections[n].Name, ".xdata", 7) == 0;
+            }
+        }
+    }
+    DWORD64 nativeBase = 0;
+    const auto* native = RtlLookupFunctionEntry(pc, &nativeBase, nullptr);
+    unsigned nativeVersion = 0xff, nativeFlags = 0xff;
+    if (native && nt && nativeBase == reinterpret_cast<Word>(image) &&
+        native->UnwindData < nt->OptionalHeader.SizeOfImage) {
+        const Byte first = static_cast<const Byte*>(image)[native->UnwindData];
+        nativeVersion = first & 7;
+        nativeFlags = first >> 3;
+    }
+    text("[libc-unwind-miss] pc="); hex(pc, 16);
+    text(" image="); hex(reinterpret_cast<Word>(image), 16);
+    text(" module=\"");
+    for (DWORD n = 0; n < moduleSize; ++n) {
+        const unsigned char value = module[n];
+        character(value < 32 || value == 127 || value == '"' ? '?' : static_cast<char>(value));
+    }
+    text("\" reason="); text(reason);
+    text(" ehfram="); character(ehfram ? '1' : '0');
+    text(" ehmeta="); character(ehmeta ? '1' : '0');
+    text(" pdata="); character(pdata ? '1' : '0');
+    text(" xdata="); character(xdata ? '1' : '0');
+    text(" native_base="); hex(nativeBase, 16);
+    text(" native_begin="); hex(native ? native->BeginAddress : 0, 8);
+    text(" native_end="); hex(native ? native->EndAddress : 0, 8);
+    text(" native_unwind="); hex(native ? native->UnwindData : 0, 8);
+    text(" native_version="); hex(nativeVersion, 2);
+    text(" native_flags="); hex(nativeFlags, 2);
+    character('\n');
+    LibcException::RawLogOutput::StderrWriter write;
+    (void)write(output, used); // One best-effort raw write, at most eight records.
+    SetLastError(savedError);
+}
 #endif
 
