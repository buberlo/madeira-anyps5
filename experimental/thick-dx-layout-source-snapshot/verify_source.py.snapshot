raise RuntimeError("Snapshot-only module; use reviewed current tooling instead.")
#!/usr/bin/env python3
"""Fresh local source-only seventeen-patch candidate and exact roundtrip."""
from pathlib import Path
import hashlib, json, os, shutil, stat, subprocess

HERE = Path(__file__).resolve().parent
FULL = HERE.parent
ROOT = HERE.parents[2]
TARGET = '0a8b1d32b12a6d6a3acd462787750b482bf78884'
PREVIOUS = FULL / 'latest-0a8b-sixteen-patch-proposal'
DIAGNOSIS = FULL / 'graphics-thick-dx-dispatch-source-proposal'
RELATIVE = 'core/libs/prx/libSceAgcDriver/Graphics/src/TextureTiling.cpp'
FIXTURE = 'core/libs/prx/libSceAgcDriver/tests/TextureTiling.cpp'
PATCH17 = '0017-thick-display-xor-volume-layout.patch'
BEFORE = '04be404d77a9534eccbc455a4c75b78940b57089a4e0391fd8b9772e6d2248fa'
AFTER = 'f064acdd21e41d88171461b0382d3c85e4d84844565591601634c9f71b0d0a0b'
PINS = {
    PREVIOUS / 'source-candidate-review.json': '7e6d8baa48ddbd9470f01a04ea23b9b79358498f8ab3dcc4338a92e5bfe98c97',
    DIAGNOSIS / 'receipt.json': 'e28a4e7fcf240959bc8a505dee744918488ce2ac7ff76c709cc03c90ce50d5b0',
    DIAGNOSIS / 'source_diagnosis.py': '730fbac5b3be195b52833202d0a2a74555734194bd6b7e70541311efacf63e3b',
    DIAGNOSIS / 'thick-dx-dispatch.patch': '70f5ceecf36d5b73ef6086bcc12c046653f45b6a09b22fc0ecf9392ebe82f352',
    FULL / 'actual-full-hle-latest16/receipt.json': '25eb80b46c802e6e831f99d3b029a22e0016504b0aa00fa5cf0ee9f75e78e496',
    FULL / 'qualification-source-latest16-actual-preparation.json': '5ef9478c853f3cac633a135081f7256eb5ca2f8253ad87086fed2baf11a7add8',
    FULL / 'winlibs-build-v5/test-agc_driver_graphics_tests.log': 'f2c2278bab9a1cdf69bddf8ba10ea93a0d5875f0583b6dfb39e0eff5bd55148d',
}

def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()

def command(argv, cwd=None):
    result = subprocess.run(argv, cwd=cwd, capture_output=True, timeout=60)
    if result.returncode:
        raise ValueError((argv, result.returncode, result.stderr.decode(errors='replace')))
    return result.stdout

def tree(folder):
    rows = {}
    for current, directories, names in os.walk(folder, followlinks=False):
        directories[:] = [n for n in directories if n not in ('.git', '3rdparty')]
        linked = [n for n in directories if (Path(current) / n).is_symlink()]
        directories[:] = [n for n in directories if n not in linked]
        for name in names + linked:
            path = Path(current) / name
            relative = path.relative_to(folder).as_posix()
            st = path.lstat()
            if stat.S_ISLNK(st.st_mode):
                value, mode = os.readlink(path).encode(), '120000'
            elif stat.S_ISREG(st.st_mode):
                value = path.read_bytes()
                mode = '100755' if st.st_mode & 0o111 else '100644'
            else:
                raise ValueError('Unexpected source type: ' + relative)
            rows[relative] = {'sha256': hashlib.sha256(value).hexdigest(), 'mode': mode}
    return rows

def verify_inputs():
    for path, digest in PINS.items():
        assert sha(path) == digest, path
    diagnosis = json.loads((DIAGNOSIS / 'receipt.json').read_text())
    for path, digest in diagnosis['sourceInputs'].items():
        assert sha(path) == digest, path
    assert diagnosis['sourceAlgebraAddressCount'] == 202
    assert len(diagnosis['sourceAlgebraFixtureCases']) == 10
    assert diagnosis['fixtureUnchanged'] and not diagnosis['oracleExpectationsChanged']
    assert not diagnosis['guardsChanged'] and diagnosis['candidateSha256'] == AFTER
    return diagnosis

def exact_initialized_dependencies(review):
    actual = FULL / 'qualification-source-v5'
    rows = {}
    for line in review['thirdPartyGitlinks']:
        declaration, relative = line.split('\t')
        digest = declaration.split()[2]
        folder = actual / relative
        assert command(['git', '-C', str(folder), 'rev-parse', 'HEAD']).decode().strip() == digest
        assert not command(['git', '-C', str(folder), 'status', '--porcelain'])
        rows[relative] = {'commit': digest, 'clean': True, 'sourceReference': str(folder)}
    assert len(rows) == 11
    return rows

def main():
    diagnosis = verify_inputs()
    prior = json.loads((PREVIOUS / 'source-candidate-review.json').read_text())
    assert prior['upstreamCommit'] == TARGET and prior['patchCount'] == 16
    assert tree(PREVIOUS / 'source') == prior['sourceTree']
    assert prior['sourceTree'][RELATIVE] == {'sha256': BEFORE, 'mode': '100644'}
    candidate = dict(prior['sourceTree'])
    candidate[RELATIVE] = {'sha256': AFTER, 'mode': '100644'}
    assert len(candidate) == 2137
    assert candidate[FIXTURE]['sha256'] == diagnosis['sourceInputs'][str(FULL / 'qualification-source-v5' / FIXTURE)]
    assert sha(DIAGNOSIS / 'overlay' / RELATIVE) == AFTER
    replay = json.loads((HERE / 'receipt.json').read_text())
    assert sha(HERE / 'source_diagnosis.py') == PINS[DIAGNOSIS / 'source_diagnosis.py']
    for field in ('sourceInputs', 'sourceAlgebraFixtureCases', 'sourceAlgebraAddressCount',
                  'originalThinBytes', 'independentExpectedThickBytes', 'thickBlockExtent',
                  'fixtureUnchanged', 'oracleExpectationsChanged', 'guardsChanged'):
        assert replay[field] == diagnosis[field], field
    assert sha(HERE / 'overlay' / RELATIVE) == AFTER
    assert sha(HERE / 'thick-dx-dispatch.patch') == PINS[DIAGNOSIS / 'thick-dx-dispatch.patch']
    dependencies = exact_initialized_dependencies(prior)
    actual_before = {name: sha(FULL / 'qualification-source-v5' / name) for name in prior['sourceTree']}
    assert actual_before == prior['sourceFiles']
    patches_dir = HERE / 'patches'
    patches_dir.mkdir()
    for name, digest in prior['patches'].items():
        assert sha(PREVIOUS / 'patches' / name) == digest
        assert sha(ROOT / 'patches/anyps5' / name) == digest
        shutil.copyfile(PREVIOUS / 'patches' / name, patches_dir / name)
    shutil.copyfile(DIAGNOSIS / 'thick-dx-dispatch.patch', patches_dir / PATCH17)
    patches = sorted(patches_dir.glob('*.patch'))
    assert len(patches) == 17
    hashes = {p.name: sha(p) for p in patches}
    source = HERE / 'source'
    scratch = HERE / 'fresh-roundtrip-source'
    assert not source.exists() and not scratch.exists()
    candidate_commands = []
    command(['git', 'clone', '--shared', '--no-checkout', str(PREVIOUS / 'source'), str(source)])
    command(['git', '-C', str(source), 'checkout', '--detach', TARGET])
    upstream = tree(source)
    assert len(upstream) == 2055
    for patch in patches:
        for check in (True, False):
            command(['git', 'apply'] + (['--check'] if check else []) + [str(patch)], cwd=source)
            candidate_commands.append({'patch': patch.name, 'check': check, 'exitCode': 0})
    assert tree(source) == candidate
    command(['git', 'clone', '--shared', '--no-checkout', str(source), str(scratch)])
    command(['git', '-C', str(scratch), 'checkout', '--detach', TARGET])
    assert tree(scratch) == upstream
    commands = []
    for reverse, ordered in ((False, patches), (True, list(reversed(patches)))):
        for patch in ordered:
            for check in (True, False):
                command(['git', 'apply'] + (['--reverse'] if reverse else []) + (['--check'] if check else []) + [str(patch)], cwd=scratch)
                commands.append({'patch': patch.name, 'reverse': reverse, 'check': check, 'exitCode': 0})
        assert tree(scratch) == (upstream if reverse else candidate)
    assert not command(['git', '-C', str(scratch), 'status', '--porcelain'])
    gitlinks = [line for line in command(['git', '-C', str(source), 'ls-tree', '-r', TARGET]).decode().splitlines() if line.startswith('160000 ')]
    assert gitlinks == prior['thirdPartyGitlinks']
    assert tree(source) == candidate and tree(PREVIOUS / 'source') == prior['sourceTree']
    assert {name: sha(FULL / 'qualification-source-v5' / name) for name in prior['sourceTree']} == actual_before
    assert exact_initialized_dependencies(prior) == dependencies
    verify_inputs()
    record = {
        'schema': 1, 'status': 'HELD_latest_0a8b_seventeen_patch_source_applied_and_reversed_not_runtime_qualified',
        'upstreamCommit': TARGET, 'source': str(source), 'patchCount': 17, 'patches': hashes,
        'previousSixteenReviewSha256': PINS[PREVIOUS / 'source-candidate-review.json'],
        'thickDxSourceDiagnosisSha256': PINS[DIAGNOSIS / 'receipt.json'],
        'thickDxOracleReplaySha256': sha(HERE / 'receipt.json'),
        'thickDxOracleRecipeSha256': sha(HERE / 'source_diagnosis.py'),
        'recipeSha256': sha(HERE / 'verify_source.py'), 'sourceEntryCount': len(candidate),
        'upstreamSourceEntryCount': len(upstream), 'sourceTree': candidate,
        'sourceFiles': {name: row['sha256'] for name, row in candidate.items()},
        'changedFromSixteen': [RELATIVE], 'fixtureSha256': candidate[FIXTURE]['sha256'],
        'allAppliedSourceEntriesMatched': True, 'reverseRestoresExactLatestUpstream': True,
        'candidateApplicationCommandCount': len(candidate_commands), 'candidateApplicationCommands': candidate_commands,
        'roundtripCommandCount': len(commands), 'roundtripCommands': commands,
        'thirdPartyGitlinks': gitlinks, 'thirdPartyGitlinksUnchanged': True,
        'dependencyContract': dependencies, 'initializedDependencyReferenceSource': str(FULL / 'qualification-source-v5'),
        'referenceDependencyIdentitiesAndCleanStateVerified': True, 'thirdPartyCheckoutPrepared': False,
        'historicalSixteenActualReceiptSha256': PINS[FULL / 'actual-full-hle-latest16/receipt.json'],
        'historicalSixteenActualPreparationSha256': PINS[FULL / 'qualification-source-latest16-actual-preparation.json'],
        'historicalSixteenGraphicsFailureLogSha256': PINS[FULL / 'winlibs-build-v5/test-agc_driver_graphics_tests.log'],
        'historicalSixteenFailurePreserved': True, 'sourceAlgebraCaseCount': 10, 'sourceAlgebraAddressCount': 202,
        'sourceAlgebraIsNotCppExecution': True, 'oracleExpectationsChanged': False, 'guardsChanged': False,
        'publicPatchPromotionPending': True, 'canonicalAndBuildSourcesEdited': False,
        'compilerWineDeviceActions': False, 'fullHleQualified': False, 'runtimeQualified': False,
        'gpuQualified': False, 'gameplayVerified': False,
    }
    path = HERE / 'source-candidate-review.json'
    with path.open('x') as output:
        json.dump(record, output, indent=2, sort_keys=True); output.write('\n')
    print(json.dumps({'reviewSha256': sha(path), 'candidateTextureTilingSha256': AFTER,
                      'patch17Sha256': hashes[PATCH17], 'sourceEntries': len(candidate),
                      'candidateCommandsPassed': len(candidate_commands), 'roundtripCommandsPassed': len(commands),
                      'dependencyGitlinksVerified': len(dependencies), 'sourceAlgebraAddressesUnchanged': 202}))

if __name__ == '__main__':
    main()
