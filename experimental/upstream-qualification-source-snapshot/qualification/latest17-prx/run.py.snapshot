# Archival source snapshot only. Never execute or import this module.
raise RuntimeError("Snapshot-only module; use reviewed current tooling instead.")

#!/usr/bin/env python3
"""Fresh loaded-PRX CPU qualification; prepare is filesystem-only.

Execution requires an exact reviewed source digest and an immutable prepared
plan. No GPU, game, device, network or remote execution is performed.
"""
