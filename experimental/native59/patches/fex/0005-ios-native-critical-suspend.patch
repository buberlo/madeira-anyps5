+
+#if defined(FEX_IOS_HOST) && defined(ARCHITECTURE_arm64ec)
+#include <FEXCore/Utils/NativeCriticalSectionABI.h>
+
+// BEGIN FEX_IOS_NATIVE_CRITICAL_BRIDGE
+// Internal, allocation-free, self-only bridge. Wine supplies authoritative
+// native TEB identity; neither CurrentFrame nor a raw x18 value is consulted.
+extern "C" int32_t fex_ios_native_critical_enter(ios_fex_critical_request* State) {
+  ios_fex_critical_request Request {IOS_FEX_CRITICAL_MAGIC, IOS_FEX_CRITICAL_VERSION,
+                                    IOS_FEX_CRITICAL_ENTER, 0, 0, 0, 0, 0};
+  ULONG Length = 0;
+  const auto Status = NtQueryInformationThread(NtCurrentThread(),
+    static_cast<THREADINFOCLASS>(IOS_FEX_CRITICAL_QUERY_CLASS), &Request, sizeof(Request), &Length);
+  if (Status != 0) {
+    return static_cast<int32_t>(Status);
+  }
+  if (Length != sizeof(Request) || Request.magic != IOS_FEX_CRITICAL_MAGIC ||
+      Request.version != IOS_FEX_CRITICAL_VERSION || Request.operation != IOS_FEX_CRITICAL_ENTER ||
+      Request.depth == 0 || Request.teb == 0 || Request.reserved != 0 ||
+      Request.flags > IOS_FEX_CRITICAL_INACTIVE ||
+      ((Request.flags == 0) ? (Request.token == 0) : (Request.token != 0))) {
+    return static_cast<int32_t>(0xc000000dU);
+  }
+  *State = Request;
+  return 0;
+}
+
+extern "C" int32_t fex_ios_native_critical_leave(ios_fex_critical_request* State) {
+  // Submit exactly the successful ENTER tuple with only operation changed.
+  const auto Previous = *State;
+  auto Request = Previous;
+  Request.operation = IOS_FEX_CRITICAL_LEAVE;
+  ULONG Length = 0;
+  const auto Status = NtQueryInformationThread(NtCurrentThread(),
+    static_cast<THREADINFOCLASS>(IOS_FEX_CRITICAL_QUERY_CLASS), &Request, sizeof(Request), &Length);
+  if (Status != 0) {
+    return static_cast<int32_t>(Status);
