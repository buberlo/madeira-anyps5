diff --git a/FEXCore/include/FEXCore/Utils/NativeCriticalSection.h b/FEXCore/include/FEXCore/Utils/NativeCriticalSection.h
new file mode 100644
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/NativeCriticalSection.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#if defined(_WIN32) && defined(FEX_IOS_HOST) && defined(ARCHITECTURE_arm64ec)
+#include <FEXCore/Utils/NativeCriticalSectionABI.h>
+
+// Internal FEX symbols, not BT-module exports. Native Wine owns masking,
+// bootstrap identity, depth, and the exact LIFO registration token.
+extern "C" int32_t fex_ios_native_critical_enter(ios_fex_critical_request* State);
+extern "C" int32_t fex_ios_native_critical_leave(ios_fex_critical_request* State);
+extern "C" [[noreturn]] void fex_ios_native_critical_fail(int32_t Status);
+
+namespace FEXCore {
+class NativeCriticalSection final {
+public:
+  NativeCriticalSection() {
+    if (const auto Status = fex_ios_native_critical_enter(&State); Status != 0) {
+      // Wine has already restored the incoming native mask on refused ENTER.
+      // Refusal must not turn into an unprotected lock acquisition.
+      fex_ios_native_critical_fail(Status);
+    }
+    Active = true;
+  }
+
+  NativeCriticalSection(const NativeCriticalSection&) = delete;
+  NativeCriticalSection& operator=(const NativeCriticalSection&) = delete;
+  NativeCriticalSection& operator=(NativeCriticalSection&&) = delete;
+  NativeCriticalSection(NativeCriticalSection&& Other) noexcept
+    : State(Other.State), Active(Other.Active) {
+    Other.Active = false;
+  }
+
+  ~NativeCriticalSection() noexcept {
+    if (Active) {
+      if (const auto Status = fex_ios_native_critical_leave(&State); Status != 0) {
+        // Failed LEAVE retains the native registration/mask. Never continue
+        // guest execution after losing truthful nesting or pending-stop state.
+        fex_ios_native_critical_fail(Status);
+      }
+    }
+  }
+
+private:
+  ios_fex_critical_request State {};
+  bool Active {false};
+};
+} // namespace FEXCore
+
+#define FEX_NATIVE_CRITICAL_JOIN_IMPL(A, B) A##B
+#define FEX_NATIVE_CRITICAL_JOIN(A, B) FEX_NATIVE_CRITICAL_JOIN_IMPL(A, B)
+#define FEX_NATIVE_CRITICAL_SCOPE() \
+  [[maybe_unused]] FEXCore::NativeCriticalSection FEX_NATIVE_CRITICAL_JOIN(FexNativeCritical_, __COUNTER__) {}
+#else
+// Underlying lock/lifecycle semantics are preserved on other targets. The
+// scope macro is a no-op and introduces no native query on those targets.
+#define FEX_NATIVE_CRITICAL_SCOPE() ((void)0)
+#endif
diff --git a/FEXCore/include/FEXCore/Utils/NativeCriticalSectionABI.h b/FEXCore/include/FEXCore/Utils/NativeCriticalSectionABI.h
new file mode 100644
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/NativeCriticalSectionABI.h
@@ -0,0 +1,35 @@
+/* Isolated source proposal. Private native Wine/FEX ABI, never a guest context. */
+#ifndef IOS_FEX_CRITICAL_ABI_H
+#define IOS_FEX_CRITICAL_ABI_H
+#include <stdint.h>
+
+#define IOS_FEX_CRITICAL_QUERY_CLASS 0x7fff4152u
+#define IOS_FEX_CRITICAL_MAGIC 0x41504353u
+#define IOS_FEX_CRITICAL_VERSION 1u
+#define IOS_FEX_CRITICAL_ENTER 1u
+#define IOS_FEX_CRITICAL_LEAVE 2u
+#define IOS_FEX_CRITICAL_INACTIVE 1u
+
+struct ios_fex_critical_request
+{
+    uint32_t magic;
+    uint32_t version;
+    uint32_t operation;
+    uint32_t depth;
+    uint64_t token;
+    uint64_t teb;
+    uint32_t flags;
+    uint32_t reserved;
+};
+
+/* ENTER: depth/token/teb/flags/reserved all zero. LEAVE: exact last ENTER
+ * tuple, changing only operation. Nested results retain the outer token.
+ * Successful outer LEAVE returns depth=0/token=0 and retains teb/flags.
+ * ReturnLength is exactly 40 on success; refused LEAVE changes no state.
+ * The native implementation owns the complete prior signal mask. */
+#if defined(__cplusplus)
+static_assert(sizeof(struct ios_fex_critical_request) == 40);
+#elif defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+_Static_assert(sizeof(struct ios_fex_critical_request) == 40, "private ABI40");
+#endif
+#endif
