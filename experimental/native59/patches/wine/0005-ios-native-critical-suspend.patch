+    facts.scope_matches_pending = thread->ios_fex_scope.pending_context == thread->context &&
+            thread->context && thread->ios_fex_scope.capture_generation == thread->context->ios_fex_generation;
+    facts.eligible_suspend_origin = thread->ios_fex_suspend_eligible && thread->context &&
