+static void ios_fex_publish_pending(struct thread *thread, struct context *ctx)
+{
+    ctx->ios_fex_generation = ++thread->ios_fex_capture_generation;
+    ctx->ios_fex_origin_process = current ? current->process->id : 0;
+    ctx->ios_fex_origin_thread = current ? current->id : 0;
+    thread->ios_fex_pending_context = ctx;
+    /* ENTER can precede context creation: bind this exact new object/generation now. */
+    ios_fex_critical_bind_pending(&thread->ios_fex_scope, ctx, ctx->ios_fex_generation);
+}
+
+/* Last logical resume cancels only a still-unacknowledged exact private capture.
+ * Existing waiter handles retain the old object and receive a real failure. The
+ * thread reference is removed before a delayed handler can create its own context. */
+static void ios_fex_cancel_pending(struct thread *thread)
+{
+    struct context *ctx = thread->context;
+    if (!ctx || ctx != thread->ios_fex_pending_context || ctx->status != STATUS_PENDING ||
