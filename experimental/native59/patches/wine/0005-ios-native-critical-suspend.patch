+
+static void ios_fex_ack_context(struct thread *thread, struct context *ctx, uint64_t cookie)
+{
+    ios_fex_clear_pending(thread); /* Actual target publication, never registration. */
+    ctx->status = STATUS_SUCCESS;
+    thread->suspend_cookie = cookie;
+    signal_sync(ctx->sync);
