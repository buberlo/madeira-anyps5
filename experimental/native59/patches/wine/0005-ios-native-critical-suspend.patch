+/* Self-only native critical registration: no caller-supplied thread/handle authority. */
+DECL_HANDLER(ios_fex_critical_scope)
+{
+#ifdef WINE_IOS
+    static uint64_t next_token;
+    struct ios_fex_critical_facts facts = ios_fex_thread_facts(current);
+    uint64_t result_token;
+    uint32_t result_depth, status;
+    if (get_req_data_size() || req->magic != IOS_FEX_CRITICAL_MAGIC ||
+        req->version != IOS_FEX_CRITICAL_VERSION || req->reserved)
+    {
+        set_error(STATUS_INVALID_PARAMETER);
+        return;
+    }
+    status = ios_fex_critical_register(&current->ios_fex_scope, &facts, current->teb,
+            req->teb, req->operation, req->token, &next_token, &result_token, &result_depth);
+    if (status) { set_error(status); return; }
+    if (req->operation == IOS_FEX_CRITICAL_ENTER && ios_fex_exact_private_pending(current))
+        ios_fex_critical_bind_pending(&current->ios_fex_scope, current->context,
+                                     current->context->ios_fex_generation);
+    reply->token = result_token;
+    reply->teb = current->teb;
+    reply->depth = result_depth;
+    /* An earlier hard gate may have dropped a due timer. Re-evaluate the real
+     * object/deadline, without inventing a signal, ACK or successful wait. */
+    if (req->operation == IOS_FEX_CRITICAL_ENTER) wake_thread(current);
+#else
+    set_error(STATUS_NOT_SUPPORTED);
+#endif
+}
