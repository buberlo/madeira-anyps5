+/* Exact, silent ownership sampler translation. Unlike the production
+ * permissive helper above, this never calls dprintf or chooses foreign state.
+ * Fixed-width volatile registry loads do not make a multi-thread snapshot;
+ * the bounded selector and count/row rereads only refuse observed changes. */
+#include "ios_critical_owner_mapping.h"
+_Static_assert(IOS_CO_MAX_MAPPINGS == IOS_JIT_MAX_MAPPINGS, "Exact diagnostic registry bound");
+static int ios_co_registry_read(void *opaque, unsigned index, struct ios_co_mapping_row *out)
+{
+    const volatile struct ios_jit_mapping *m;
+    (void)opaque;
+    if (index >= IOS_JIT_MAX_MAPPINGS) return 0;
+    m=&ios_jit_mappings[index];
+    out->pe=(uintptr_t)m->pe_base; out->pool=(uintptr_t)m->jit_base;
+    out->bytes=m->size; out->owner=(uintptr_t)m->owner_peb; out->unmapped=m->unmapped;
+    return 1;
+}
+void *ios_jit_diagnostic_translate_exact(void *addr, void *owner_peb)
+{
+    int count=*(volatile int *)&ios_jit_mapping_count;
+    uint64_t result=ios_co_mapping_pick(count,(uintptr_t)addr,(uintptr_t)owner_peb,0,ios_co_registry_read,NULL,NULL,NULL);
+    return count==*(volatile int *)&ios_jit_mapping_count ? (void *)(uintptr_t)result : NULL;
+}
+void *ios_jit_diagnostic_pool_owner(const void *addr, void **pe_base_out)
+{
+    int count=*(volatile int *)&ios_jit_mapping_count; uint64_t pe=0,owner=0;
+    uint64_t result=ios_co_mapping_pick(count,(uintptr_t)addr,0,1,ios_co_registry_read,NULL,&pe,&owner);
+    if (!result || count!=*(volatile int *)&ios_jit_mapping_count) {
+        if (pe_base_out) *pe_base_out=NULL;
+        return (void *)(uintptr_t)-1;
+    }
+    if (pe_base_out) *pe_base_out=(void *)(uintptr_t)pe;
+    return (void *)(uintptr_t)owner;
+}
