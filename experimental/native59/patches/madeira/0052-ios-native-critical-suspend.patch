+/* Native-only critical-suspend query. It must run before TRACE/CRT lookup. */
+static uint32_t ios_fex_critical_exchange(uint32_t operation, uint64_t teb, uint64_t token,
+                                      uint64_t *result_token, uint32_t *result_depth, uint64_t *result_teb)
+{
+    unsigned int status;
+    SERVER_START_REQ(ios_fex_critical_scope)
+    {
+        req->magic = IOS_FEX_CRITICAL_MAGIC;
+        req->version = IOS_FEX_CRITICAL_VERSION;
+        req->operation = operation;
+        req->reserved = 0;
+        req->teb = teb;
+        req->token = token;
+        if (!(status = wine_server_call(req)))
+        {
+            *result_token = reply->token;
+            *result_depth = reply->depth;
+            *result_teb = reply->teb;
+        }
+    }
+    SERVER_END_REQ;
+    return status;
+}
+
+static NTSTATUS ios_fex_critical_query(HANDLE handle, void *data, ULONG length, ULONG *ret_len)
+{
+    extern int ios_x64_signal_suspend_enabled, ios_x64_signal_suspend_mode_ready;
+    static const struct ios_fex_critical_native_ops ops =
+        { pthread_sigmask, ios_fex_critical_exchange };
+    TEB *teb;
+    struct ntdll_thread_data *thread_data;
+
+    if (ret_len) *ret_len = 0;
+    if (handle != NtCurrentThread()) return IOS_CRITICAL_ACCESS;
+    if (length != sizeof(struct ios_fex_critical_request)) return IOS_CRITICAL_LENGTH;
+    if (!data) return IOS_CRITICAL_PARAMETER;
+    /* This is native NtCurrentTeb's registered pthread key. A guest/FEX-provided
+     * raw x18 is never accepted as authority for registration or state storage. */
+    if (!(teb = NtCurrentTeb())) return IOS_CRITICAL_PARAMETER;
+    thread_data = (struct ntdll_thread_data *)&teb->GdiTebBatch;
+    return ios_fex_critical_native_query(&thread_data->ios_fex_critical, &ops,
+            (uint64_t)(uintptr_t)teb, __atomic_load_n(&ios_x64_signal_suspend_mode_ready, __ATOMIC_ACQUIRE) ?
+            !!ios_x64_signal_suspend_enabled : -1, 1, data, length, ret_len);
+}
